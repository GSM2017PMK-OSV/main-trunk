            </rdf:Alt>
         </dc:rights>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>military history</rdf:li>
               <rdf:li>warefare</rdf:li>
               <rdf:li>military</rdf:li>
               <rdf:li>history</rdf:li>
               <rdf:li>medieval history</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
