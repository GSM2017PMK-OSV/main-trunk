   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">The Cosmic Web (Artistâ€™s Impression)</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">In shaping the Universe, gravity builds a vast cobweb-like structure of filaments tying galaxies and clusters of galaxies together along invisible bridges hundreds of millions of light-years long. This is known as the cosmic web.</rdf:li>
    </rdf:Alt>
   </dc:description>
